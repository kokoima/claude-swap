  border:0;background:none;cursor:pointer;font-size:14px;font-weight:600}
.switch::before{content:"";flex:none;width:36px;height:21px;border-radius:999px;background:var(--track);
  border:1px solid var(--rule);transition:background .15s}
.switch::after{content:"";position:absolute;left:3px;top:50%;width:15px;height:15px;margin-top:-7.5px;
  border-radius:50%;background:var(--panel);box-shadow:0 1px 2px rgba(0,0,0,.3);transition:transform .15s}
.switch[aria-checked="true"]::before{background:var(--accent);border-color:var(--accent)}
.switch[aria-checked="true"]::after{transform:translateX(15px)}
.switch:disabled{opacity:.45;cursor:default}

/* bars: segmented like check's cells; the fill is the share used */
.bar{position:relative;display:block;height:9px;border-radius:2px;background:var(--track);overflow:hidden}
.bar>i{position:absolute;left:0;top:0;bottom:0;width:calc(var(--p,0) * 1%);background:var(--lvl,var(--ink3));
  transition:width .5s cubic-bezier(.2,.7,.2,1)}
.bar::after{content:"";position:absolute;inset:0;
  background:repeating-linear-gradient(90deg,transparent 0 calc(10% - 1.5px),var(--panel) calc(10% - 1.5px) 10%)}
.ok{--lvl:var(--ok-fill)} .warn{--lvl:var(--warn-fill)} .bad{--lvl:var(--bad-fill)}
.meter{display:grid;grid-template-columns:minmax(40px,1fr) 38px;align-items:center;gap:6px}
.meter .v{font:500 12px/1 var(--f-mono);text-align:right}
.meter .v.ok{color:var(--ok)} .meter .v.warn{color:var(--warn)} .meter .v.bad{color:var(--bad)}
.meter .v.none{color:var(--ink3)}

/* the plate: where a group's sessions are, like a platform number */
.plate{display:inline-flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;
  min-width:84px;padding:9px 14px 6px;border-radius:12px;background:var(--accent);color:var(--on-accent);
  box-shadow:0 2px 0 rgba(0,0,0,.12)}
