#!/usr/bin/env bash
#
# claude-swap — Rotate between multiple Claude Max accounts in Claude Code
#
# https://github.com/kokoima/claude-swap
#
# Usage:
#   claude-swap              Interactive: status + check + select
#   claude-swap <n>          Rotate to account N
#   claude-swap status       Show current account state
#   claude-swap check        Status + API rate limit check
#   claude-swap auto         Auto-rotate to best available account
#   claude-swap reset <n>    Spend account N's free limit reset
#   claude-swap add          Add a new account
#   claude-swap remove <n>   Remove an account
#   claude-swap init         First-time setup
#   claude-swap version      Show version

set -e

VERSION="1.8.0"
STORE="${CLAUDE_SWAP_STORE:-$HOME/.claude/claude-swap.json}"
CLAUDE_CREDS="$HOME/.claude/.credentials.json"
CLAUDE_JSON="$HOME/.claude.json"
WATCH_PID="$HOME/.claude/claude-swap-watch.pid"
WATCH_LOG="$HOME/.claude/claude-swap-watch.log"
WATCH_STATE="$HOME/.claude/claude-swap-watch.state"
IS_MACOS=false
[ "$(uname -s)" = "Darwin" ] && IS_MACOS=true

# --- Decision engine (general strategy) ---
# Which account to be on, shared by check, auto and watch: each Python block
# runs exec(os.environ["CLAUDE_SWAP_ENGINE"]). Pure — rows in, decision out,
# the clock passed in — so tests/test_engine.py can replay any situation.
read -r -d '' ENGINE_PY <<'PYEOF' || true
# A row: n, label, u5/u7 (% or None), r5/r7 (window resets, epoch or None),
# plan_end (cancellation or downgrade, epoch or None), free, disabled, error,
# rate_limited, resets (spendable count or None), resets_ends (when they
# lapse, epoch or None), reset_cooldown (epoch or None).
#
# Consume first the quota that is lost first. A week is lost at its renewal,
# or earlier if the plan stops, so that is each account's deadline. Within
# that: quota that dies within a day goes first (now or never), then accounts
# holding a free reset (reaching the limit early is what makes the reset
# worth a whole week), then the rest.

LEAVE = 98                  # leave an account once its 5h or 7d reaches this %
ROOM_5H = 80                # worth switching to: 5h at or below this...
ROOM_7D = 95                # ...and 7d at or below this
LAST_DAY = 24 * 3600        # quota expiring within this goes first
MIN_DWELL = 15 * 60         # no voluntary switch sooner than this after the last
RESET_MIN_LEFT = 24 * 3600  # a week renewing sooner than this refills for free
RESET_RETRY = 6 * 3600      # at most one reset per account in this span
ERROR_RETRY = 300           # probe failed on the active account: look again

INF = float("inf")


def deadline(r, now):
    """When the account's unused quota is lost: weekly renewal or plan end."""
    ends = [t for t in (r.get("r7"), r.get("plan_end")) if t and t > now]
    return min(ends) if ends else INF


def eligible(r):
    return (not (r.get("disabled") or r.get("free") or r.get("error"))
            and r.get("u5") is not None)


def blocked(r):
    return (bool(r.get("rate_limited")) or (r.get("u5") or 0) >= LEAVE
            or (r.get("u7") or 0) >= LEAVE)


def holds_reset(r, now):
    ends = r.get("resets_ends")
    return (r.get("resets") or 0) > 0 and (ends is None or ends > now)


def roomy(r, now):
    # A reset holder needs no 7d room: its reset refills it at the limit.
    return (r.get("u5") or 0) <= ROOM_5H and (
        (r.get("u7") or 0) <= ROOM_7D or holds_reset(r, now))


def load(r):
    return max(r.get("u5") or 0, r.get("u7") or 0)


def tier(r, now):
    if deadline(r, now) - now < LAST_DAY:
        return 0
    return 1 if holds_reset(r, now) else 2


def priority(r, now):
    return (tier(r, now), deadline(r, now))


def rank(rows, now):
    """Eligible accounts in consumption order, blocked ones included."""
    return sorted((r for r in rows if eligible(r)),
                  key=lambda r: (priority(r, now), load(r), r["n"]))


def unblock_at(r):
    """When a blocked account is usable again; None if unknown."""
    times = []
    if (r.get("u5") or 0) >= LEAVE:
        times.append(r.get("r5"))
    if (r.get("u7") or 0) >= LEAVE:
        times.append(r.get("r7"))
    if not times or None in times:
        return None
    return max(times)


def reset_due(r, now, state):
    """Aggressive policy: spend a free reset as soon as the week is spent."""
    if (r.get("u7") or 0) < LEAVE or not holds_reset(r, now):
        return False
    if (r.get("reset_cooldown") or 0) > now:
        return False
    if r["n"] in (state.get("reset_failed") or []):
        return False
    tried = (state.get("reset_tried") or {}).get(str(r["n"]))
    if tried and now - tried < RESET_RETRY:
        return False
    r7 = r.get("r7")
    if r7 and r7 - now < RESET_MIN_LEFT:
        # the week refills for free soon: spend only if the reset lapses first
        ends = r.get("resets_ends")
        return bool(ends and ends <= r7)
    return True


def next_event(rows, now):
    """Soonest instant at which a block lifts or the order can change."""
    times = []
    for r in rows:
        if not eligible(r):
            continue
        d = deadline(r, now)
        times += [r.get("r5"), r.get("r7"), r.get("plan_end"),
                  r.get("reset_cooldown"), d - LAST_DAY if d < INF else None]
    times = [t for t in times if t and t > now]
    return min(times) if times else None


def usage(r):
    if r.get("u5") is None:
        return "no data"
    return f"5h {r['u5']:.0f}% · 7d {(r.get('u7') or 0):.0f}%"


def decide(rows, active, now, state, auto_reset=False):
    """What to do now: stay, switch, spend a reset, or wait at the wall.

    state carries last_switch (epoch), manual (the active account was picked
    by hand), reset_tried ({"n": epoch}) and reset_failed ([n]). Returns
    {"action", "target", "reason", "wake"}; wake is the next instant worth
    looking again, or None.
    """
    def out(action, target, reason, wake=None):
        ev = next_event(rows, now)
        if wake is None or (ev is not None and ev < wake):
            wake = ev
        return {"action": action, "target": target, "reason": reason,
                "wake": wake}

    cur = next((r for r in rows if r["n"] == active), None)
    ranked = rank(rows, now)

    if auto_reset:
        for r in ranked:
            if reset_due(r, now, state):
                return out("reset", r["n"],
                           f"#{r['n']} spent its week ({usage(r)}) and holds a reset")

    if (cur is not None and cur.get("error")
            and not (cur.get("disabled") or cur.get("free"))):
        return out("stay", active, f"#{active} probe failed ({cur['error']})",
                   now + ERROR_RETRY)

    usable = [r for r in ranked if not blocked(r)]
    best = next((r for r in usable if roomy(r, now)), None)

    if cur is None or not eligible(cur) or blocked(cur):
        if cur is None:
            why = "no active account"
        elif not eligible(cur):
            why = f"#{active} is no longer usable"
        else:
            why = f"#{active} at its limit ({usage(cur)})"
        target = best or min(usable, key=lambda r: (load(r), priority(r, now)),
                             default=None)
        if target is None:
            waits = [t for t in (unblock_at(r) for r in ranked) if t and t > now]
            return out("wall", None, why + " and every account is at its limit",
                       min(waits) if waits else None)
        return out("switch", target["n"], why)

    if best and best["n"] != active and priority(best, now) < priority(cur, now):
        ahead = f"#{best['n']} goes first ({usage(best)})"
        if state.get("manual"):
            return out("stay", active, f"#{active} picked by hand; {ahead}")
        last = state.get("last_switch") or 0
        if now - last < MIN_DWELL:
            return out("stay", active, f"{ahead}, after the dwell time",
                       last + MIN_DWELL)
        return out("switch", best["n"], ahead)

    return out("stay", active, f"#{active} goes first")
PYEOF
export CLAUDE_SWAP_ENGINE="$ENGINE_PY"

# --- Checks ---

check_python() {
  command -v python3 >/dev/null 2>&1 || {
    echo "Error: python3 is required but not found."
    echo ""
    echo "Install it:"
    echo "  macOS:  Python 3 is pre-installed, or: brew install python3"
    echo "  Linux:  sudo apt install python3  (or your distro's equivalent)"
    exit 1
  }
}

check_store() {
  [ -f "$STORE" ] || {
    echo "No accounts configured yet."
    echo ""
    echo "Run 'claude-swap init' to get started."
    exit 1
  }
}

# --- Commands ---

