print()
if len(targets) > 1:
    print(f"{done} of {len(targets)} saved.")
show(oauth.load_store(store_path))
sys.exit(3 if done else 0)  # tells the shell to refresh the cookies
PYEOF
  local rc=0
  python3 -c "$auth_py" "$STORE" "$@" || rc=$?
