.bridge{display:flex;flex-wrap:wrap;gap:8px 4px;padding:12px 12px 8px}
.ch{display:grid;grid-template-rows:13px 52px 15px;justify-items:center;width:28px;padding:2px 0;border:0;
  border-radius:6px;background:none;cursor:pointer}
.ch:hover{background:var(--inset)}
