  return h("div", { class: "ctl" }, rows);
}

function orderNote(e) {
  const out = [];
  if (e.blocked) {
    if (e.unblock_at) out.push(["t-bad", "blocked until " + when(e.unblock_at)]);
    else if (e.cancel_at && e.cancel_at > nowS()) out.push(["t-bad", "blocked"], ["", "plan ends " + when(e.cancel_at)]);
    else out.push(["t-bad", "blocked"]);
  } else {
    out.push(["", e.deadline == null ? "no week running"
      : (e.deadline_kind === "plan ends" ? "plan ends " : "renews ") + when(e.deadline)]);
    if (e.last_day) out.push(["t-warn", "last day"]);
    else if (e.full_reset) out.push(["t-ok", "holds a full reset"]);
    if (e.model_reset) out.push(["t-ok", "holds " + (/^[aeiou]/i.test(e.model_reset) ? "an " : "a ") + e.model_reset + " reset"]);
    if (e.little_room) out.push(["faint", "little room"]);
