# by WEB_PY at GET / with a nonce on its <script> and <style> (__NONCE__). It
# reads /api/state every minute and sends whitelisted commands to
# /api/action; each one asks first, and a reset wants «si» typed. A
# function, so only `claude-swap web` pays for reading it.
_web_page() {
  cat <<'HTMLEOF'
<!doctype html>
<html lang="en">
<head>
