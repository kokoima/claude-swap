            console_stale.append(f"{i+1}{_console_where(acc)}")
    if no_console:
        print()
        print("No Console session (log platform.claude.com in on the account's Chrome profile"
              " and re-run, to see its API credits): #" + ", #".join(no_console))
    if console_stale:
