def is_free(tier):
    t = (tier or "").lower()
    return "free" in t or t in ("", "default_claude_ai")


def plan_name(tier):
    """check's short name for a rate_limit_tier."""
    if tier is None:
        return "?"
    t = tier.lower()
    if "max_20x" in t:
        return "MAX20X"
    if "team" in t or "raven" in t:  # raven: claude.ai's name for Team
        return "TEAM"
