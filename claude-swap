cmd_credits() {
  # API credits per account and Console organization (read-only)
  check_store
  python3 - "$STORE" "${1:-}" <<'PYEOF'
import json, os, re, sys, time, types
engine = types.ModuleType("engine")
exec(os.environ["CLAUDE_SWAP_ENGINE"], engine.__dict__)
oauth = types.ModuleType("oauth")
exec(os.environ["CLAUDE_SWAP_OAUTH"], oauth.__dict__)

store_path, only = sys.argv[1], sys.argv[2].strip()
store = oauth.load_store(store_path)
accounts = store.get("accounts", [])
if only and not (only.isdigit() and 1 <= int(only) <= len(accounts)):
    sys.exit(f"Error: account {only} does not exist (valid: 1-{len(accounts)})")
USE_COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
RED, YELLOW, GREEN, GREY, BOLD, CYAN = "31", "33", "32", "90", "1", "36"
_ANSI = re.compile(r"\x1b\[[0-9;]*m")
def paint(code, s):
    return f"\x1b[{code}m{s}\x1b[0m" if USE_COLOR else s
def pad(s, w, right=False):
    gap = w - len(_ANSI.sub("", s))
    if gap <= 0:
        return s
    return (" " * gap + s) if right else (s + " " * gap)
def trunc(s, w):
    return s if len(s) <= w else s[:w - 1] + "…"
def day(t):
    # with the year when far off: "01 Nov" a year ahead would read as past
    if not t:
        return ""
    far = abs(t - time.time()) > 180 * 86400
    return time.strftime("%d %b %Y" if far else "%d %b", time.localtime(t))
def money(v):
    return "-" if v is None else f"{v:,.2f}"
def http(st):
    return f"HTTP {st}" if st else "no answer"

secrets = oauth.default_io()[0]
now = time.time()

# Widths fit the cells, measured without ANSI, so every row lines up whatever
# the amounts; a row cut short (no permission, no API org) ends in a message
# that spans the columns it leaves out. What could not be read shows as ?,
# never as 0.
TIER = {"auto_trust_tier_a": "a", "auto_trust_tier_b": "b", "auto_trust_tier_c": "c",
        "auto_api_evaluation": "eval"}
head = ["#", "Account", "Org", "Link", "Included", "Purchased", "Month", "Tier", "Keys"]
RIGHT = (0, 8)
UNKNOWN = paint(GREY, "?")

def account_rows(i, label, summaries, org_err):
    """The table rows of one account."""
    lead = [str(i), trunc(label, 22)]
    if org_err is not None:
        return [lead + [paint(GREY, f"could not read organizations ({http(org_err)})")]]
    if not summaries:
        return [lead + [paint(GREY, "no API organization")]]
    rows = []
    for s in summaries:
        name = trunc(s["name"] or "", 24)
        if s["no_permission"]:
            rows.append(lead + [name, paint(GREY, "no billing permission")])
            continue
        ln = s["link"] or {}
        link = {"linked": f"{ln.get('plan') or '?'} {(ln.get('monthly') or 0):.0f}$/m",
                "eligible": paint(YELLOW, "eligible"), "ineligible": "ineligible"}.get(
                    ln.get("status"), "—")
        inc = s["included"]
        if inc is None:  # the credits read failed (the API's 403 is no_permission, above)
            inc_txt = pur_txt = UNKNOWN
        else:
            if not inc.get("left"):
                inc_txt = paint(GREY, "-")
            elif not inc.get("expires"):
                inc_txt = paint(GREEN, f"{money(inc['left'])} $")
            else:
                left = inc["expires"] - now
                color = RED if left < engine.CREDIT_URGENT else (YELLOW if left < engine.CREDIT_SOON else GREEN)
                inc_txt = paint(color, f"{money(inc['left'])} $ → {day(inc['expires'])}")
            pur = s["purchased"] or {}
            pur_txt = (f"{money(pur.get('left'))} $" + (f" → {day(pur['expires'])}" if pur.get("expires") else "")
                       if pur.get("left") else paint(GREY, "0"))
        spend = "?" if s["spend"] is None else money(s["spend"])
        cap = "?" if s["cap"] is None else f"{s['cap']:,.0f}"
        month = f"{spend}/{cap} $"
        keys = str((s["keys"] or {}).get("active", 0)) if s["keys"] is not None else "?"
        t = s["tier"] or ""
        tier = TIER.get(t) or t.rsplit("_", 1)[-1] or "?"
        rows.append(lead + [name, link, inc_txt, pur_txt, month, tier, keys])
    return rows

# results: email -> (n, its table rows, its summaries, why its organizations
# are unknown, or None); turned: the accounts the Console turned away
results, missing, rejected, silent, turned = {}, [], [], [], []
stop, refused = None, []  # refused: the latest accounts in a row turned away
for i, acc in enumerate(accounts, 1):
    # a disabled account only when asked for by number (it is a read)
    if (only and i != int(only)) or (not only and acc.get("disabled")):
        continue
    em = (acc.get("email") or "").lower()
    ck = secrets.read(oauth.VAULT, oauth.console_slot(em)) if em else None
    if not ck:
        missing.append(i)
        continue
    label = acc.get("label") or em
    c = oauth.Console(ck)
    try:
        st, acct = c.get("/api/account")
        if c.blocked:
            stop = f"Cloudflare is challenging the Console: stopped at #{i}."
            break
        if st == 200 and not isinstance(acct, dict):
            raise ValueError("/api/account: not an object")
        if st != 200 or not acct.get("email_address"):
            # the API rejecting this session is not the edge turning the
            # client away: only the latter, twice in a row, stops the run
            kind = oauth.console_failure(st, acct)
            {"rejected": rejected, "refused": turned, "silent": silent}[kind].append((i, st))
            refused = refused + [(i, st)] if kind == "refused" else []
            if len(refused) >= 2:
                (a, sa), (b, sb) = refused[-2:]
                stop = f"The Console turned away #{a} and #{b} in a row ({http(sa)}, {http(sb)}): stopped."
                break
            continue
        refused = []
        st, orgs = c.get("/api/organizations")
        org_err = None if st == 200 and isinstance(orgs, list) else st
        orgs = orgs if org_err is None else []
        per = {o["uuid"]: c.read_org(o["uuid"]) for o in orgs
               if "api" in (o.get("capabilities") or []) and o.get("uuid")}
        summ = engine.console_summary(acct, orgs, per, now)
        # a shape the table or the warnings would choke on fails here, for
        # this account alone, and never reaches the cache check reads
        rows_i = account_rows(i, label, summ, org_err)
        engine.credit_warnings({f"#{i}": summ}, now)
    except Exception:
        summ, org_err = [], "unexpected"
        rows_i = [[str(i), trunc(label, 22), paint(GREY, "unexpected reply")]]
    if c.blocked:
        # this account was read only in part (a blocked reply would even pass
        # for "no billing permission"): it is left out, and so are the rest
        stop = f"Cloudflare is challenging the Console: stopped at #{i}."
        break
    results[em] = (i, rows_i, summ, org_err)
    sys.stderr.write(f"  read {i} {label}\n")

if stop:
    print(paint(RED, stop + " Try again later (the cache keeps its last full read)."))

rows = [r for _, rows_i, _, _ in sorted(results.values(), key=lambda v: v[0]) for r in rows_i]

def vlen(s):
    return len(_ANSI.sub("", s))
W = [len(h) for h in head]
for r in rows:
    short = len(r) < len(head)
    for c, cell in enumerate(r[:-1] if short else r):
        W[c] = max(W[c], vlen(cell))
def line(cells):
    last = len(cells) - 1
    return "  " + "  ".join(cell if (c == last and c < len(head) - 1)
                            else pad(cell, W[c], c in RIGHT)
                            for c, cell in enumerate(cells))
print()
if rows:
    print(paint(BOLD, line(head)))
    for r in rows:
        print(line(r))
    print()
    print(paint(GREY, "  Included: API, Agent SDK and `claude -p` with a key of that org only — not"
                      " interactive Claude Code. Purchased: everything."))
warns = engine.credit_warnings({f"#{i}": summ for i, _, summ, _ in results.values()}, now)
colors = {"red": RED, "yellow": YELLOW, "grey": GREY}
for level, text in warns:
    print("  " + paint(colors.get(level, GREY), text))

def spans(ns):
    """#11, #13-#28: consecutive accounts as one span."""
    out, k = [], 0
    while k < len(ns):
        j = k
        while j + 1 < len(ns) and ns[j + 1] == ns[j] + 1:
            j += 1
        out.append(f"#{ns[k]}" + (f"-#{ns[j]}" if j > k else ""))
        k = j + 1
    return ", ".join(out)
if missing:
    print(paint(GREY, "  No Console session: " + spans(missing)
                + " — log platform.claude.com in on the account's Chrome profile, then claude-swap keys-sync"))
if rejected:
    print(paint(GREY, "  Console session rejected: "
                + ", ".join(f"#{i} ({http(st)})" for i, st in rejected)
                + " — log it back in, then claude-swap keys-sync"))
if turned:
    print(paint(GREY, "  Console turned the request away: "
                + ", ".join(f"#{i} ({http(st)})" for i, st in turned) + " — try again later"))
if silent:
    print(paint(GREY, "  Console did not answer: "
                + ", ".join(f"#{i} ({http(st)})" for i, st in silent) + " — try again later"))

# Only a full run rewrites the cache: one account (credits <n>) or a run cut
# short would leave check without the others' warnings. An account whose
# organizations could not be read, or that answered in a shape not expected,
# is unknown, not empty: it stays out.
if results and not only and not stop:
    path = os.path.expanduser("~/.claude/claude-swap-credits.json")
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.fchmod(fd, 0o600)  # a leftover .tmp keeps its mode through O_CREAT
    with os.fdopen(fd, "w") as f:
        json.dump({"updated": now, "accounts": {em: summ for em, (_, _, summ, err) in results.items()
                                                if err is None}}, f)
    os.replace(tmp, path)
PYEOF
}

cmd_set_disabled() {
  check_store
  local target="$1" val="$2"
  [ -n "$target" ] || { echo "Usage: claude-swap $3 <n>"; exit 1; }

  python3 - "$STORE" "$target" "$val" <<'PYEOF'
import json, sys
store_path, target, val = sys.argv[1], int(sys.argv[2]), sys.argv[3] == "1"
with open(store_path) as f:
    d = json.load(f)
accounts = d.get("accounts", [])
if target < 1 or target > len(accounts):
    print(f"Error: account {target} does not exist (valid: 1-{len(accounts)})")
    sys.exit(1)
acc = accounts[target - 1]
if val:
    acc["disabled"] = True
else:
    acc.pop("disabled", None)
with open(store_path, "w") as f:
    json.dump(d, f, indent=2)
who = acc.get("label") or acc.get("email") or "?"
print(f"Account {target} ({who}) {'disabled: check/auto/keys-sync will skip it' if val else 're-enabled'}.")
PYEOF
}

cmd_set_reserved() {
  check_store
  local target="$1" val="$2"
  [ -n "$target" ] || { echo "Usage: claude-swap $3 <n>"; exit 1; }

  python3 - "$STORE" "$target" "$val" <<'PYEOF'
import json, sys
store_path, target, val = sys.argv[1], sys.argv[2], sys.argv[3] == "1"
with open(store_path) as f:
    d = json.load(f)
accounts = d.get("accounts", [])
n = int(target) if target.isdigit() else 0
if not 1 <= n <= len(accounts):
    print(f"Error: account {target} does not exist (valid: 1-{len(accounts)})")
    sys.exit(1)
acc = accounts[n - 1]
if val:
    acc["reserved"] = True
else:
    acc.pop("reserved", None)
with open(store_path, "w") as f:
    json.dump(d, f, indent=2)
who = acc.get("label") or acc.get("email") or "?"
if val:
    print(f"Account {n} ({who}) reserved: auto and the watch never use it, and it never"
          " becomes the shared login.")
    print(f"Sessions on it: claude-swap run [{n}] -- <claude args>")
    if d.get("active") == n:
        print("It is the shared login right now: the watch moves off it at its next look"
              " (or swap by hand: claude-swap <n>).")
else:
    print(f"Account {n} ({who}) is an ordinary account again: auto and the watch may use it.")
PYEOF
}

cmd_run() {
  # A Claude Code session on a reserved account, whatever the shared login
  # does: no swap of it and no watch moves it. The reserved sessions share a
  # config dir, the lane, which `claude-swap <n>` moves from one reserved
  # account to another, open sessions included (on its full login Claude in
  # Chrome works). A new one starts on the account the lane is on; a number
  # only picks one while the lane is on none.
  # Another account's session gets its setup-token in CLAUDE_CODE_OAUTH_TOKEN,
  # which Claude Code puts before the keychain, and stays on it.
  check_store
  command -v claude >/dev/null 2>&1 || { echo "Error: claude (Claude Code) is not in PATH"; exit 1; }
  # passed with -c, not on stdin: claude takes this process over (exec) and
  # needs the terminal as its stdin
  local run_py
  read -r -d '' run_py <<'PYEOF' || true
import json, os, subprocess, sys, time, types

oauth = types.ModuleType("oauth")
exec(os.environ["CLAUDE_SWAP_OAUTH"], oauth.__dict__)
CACHE = os.path.expanduser("~/.claude/claude-swap-usage.json")
# Claude Code points the browsers' native-messaging manifests into the config
# dir it runs on: a moment after it starts they point back into ~/.claude
# (the same script either way, through the link).
RESTORE = ("import os, time, types\n"
           "time.sleep(20)\n"
           "oauth = types.ModuleType('oauth')\n"
           "exec(os.environ['CLAUDE_SWAP_OAUTH'], oauth.__dict__)\n"
           "oauth.restore_native_hosts(os.path.realpath(oauth.RUN_BASE))\n")

store_path, args = sys.argv[1], sys.argv[2:]
head, rest = (args[:args.index("--")], args[args.index("--") + 1:]) \
    if "--" in args else (args, [])
if len(head) > 1 or (head and not head[0].isdigit()):
    sys.exit("Usage: claude-swap run [n] [-- <claude args>]")
with open(store_path) as f:
    store = json.load(f)
accounts = store.get("accounts", [])
before = json.dumps(store, sort_keys=True)

# usage from the snapshot check and the watch keep (no request here); a row
# counts only if it is still the same account (a remove renumbers them)
try:
    with open(CACHE) as f:
        snap = json.load(f)
    cached = {r.get("n"): r for r in snap.get("accounts", [])}
except Exception:
    snap, cached = {}, {}

def usage(n, acc):
    c = cached.get(n)
    if c and c.get("label") == acc.get("label") and (
            c.get("u5") is not None or c.get("u7") is not None):
        return c  # a 5h window not started yet reads None: 7d still counts
    return None

macos = sys.platform == "darwin"
if macos:
    secrets, _, http = oauth.default_io(True)
    oauth.lane_adopt(store, secrets)
if head:
    n = int(head[0])
    if not 1 <= n <= len(accounts):
        sys.exit(f"Error: account {n} does not exist (valid: 1-{len(accounts)})")
    acc = accounts[n - 1]
    if acc.get("disabled") or not acc.get("token"):
        sys.exit(f"Error: account {n} is disabled or has no token")
    ln = oauth.lane_of(store) if macos and acc.get("reserved") else None
    if ln and ln != n:
        # a number never moves the others (an old alias in an open shell
        # did, onto a seat at its limit): only claude-swap <n> does
        c = usage(ln, accounts[ln - 1])
        sys.stderr.write(f"claude-swap run: the reserved sessions are on #{ln}"
                         + (f" (5h {(c.get('u5') or 0):.0f}% · 7d {(c.get('u7') or 0):.0f}%)"
                            if c else "")
                         + f": this one joins them. To move them all to #{n}:"
                         f"  claude-swap {n}\n")
        n, acc = ln, accounts[ln - 1]
else:
    # the account the reserved sessions are on; else the only reserved one
    pool = [(i, a) for i, a in enumerate(accounts, 1)
            if a.get("reserved") and a.get("token") and not a.get("disabled")]
    n = oauth.lane_of(store) if macos else None
    if n:
        acc = accounts[n - 1]
    elif not pool:
        sys.exit("No reserved account: mark one with  claude-swap reserve <n>")
    elif len(pool) > 1:
        sys.exit("Several reserved accounts ("
                 + ", ".join(f"#{i} {a.get('email') or a.get('label') or '?'}" for i, a in pool)
                 + "): say which one,  claude-swap run <n> -- <claude args>")
    else:
        n, acc = pool[0]

# A reserved account's sessions run on the lane, a config dir they share,
# which `claude-swap <n>` moves among the reserved accounts (macOS: the lane's
# keychain item). Any other account's run on its setup-token: its full login
# lives in Claude Code's own credential, and two copies of one would spend
# each other's refresh token.
own, mode, note, moved = None, "setup", None, None
if macos and acc.get("reserved"):
    try:
        own, mode, note, moved = oauth.lane_prepare(store, n, secrets, http, time.time())
    except Exception as e:
        own, note = None, f"the reserved sessions' config dir could not be set up ({type(e).__name__}: {e})"
    if json.dumps(store, sort_keys=True) != before:
        oauth.commit(store_path, store, top=("lane",))
    if not own:
        mode = "setup"

c = usage(n, acc)
fig = (f"5h {(c.get('u5') or 0):.0f}% · 7d {(c.get('u7') or 0):.0f}%" if c
       else "no usage figures yet")
age = time.time() - (snap.get("updated") or 0)
if c and age > 600:
    fig += f" ({int(age // 60)} min old)"
lane = "reserved" if acc.get("reserved") else "NOT reserved: the watch may also use it"
sys.stderr.write(f"claude-swap run: #{n} {acc.get('label') or '?'} · {acc.get('email') or '-'}"
                 f" · {fig} · {lane} · {'full login' if mode == 'oauth' else 'setup-token'}\n")
if moved:
    sys.stderr.write(f"claude-swap run: the reserved sessions moved from #{moved} to #{n}"
                     " (the open ones follow within 30 s)\n")
if own:
    sys.stderr.write("claude-swap run: claude-swap <n> moves it, with the other reserved"
                     " sessions, to reserved account n\n")
if mode == "oauth":
    prof = acc.get("chrome_profile")
    if oauth.chrome_ready(acc):
        sys.stderr.write("claude-swap run: Claude in Chrome drives Chrome profile"
                         f" '{oauth.profile_names().get(prof, prof)}'\n")
    else:
        sys.stderr.write("claude-swap run: for Claude in Chrome, sign the extension in to"
                         f" {acc.get('email')} in a Chrome profile, then claude-swap keys-sync\n")
else:
    if note:
        sys.stderr.write(f"claude-swap run: on the setup-token: {note}\n")
    if "--chrome" in rest:
        # the Claude in Chrome bridge turns setup-tokens away (missing scope)
        rest = [a for a in rest if a != "--chrome"]
        sys.stderr.write("claude-swap run: --chrome dropped (Claude in Chrome needs a full"
                         " login: claude-swap auth " + str(n) + ")\n")

env = {k: v for k, v in os.environ.items()
       if k not in ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "CLAUDE_CODE_OAUTH_TOKEN",
                    "CLAUDE_CODE_OAUTH_REFRESH_TOKEN", "CLAUDE_CODE_OAUTH_SCOPES",
                    "CLAUDE_SWAP_ENGINE", "CLAUDE_SWAP_OAUTH")}
if own:
    env["CLAUDE_CONFIG_DIR"] = own
    # detached, so it outlives this process turning into claude and leaves
    # no child behind for claude to reap
    subprocess.run([sys.executable, "-c",
                    "import subprocess, sys; subprocess.Popen([sys.executable, '-c',"
                    " sys.argv[1]], start_new_session=True, stdin=subprocess.DEVNULL,"
                    " stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)", RESTORE],
                   timeout=10)
else:
    env["CLAUDE_CODE_OAUTH_TOKEN"] = acc["token"]
# the statusline shows this account: the lane's, whichever it is by then
env["CLAUDE_SWAP_PINNED"] = "reserved" if own else str(n)
os.execvpe("claude", ["claude"] + rest, env)
PYEOF
  exec python3 -c "$run_py" "$STORE" "$@"
}

cmd_remove() {
  check_store
  local target="$1"

  [ -n "$target" ] || { echo "Usage: claude-swap remove <n>"; exit 1; }

  python3 - "$STORE" "$target" <<'PYEOF'
import json, sys

store_path = sys.argv[1]
target = int(sys.argv[2])

with open(store_path) as f:
    d = json.load(f)

accounts = d.get("accounts", [])
if target < 1 or target > len(accounts):
    print(f"Error: account {target} does not exist (valid: 1-{len(accounts)})")
    sys.exit(1)

acc = accounts[target - 1]
print(f"Account {target}: {acc.get('label', '?')} / {acc.get('email') or '-'}")
PYEOF

  read -r -p "Remove this account? (y/n) " confirm
  case "$confirm" in
    [yY]*)
      python3 -c "
import json, os, types
with open('$STORE') as f:
    d = json.load(f)
target = $target
gone = d['accounts'].pop(target - 1)
live = d.get('live') or {}
for k in ('n', 'from'):  # account numbers after the removed one move down
    if live.get(k) == target:
        live[k] = None
    elif (live.get(k) or 0) > target:
        live[k] -= 1
if gone.get('email'):  # its saved full login and its Console session go too
    oauth = types.ModuleType('oauth')
    exec(os.environ['CLAUDE_SWAP_OAUTH'], oauth.__dict__)
    secrets = oauth.default_io()[0]
    if gone.get('oauth'):
        secrets.delete(oauth.VAULT, oauth.slot(gone))
    secrets.delete(oauth.VAULT, oauth.console_slot(gone['email']))
active = d.get('active', 0)
if active == target:
    d['active'] = 1 if d['accounts'] else 0
elif active > target:
    d['active'] = active - 1
with open('$STORE', 'w') as f:
    json.dump(d, f, indent=2)
print(f'Account {target} removed. Active: {d[\"active\"]}')
"
      ;;
    *)
      echo "Cancelled."
      ;;
  esac
}

cmd_interactive() {
  check_store
  cmd_status
  echo ""
  _deep_check
  echo ""

  local count
  count=$(python3 -c "import json; print(len(json.load(open('$STORE'))['accounts']))")

  read -r -p "Switch? (1-$count · a=auto · af=auto (model fable) · wg=watch · wr=watch+resets · wf=watch (model fable) · wp=stop · ws=status · Enter=exit) " choice

  case "$choice" in
    "") exit 0 ;;
    auto|a) cmd_auto general ;;
    af) _fable_alias; cmd_auto general ;;
    wf) _fable_alias; cmd_watch_start general ;;
    wg) cmd_watch_start general ;;
    wr) cmd_watch_start general --auto-reset ;;
    wp) cmd_watch_stop ;;
    ws) cmd_watch_status ;;
    [0-9]*) _do_rotate "$choice" ;;
    *) echo "Invalid choice: $choice" ;;
  esac
}

# --- Main ---

check_python

case "${1:-}" in
  version|--version|-v)
    cmd_version
    ;;
  help|--help|-h)
    cmd_help
    ;;
  init)
    cmd_init
    ;;
  status|s)
    cmd_status
    ;;
  check|c)
    cmd_check
    ;;
  auto|a)
    cmd_auto "${2:-general}"
    ;;
  af)
    cmd_auto fable
    ;;
  watch)
    case "${2:-status}" in
      start) shift 2; cmd_watch_start "$@" ;;
      run) shift 2; cmd_watch_run "$@" ;;
      stop) cmd_watch_stop ;;
      status) cmd_watch_status ;;
      reserved) shift 2; cmd_watch_reserved "$@" ;;
      *) echo "Usage: claude-swap watch [start [--auto-reset]|stop|status|reserved [n ...|off]]"; exit 1 ;;
    esac
    ;;
  add)
    cmd_add "${2:-}"
    ;;
  run)
    shift
    cmd_run "$@"
    ;;
  reserve)
    cmd_set_reserved "${2:-}" 1 reserve
    ;;
  unreserve)
    cmd_set_reserved "${2:-}" 0 unreserve
    ;;
  remove|rm)
    cmd_remove "${2:-}"
    ;;
  key)
    cmd_key "${2:-}"
    ;;
  keys-sync|ks)
    cmd_keys_sync
    ;;
  reset)
    shift
    cmd_reset "$@"
    ;;
  model)
    cmd_model "${2:-}"
    ;;
  credits)
    cmd_credits "${2:-}"
    ;;
  auth)
    shift
    cmd_auth "$@"
    ;;
  chrome)
    shift
    cmd_chrome "$@"
    ;;
  disable)
    cmd_set_disabled "${2:-}" 1 disable
    ;;
  enable)
    cmd_set_disabled "${2:-}" 0 enable
    ;;
  "")
    cmd_interactive
    ;;
  [0-9]*)
    _do_rotate "$1"
    ;;
