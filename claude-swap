  unreserve)
    cmd_set_reserved "${2:-}" 0 unreserve
    ;;
  remove|rm)
    cmd_remove "${2:-}"
    ;;
  key)
    cmd_key "${2:-}"
    ;;
  keys-sync|ks)
    cmd_keys_sync
    ;;
  reset)
    shift
    cmd_reset "$@"
    ;;
  model)
    cmd_model "${2:-}"
    ;;
  credits)
    cmd_credits "${2:-}"
    ;;
  auth)
    shift
    cmd_auth "$@"
    ;;
  chrome)
    shift
    cmd_chrome "$@"
    ;;
  disable)
    cmd_set_disabled "${2:-}" 1 disable
    ;;
  enable)
    cmd_set_disabled "${2:-}" 0 enable
