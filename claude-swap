<body>
<header class="top" id="top">
  <h1 class="brand">claude-swap<span class="ver" id="ver"></span></h1>
  <span class="chips" id="chips"></span>
  <button type="button" class="btn" id="refresh" title="Read every account's usage again (claude-swap check)">Refresh</button>
</header>
<main>
  <noscript><p class="banner">This page needs JavaScript.</p></noscript>
  <p class="banner" id="banner" role="alert" hidden></p>
  <section class="hero card" id="hero" aria-label="Where cl is"><p class="mute">Loading…</p></section>
  <nav class="jump" aria-label="Sections">
    <a href="#groups">Groups</a><a href="#accounts">Accounts</a><a href="#calendar">Calendar</a><a href="#watch">Watch</a>
  </nav>
  <section class="bridge card" id="bridge" aria-label="Every account at a glance"></section>
  <section id="warnings" aria-label="Warnings" hidden></section>
  <section id="quota" hidden>
    <h2>Free quota <small>summed per group: 1.0 is one whole account left</small></h2>
    <div class="quota card" id="quota-body"></div>
    <div id="quota-notes"></div>
  </section>
  <section id="groups">
    <h2>Groups <small>where each group's sessions are, its watch and the order it follows</small></h2>
    <div class="vsw" id="sw-grp" role="group" aria-label="Show the groups as"></div>
    <div class="groups" id="groups-body"></div>
    <div class="vx" id="alt-grp" hidden></div>
  </section>
  <section id="accounts">
    <h2>Accounts <small id="acc-sub"></small></h2>
    <div class="vsw" id="sw-acc" role="group" aria-label="Show the accounts as"></div>
    <div class="card acc-wrap" id="acc-wrap"><table class="acc" id="acc"></table></div>
    <p class="ungrouped" id="ungrouped" hidden></p>
    <div class="vx" id="alt-acc" hidden></div>
  </section>
  <section id="calendar">
    <h2>Next 8 days <small>weekly renewals and plans that end</small></h2>
    <div class="vsw" id="sw-cal" role="group" aria-label="Show the calendar as"></div>
    <div class="card cal-wrap" id="cal"></div>
    <div class="legend" id="legend"></div>
    <div class="vx" id="alt-cal" hidden></div>
  </section>
  <section id="watch">
    <h2>Watch <small>the daemon that moves cl and the lanes</small></h2>
    <div class="card watch" id="watch-body"></div>
  </section>
</main>
<footer id="foot"></footer>
<dialog id="dlg" aria-labelledby="dlg-title"><div class="dlg" id="dlg-box"></div></dialog>
<div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
<script nonce="__NONCE__">
"use strict";
// ---- pure: begin (no DOM; tests run this part in node)
const CS = (() => {
  const DAYS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
  const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  const pad2 = (n) => String(n).padStart(2, "0");
  // check's colours: green under 50, yellow under 80, red from 80
  const level = (p) => (p == null ? "none" : p < 50 ? "ok" : p < 80 ? "warn" : "bad");
  const clamp = (p) => Math.max(0, Math.min(100, Number(p) || 0));
  const pct = (p) => (p == null ? "–" : Math.round(p) + "%");
  const hm = (t) => { const d = new Date(t * 1000); return pad2(d.getHours()) + ":" + pad2(d.getMinutes()); };
  const sameDay = (a, b) => new Date(a * 1000).toDateString() === new Date(b * 1000).toDateString();
  // check's "%a %d %H:%M", just the time when it is today
  function when(t, now) {
    if (t == null) return "–";
    const d = new Date(t * 1000);
    return now != null && sameDay(t, now) ? hm(t) : DAYS[d.getDay()] + " " + pad2(d.getDate()) + " " + hm(t);
  }
  const date = (t) => { const d = new Date(t * 1000); return pad2(d.getDate()) + " " + MONTHS[d.getMonth()]; };
  function span(sec) {
    const s = Math.max(0, Math.round(sec));
    if (s < 90) return "1 min";
    const m = Math.round(s / 60);
    if (m < 60) return m + " min";
    const h = Math.floor(m / 60), mm = m % 60;
    if (h < 24) return h + " h" + (mm ? " " + mm + " min" : "");
    const d = Math.floor(h / 24), hh = h % 24;
    return d + " d" + (hh ? " " + hh + " h" : "");
  }
  // free quota: '1.7' whole accounts from 170 (% free, summed)
  const whole = (free) => { const w = (free || 0) / 100; return w < 10 ? w.toFixed(1) : w.toFixed(0); };
  const okConfirm = (s) => ["si", "sí"].includes(String(s == null ? "" : s).trim().toLowerCase());
  // what `claude-swap reset <n> <kind>` takes for a grant: full, or the model's name
  const resetKind = (g) => (g.kind === "full" ? "full" : String(g.model || "").toLowerCase());
  // at its limit: the 5h, the week, or the model's own limit when the watch counts it
  const blocked = (a, leave, counted) => !!a.rate_limited
    || [a.u5, a.u7].concat(counted ? [a.model_pct] : []).some((p) => p != null && p >= leave);
  // Refresh. The server refuses one while the data is under a minute old
  // ({started: false, wait, reason}) or while a check runs ("already running").
  function refreshPlan(r) {
    if (!r.ok) return { poll: false, wait: 0, say: "Refresh failed: " + r.error };
    const d = r.data || {};
    if (d.started) return { poll: true, wait: 0, say: "Reading every account again…" };
    const running = /already running/.test(d.reason || "");
    return { poll: running, wait: running ? 0 : Math.max(0, Math.ceil(Number(d.wait) || 0)),
      say: d.reason ? "Not started: " + d.reason : "Not started" };
  }
  const refreshDone = (cache) => !!cache && !cache.refreshing;
  function refreshButton(polling, refreshing, untilMs, nowMs) {
    if (polling || refreshing) return { disabled: true, label: "Refreshing…" };
    const left = Math.ceil((untilMs - nowMs) / 1000);
    return left > 0 ? { disabled: true, label: "Refresh in " + left + " s" } : { disabled: false, label: "Refresh" };
  }
  // POST, then read the state until no check runs (new data or not), or hand
  // back the wait when refused. io: post(), read() -> cache, sleep(ms), now() ms,
  // say(text), before (cache.updated when it began).
  async function runRefresh(io) {
    const plan = refreshPlan(await io.post());
    io.say(plan.say);
    if (!plan.poll) return { wait: plan.wait, cache: null };
    const until = io.now() + 190000;  // the server takes the lock as dead after 180 s
    let cache = null;
    await io.sleep(2000);
    while (io.now() < until) {
      cache = await io.read();
      if (refreshDone(cache)) {
        if (cache.updated === io.before) io.say("The check ended without new data.");
        break;
      }
      await io.sleep(3000);
    }
    return { wait: 0, cache };
  }
  // A group's seats as the page edits them. Only seats with a token count,
  // and only they are sent: the server refuses the others.
  function seatPlan(w, isLive, pending) {
    const live = (w.choices || []).filter(isLive);
    const cur = { all: !!w.all, set: new Set(w.all ? live : (w.seats || []).filter(isLive)) };
    const same = (x) => x.all === cur.all
      && (x.all || (x.set.size === cur.set.size && [...x.set].every((n) => cur.set.has(n))));
    const draft = pending && !same(pending)
      ? { all: !!pending.all, set: new Set([...pending.set].filter(isLive)) } : cur;
    return { live, cur, draft, changed: draft !== cur, valid: draft.all || draft.set.size >= 2 };
  }
  // the claude-swap arguments each control sends (/api/action's whitelist)
  const cmd = {
    useCl: (n) => [String(n), "general"],
    moveLane: (n, g) => [String(n), g],
    watchOn: (g, on) => ["watch", g, on ? "on" : "off"],
    watchResets: (g, on) => ["watch", g, "resets", on ? "on" : "off"],
    watchSeats: (g, seats, all) => (all ? ["watch", g, "seats", "all"]
      : ["watch", g, "seats"].concat(seats.slice().sort((a, b) => a - b).map(String))),
    watchOrder: (g, key) => ["watch", g, "order", key],
    watchStart: (auto) => (auto ? ["watch", "start", "--auto-reset"] : ["watch", "start"]),
    watchStop: () => ["watch", "stop"],
  };
  return { DAYS, level, clamp, pct, hm, when, date, span, whole, okConfirm, resetKind, blocked, cmd,
    refreshPlan, refreshDone, refreshButton, runRefresh, seatPlan };
})();
// ---- pure: end

const $ = (id) => document.getElementById(id);
let S = null;            // the last /api/state
let csrf = "";
let fetchedAt = 0;       // when S came (this clock)
let inflight = null;
let polling = false;
const ui = { seats: {}, view: {}, more: {}, autoReset: null, pending: false, busy: false,
  refreshUntil: 0, follow: 0, cooldown: 0 };
const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

// ---------- DOM ----------
function h(tag, props, ...kids) {
  const el = document.createElement(tag);
  for (const [k, v] of Object.entries(props || {})) {
    if (v == null || v === false) continue;
    if (k === "class") el.className = v;
    else if (k === "text") el.textContent = v;
    else if (k === "vars") for (const [p, x] of Object.entries(v)) el.style.setProperty(p, String(x));
    else if (k.startsWith("on") && typeof v === "function") el.addEventListener(k.slice(2), v);
    else if (k === "checked" || k === "disabled" || k === "selected" || k === "value") el[k] = v;
    else el.setAttribute(k, v === true ? "" : String(v));
  }
  for (const kid of kids.flat(Infinity)) {
    if (kid == null || kid === false) continue;
    el.append(kid instanceof Node ? kid : String(kid));
  }
  return el;
}
const fill = (el, ...kids) => { el.replaceChildren(...kids.flat(Infinity).filter((k) => k != null && k !== false)); return el; };

// ---------- time and figures ----------
const nowS = () => (S ? S.now + (Date.now() - fetchedAt) / 1000 : Date.now() / 1000);
const when = (t) => CS.when(t, nowS());
const acc = (n) => (S && S.accounts.find((a) => a.n === n)) || null;
const modelName = () => (S && S.model && S.model.column) || "Model";

function bar(p, label) {
  const lv = CS.level(p);
  return h("span", { class: "bar " + lv, role: "img", "aria-label": label + " " + CS.pct(p) + " used",
    vars: { "--p": CS.clamp(p) } }, h("i"));
}
function meter(p, label) {
  return h("span", { class: "meter" }, bar(p, label), h("span", { class: "v " + CS.level(p), text: CS.pct(p) }));
}
function plate(key, n, kind, small) {
  return h("span", { class: "plate " + (kind || "") + (small ? " sm" : ""),
    "aria-label": key + " is on " + (n ? "#" + n : "no account") },
    h("span", { class: "k", text: key }), h("span", { class: "n", text: n ? String(n) : "–" }));
}
const pill = (cls, text, title) => h("span", { class: "pill " + cls, text, title });

// ---------- talking to the server ----------
function load() {
  if (inflight) return inflight;
  inflight = (async () => {
    try {
      const r = await fetch("/api/state", { credentials: "same-origin", cache: "no-store",
        headers: { Accept: "application/json" } });
      const body = await r.json().catch(() => null);
      if (!r.ok || !body || body.error) throw new Error((body && body.error) || "HTTP " + r.status);
      S = body; csrf = body.csrf || ""; fetchedAt = Date.now();
      banner(null);
      // a check someone else started (the statusline's): read again soon, not in a minute
      clearTimeout(ui.follow);
      if (S.cache && S.cache.refreshing && !polling) ui.follow = setTimeout(load, 5000);
      if ($("dlg").open) ui.pending = true; else render();
      return true;
    } catch (e) {
      banner("Could not read the state: " + e.message
        + (S ? ". What you see was read at " + CS.hm(fetchedAt / 1000) + "." : "."));
      return false;
    } finally { inflight = null; }
  })();
  return inflight;
}

async function call(method, path, body, retried) {
  const opts = { method, credentials: "same-origin", cache: "no-store",
    headers: { "X-CSRF-Token": csrf, Accept: "application/json" } };
  if (body !== undefined) { opts.headers["Content-Type"] = "application/json"; opts.body = JSON.stringify(body); }
  let r, data;
  try {
    r = await fetch(path, opts);
    data = await r.json().catch(() => null);
  } catch (e) {
    return { ok: false, status: 0, error: "Could not reach the server (" + e.message + ")" };
  }
  // a server restarted since this page loaded: fetch a new token, try once more
  if (r.status === 403 && data && data.error === "no valid session token" && !retried) {
    await load();
    return call(method, path, body, true);
  }
  if (!r.ok) return { ok: false, status: r.status, error: (data && data.error) || "HTTP " + r.status, data };
  return { ok: true, status: r.status, data };
}

function banner(text) { const b = $("banner"); b.hidden = !text; b.textContent = text || ""; }
let toastTimer = 0;
function toast(text) {
  const t = $("toast"); t.textContent = text; t.hidden = false;
  clearTimeout(toastTimer); toastTimer = setTimeout(() => { t.hidden = true; }, 4200);
}

async function refresh() {
  if (polling || Date.now() < ui.refreshUntil) return;
  polling = true; renderTop();
  const res = await CS.runRefresh({
    post: () => call("POST", "/api/refresh", {}),
    read: async () => { await load(); return S && S.cache; },
    sleep, now: () => Date.now(), say: toast, before: S && S.cache ? S.cache.updated : null });
  polling = false;
  if (res.wait) ui.refreshUntil = Date.now() + res.wait * 1000;
  cooldown();
}
// the button counts down a refused refresh's wait, then comes back
function cooldown() {
  clearTimeout(ui.cooldown);
  renderTop();
  if (Date.now() < ui.refreshUntil) ui.cooldown = setTimeout(cooldown, 1000);
}
const sleep = (ms) => new Promise((ok) => setTimeout(ok, ms));

// ---------- the dialog: every action asks first, then shows what claude-swap said ----------
function openDialog(build) {
  const d = $("dlg");
  fill($("dlg-box"), build());
  if (!d.open) d.showModal();
}
function closeDialog() { const d = $("dlg"); if (d.open) d.close(); }

function resultView(r) {
  if (!r.ok) {
    if (r.status === 0) {  // the request went out: the command may be running still
      return [h("p", { class: "result t-warn", text: "No answer" }),
        h("p", { text: r.error + ". The command may still be running: the page reads the state again." })];
    }
    return [h("p", { class: "result t-bad", text: r.status === 409 ? "Busy" : "Not run" }),
      h("p", { text: r.error })];
  }
  const d = r.data;
  return [h("p", { class: "result " + (d.ok ? "t-ok" : "t-bad"),
      text: d.ok ? "Done" : "It did not work" + (d.code != null ? " (exit " + d.code + ")" : "") }),
    d.output ? h("pre", { class: "out", text: d.output.trim() || "(no output)" }) : null];
}

function confirmRun(o) {
  // o: {title, lines: [text], args, verb, danger}
  openDialog(() => {
    const status = h("div", { class: "dlg-status", role: "status" });
    const cancel = h("button", { type: "button", class: "btn", text: "Cancel", onclick: closeDialog });
    const go = h("button", { type: "button", class: "btn " + (o.danger ? "danger solid" : "primary"), text: o.verb });
    go.addEventListener("click", async () => {
      go.disabled = cancel.disabled = true; ui.busy = true;
      fill(status, h("p", { class: "mute", text: "Running… (a lane move can take 30 s)" }));
      const r = await call("POST", "/api/action", { args: o.args });
      ui.busy = false;
      fill(status, resultView(r));
      go.remove(); cancel.disabled = false; cancel.textContent = "Close";
      cancel.focus();
      load();
    });
    return [h("h3", { id: "dlg-title", text: o.title }),
      (o.lines || []).map((t) => h("p", { text: t })),
      h("code", { class: "cmd", text: "claude-swap " + o.args.join(" ") }),
      status,
      h("div", { class: "dlg-actions" }, cancel, go)];
  });
}

function openReset(a) {
  const res = a.resets || {};
  let opts = (res.grants || []).map((g) => ({
    kind: CS.resetKind(g), grant: g.id, usable: g.usable_now !== false,
    name: g.kind === "full" ? "Full reset" : (g.model || "Model") + " reset",
    info: [g.left + " left", g.ends ? "lapses " + when(g.ends) : null,
      g.five_hour ? "clears the 5h too" : null,
      g.by_plan ? "ends with the plan" : null,
      g.usable_now === false ? "claude.ai says it cannot be spent now" : null].filter(Boolean).join(" · "),
  }));
  if (!opts.length) {  // a usage cache of before 1.23: counts only, the preview finds the grant
    if (res.full) opts.push({ kind: "full", usable: true, name: "Full reset", info: res.full + " left" });
    if (res.model) opts.push({ kind: modelName().toLowerCase(), usable: true,
      name: modelName() + " reset", info: res.model + " left" });
  }
  let chosen = null, spend = null, ticket = 0;
  openDialog(() => {
    const said = h("div", { role: "status" });
    const input = h("input", { class: "confirm-in", type: "text", autocomplete: "off", autocapitalize: "none",
      spellcheck: "false", "aria-label": "Type si to spend it", placeholder: "si", disabled: true });
    const cancel = h("button", { type: "button", class: "btn", text: "Cancel", onclick: closeDialog });
    const go = h("button", { type: "button", class: "btn danger solid", text: "Spend the reset", disabled: true });
    const sync = () => { go.disabled = !(spend && CS.okConfirm(input.value)) || ui.busy; };
    input.addEventListener("input", sync);
    input.addEventListener("keydown", (e) => { if (e.key === "Enter" && !go.disabled) go.click(); });
    const radios = [];
    async function preview(o) {
      chosen = o; spend = null; input.disabled = true; input.value = ""; sync();
      const mine = ++ticket;
      radios.forEach((r) => { r.disabled = true; });
      fill(said, h("p", { class: "mute", text: "Reading what it clears from claude.ai (nothing is spent)…" }));
      const q = new URLSearchParams({ n: String(a.n) });
      if (o.kind) q.set("kind", o.kind);
      if (o.grant) q.set("grant", o.grant);
      const r = await call("GET", "/api/reset-preview?" + q.toString());
      if (mine !== ticket) return;
      radios.forEach((r2, i) => { r2.disabled = !opts[i].usable; });
      const again = () => h("button", { type: "button", class: "btn small", text: "Try again", onclick: () => preview(o) });
      if (!r.ok) { fill(said, h("p", { class: "t-bad", text: r.error }), again()); return; }
      const text = (r.data.text || "").trim();
      fill(said, text ? h("pre", { class: "out", text }) : null,
        r.data.ok ? h("p", { text: "Type si below to spend it. It cannot be undone." })
          : [h("p", { class: "t-bad", text: "claude-swap would not spend this one." }), again()]);
      if (r.data.ok && Array.isArray(r.data.argv)) { spend = r.data.argv; input.disabled = false; input.focus(); }
      sync();
    }
    go.addEventListener("click", async () => {
      if (!spend || !CS.okConfirm(input.value)) return;
      ui.busy = true; go.disabled = cancel.disabled = input.disabled = true;
      radios.forEach((r) => { r.disabled = true; });
      const args = spend;
      fill(said, h("code", { class: "cmd", text: "claude-swap " + args.join(" ") }),
        h("p", { class: "mute", text: "Spending… (it reads the account again afterwards)" }));
      const r = await call("POST", "/api/action", { args, confirm: input.value.trim() });
      ui.busy = false;
      fill(said, h("code", { class: "cmd", text: "claude-swap " + args.join(" ") }), resultView(r));
      input.hidden = true; go.remove(); cancel.disabled = false; cancel.textContent = "Close"; cancel.focus();
      load();
    });
    const list = h("div", { class: "opts", role: "radiogroup", "aria-label": "Which reset" },
      opts.map((o, i) => {
        const r = h("input", { type: "radio", name: "grant", disabled: !o.usable });
        radios.push(r);
        r.addEventListener("change", () => { if (r.checked) preview(o); });
        return h("label", { class: "opt" + (o.usable ? "" : " dis") }, r,
