.plate.lane{background:transparent;color:var(--ink);border:2px solid var(--ink);box-shadow:none}
.plate.none{background:var(--inset);color:var(--ink3);box-shadow:none;border:2px dashed var(--rule)}
.plate.sm{min-width:58px;padding:6px 9px 3px;border-radius:9px;gap:3px}
.plate.sm .k{font-size:11px}
.plate.sm .n{font-size:38px}

/* hero: cl */
.hero{display:grid;grid-template-columns:auto minmax(0,1fr) minmax(280px,420px);gap:18px 24px;align-items:center;
  margin-top:4px;padding:18px 20px}
