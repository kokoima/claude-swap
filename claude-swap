table.acc .c-acct{min-width:150px;max-width:260px}
table.acc .c-acct .lb{font-weight:600;overflow-wrap:anywhere}
table.acc .c-r5,table.acc .c-renews,table.acc .c-rst,table.acc .c-chr{white-space:nowrap;font-family:var(--f-mono);font-size:12px}
