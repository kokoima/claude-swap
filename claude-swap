def pick_org(orgs, current=None):
    """The claude.ai org an account's plan and usage are read from.

    An account can belong to several: the personal one it signed up with,
    free or with its own subscription, and a Team's (an admin of the Team
    too). The pick must not hang on the order claude.ai lists them in: the
    org already in use while it is still paid, else the account's own
    subscription (Max, Pro), else a paid one (a Team seat), else the first
    chat org.
    """
    chat = [o for o in orgs or [] if "chat" in (o.get("capabilities") or [])]
    paid = [o for o in chat if not free_tier(o.get("rate_limit_tier"))]
    for o in paid:
        if current and o.get("uuid") == current:
            return o
    for o in paid:
        if {"claude_max", "claude_pro"} & set(o.get("capabilities") or []):
            return o
    return (paid or chat or list(orgs or []) or [None])[0]


