  const onSw = h("button", { type: "button", class: "switch", role: "switch", id: id("on"),
    "aria-checked": String(!!w.on), disabled: !can, onclick: () => askWatchOn(g, !w.on) }, "Watch");
  const rsSw = h("button", { type: "button", class: "switch", role: "switch", id: id("resets"),
    "aria-checked": String(!!w.resets), disabled: !can, onclick: () => askWatchResets(g, !w.resets) }, "Free resets");
  const rows = [h("div", { class: "ctl-row" }, onSw, rsSw, w.clause ? h("span", { class: "clause", text: w.clause }) : null)];
  // the order it follows: only once the server knows the criteria
  if (Array.isArray(S.order_criteria) && S.order_criteria.length && g.order_criterion) {
    const sel = h("select", { id: id("order"), disabled: !can, "aria-label": g.name + "'s watch order" },
      S.order_criteria.map((c) => h("option", { value: c.key, text: c.label, selected: c.key === g.order_criterion })));
    sel.addEventListener("change", () => { if (sel.value !== g.order_criterion) askOrder(g, sel.value, sel); });
    rows.push(h("div", { class: "ctl-row" }, h("span", { class: "ctl-lbl", text: "Follows" }), sel));
  }
  const isLive = (n) => { const a = acc(n); return !!(a && a.live); };
  const plan = CS.seatPlan(w, isLive, ui.seats[g.name]);
  if (!plan.changed) delete ui.seats[g.name];
  const { cur, draft, changed, valid } = plan;
  const all = h("input", { type: "checkbox", id: id("all"), checked: draft.all, disabled: !can });
  all.addEventListener("change", () => {
    ui.seats[g.name] = { all: all.checked, set: new Set(all.checked ? plan.live : cur.set) };
    renderGroups();
  });
  const boxes = w.choices.map((n) => {
    const a = acc(n);
    const live = isLive(n);
    // a seat without a token shows what the watch has, and is never sent
    const box = h("input", { type: "checkbox", id: id("s" + n), disabled: !can || draft.all || !live,
      checked: draft.all || (live ? draft.set.has(n) : !w.all && (w.seats || []).includes(n)) });
    box.addEventListener("change", () => {
      const s = new Set(draft.set);
