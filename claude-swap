who = acc.get("label") or acc.get("email") or "?"
if val:
    print(f"Account {n} ({who}) reserved: auto and the watch never use it, and it never"
          " becomes the shared login.")
    print(f"Sessions on it: claude-swap run [{n}] -- <claude args>")
    if d.get("active") == n:
        print("It is the shared login right now: the watch moves off it at its next look"
              " (or swap by hand: claude-swap <n>).")
else:
    print(f"Account {n} ({who}) is an ordinary account again: auto and the watch may use it.")
PYEOF
}

cmd_run() {
  # A Claude Code session on a reserved account, whatever the shared login
  # does: no swap of it and no watch moves it. The reserved sessions of a
  # group share a config dir, its lane, which `claude-swap <n> [g]` moves
  # from one of its seats to another, open sessions included (on a full login
  # Claude in Chrome works). A new one starts on the seat its group's lane is
  # on (--group g; else n's home group, else the default group); a number
  # only picks one while that lane is on none.
  # Another account's session gets its setup-token in CLAUDE_CODE_OAUTH_TOKEN,
  # which Claude Code puts before the keychain, and stays on it.
  check_store
  command -v claude >/dev/null 2>&1 || { echo "Error: claude (Claude Code) is not in PATH"; exit 1; }
  # passed with -c, not on stdin: claude takes this process over (exec) and
  # needs the terminal as its stdin
  local run_py
  read -r -d '' run_py <<'PYEOF' || true
import json, os, subprocess, sys, time, types

oauth = types.ModuleType("oauth")
exec(os.environ["CLAUDE_SWAP_OAUTH"], oauth.__dict__)
CACHE = os.path.expanduser("~/.claude/claude-swap-usage.json")
# Claude Code points the browsers' native-messaging manifests into the config
# dir it runs on: a moment after it starts they point back into ~/.claude
# (the same script either way, through the link).
RESTORE = ("import os, time, types\n"
           "time.sleep(20)\n"
           "oauth = types.ModuleType('oauth')\n"
           "exec(os.environ['CLAUDE_SWAP_OAUTH'], oauth.__dict__)\n"
           "oauth.restore_native_hosts(os.path.realpath(oauth.RUN_BASE))\n")

store_path, args = sys.argv[1], sys.argv[2:]
head, rest = (args[:args.index("--")], args[args.index("--") + 1:]) \
    if "--" in args else (args, [])
head, group, err = oauth.split_group(head)
if err or len(head) > 1 or (head and not head[0].isdigit()):
    sys.exit("Usage: claude-swap run [n] [--group g] [-- <claude args>]")
with open(store_path) as f:
    store = json.load(f)
accounts = store.get("accounts", [])
before = json.dumps(store, sort_keys=True)

# usage from the snapshot check and the watch keep (no request here); a row
# counts only if it is still the same account (a remove renumbers them)
try:
    with open(CACHE) as f:
        snap = json.load(f)
    cached = {r.get("n"): r for r in snap.get("accounts", [])}
except Exception:
    snap, cached = {}, {}

def usage(n, acc):
    c = cached.get(n)
    if c and c.get("label") == acc.get("label") and (
            c.get("u5") is not None or c.get("u7") is not None):
        return c  # a 5h window not started yet reads None: 7d still counts
    return None

macos = sys.platform == "darwin"
adopted = None
if macos:
    secrets, _, http = oauth.default_io(True)
    adopted = oauth.lane_adopt(store, secrets)
# the seat the group's lane is on, which a number joins and never moves (an
# old alias in an open shell did, onto a seat at its limit): only
# claude-swap <n> moves it; with no lane on a seat, the number, else the
# group's only seat
g, n, asked, err = oauth.run_seat(store, int(head[0]) if head else None, group, macos)
if err:
    sys.exit(err)
acc = accounts[n - 1]
k = oauth.lane_key(store, g) if g else None
them = oauth.lane_label(store, k)
if asked:
    c = usage(n, acc)
    sys.stderr.write(f"claude-swap run: {them} are on #{n}"
                     + (f" (5h {(c.get('u5') or 0):.0f}% · 7d {(c.get('u7') or 0):.0f}%)"
                        if c else "")
                     + f": this one joins them. To move them all to #{asked}:"
                     f"  {oauth.move_hint(store, asked, g)}\n")

# A reserved account's sessions run on its group's lane, a config dir they
# share, which `claude-swap <n> [g]` moves among the group's seats (macOS:
# the lane's keychain item). Any other account's run on its setup-token: its
# full login lives in Claude Code's own credential, and two copies of one
# would spend each other's refresh token.
own, mode, note, moved = None, "setup", None, None
if macos and g:
    try:
        own, mode, note, moved = oauth.lane_prepare(store, n, secrets, http, time.time(),
                                                     group=k)
    except Exception as e:
        own, note = None, f"{them}' config dir could not be set up ({type(e).__name__}: {e})"
    if json.dumps(store, sort_keys=True) != before:
        # this group's lane record alone: another lane may have moved meanwhile
        oauth.commit(store_path, store,
                     top=oauth.lane_top(store, k, *([None] if adopted else [])),
                     before=json.loads(before))
    if not own:
        mode = "setup"

c = usage(n, acc)
fig = (f"5h {(c.get('u5') or 0):.0f}% · 7d {(c.get('u7') or 0):.0f}%" if c
       else "no usage figures yet")
age = time.time() - (snap.get("updated") or 0)
if c and age > 600:
    fig += f" ({int(age // 60)} min old)"
lane = (("reserved" + (f" ({k})" if k else "")) if not oauth.in_general(store, n)
        else "NOT reserved: the watch may also use it")
sys.stderr.write(f"claude-swap run: #{n} {acc.get('label') or '?'} · {acc.get('email') or '-'}"
                 f" · {fig} · {lane} · {'full login' if mode == 'oauth' else 'setup-token'}\n")
if moved:
    sys.stderr.write(f"claude-swap run: {them} moved from #{moved} to #{n}"
                     " (the open ones follow within 30 s)\n")
if own:
    w = oauth.move_word(store, k)
    sys.stderr.write(f"claude-swap run: claude-swap <n> {k} moves it, with the other {k}"
                     f" reserved sessions, to seat n of {k}\n" if k else
                     f"claude-swap run: claude-swap <n>{w} moves it, with the other reserved"
                     f" sessions, to seat n of{w}\n" if w else
                     "claude-swap run: claude-swap <n> moves it, with the other reserved"
                     " sessions, to reserved account n\n")
if mode == "oauth":
    prof = acc.get("chrome_profile")
    if oauth.chrome_ready(acc):
        sys.stderr.write("claude-swap run: Claude in Chrome drives Chrome profile"
                         f" '{oauth.profile_names().get(prof, prof)}'\n")
    else:
        sys.stderr.write("claude-swap run: for Claude in Chrome, sign the extension in to"
                         f" {acc.get('email')} in a Chrome profile, then claude-swap keys-sync\n")
else:
    if note:
        sys.stderr.write(f"claude-swap run: on the setup-token: {note}\n")
    if "--chrome" in rest:
        # the Claude in Chrome bridge turns setup-tokens away (missing scope)
        rest = [a for a in rest if a != "--chrome"]
        sys.stderr.write("claude-swap run: --chrome dropped (Claude in Chrome needs a full"
                         " login: " + oauth.auth_hint(n, oauth.login_group(store, n, k)) + ")\n")

env = {x: v for x, v in os.environ.items()
       if x not in ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "CLAUDE_CODE_OAUTH_TOKEN",
                    "CLAUDE_CODE_OAUTH_REFRESH_TOKEN", "CLAUDE_CODE_OAUTH_SCOPES",
                    "CLAUDE_SWAP_ENGINE", "CLAUDE_SWAP_OAUTH", "CLAUDE_SWAP_FROM_DIR")}
if own:
    env["CLAUDE_CONFIG_DIR"] = own
    # detached, so it outlives this process turning into claude and leaves
    # no child behind for claude to reap
    subprocess.run([sys.executable, "-c",
                    "import subprocess, sys; subprocess.Popen([sys.executable, '-c',"
                    " sys.argv[1]], start_new_session=True, stdin=subprocess.DEVNULL,"
                    " stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)", RESTORE],
                   timeout=10)
else:
    env["CLAUDE_CODE_OAUTH_TOKEN"] = acc["token"]
# the statusline shows this account: the lane's, whichever it is by then
# (the default group's lane is still called reserved, as up to 1.20)
env["CLAUDE_SWAP_PINNED"] = (k or "reserved") if own else str(n)
os.execvpe("claude", ["claude"] + rest, env)
PYEOF
  exec python3 -c "$run_py" "$STORE" "$@"
}

cmd_remove() {
  check_store
  local target="$1"

  [ -n "$target" ] || { echo "Usage: claude-swap remove <n>"; exit 1; }

  python3 - "$STORE" "$target" <<'PYEOF'
import json, sys

store_path = sys.argv[1]
target = int(sys.argv[2])

with open(store_path) as f:
    d = json.load(f)

accounts = d.get("accounts", [])
if target < 1 or target > len(accounts):
    print(f"Error: account {target} does not exist (valid: 1-{len(accounts)})")
    sys.exit(1)

acc = accounts[target - 1]
print(f"Account {target}: {acc.get('label', '?')} / {acc.get('email') or '-'}")
PYEOF

  read -r -p "Remove this account? (y/n) " confirm
  case "$confirm" in
    [yY]*)
      python3 - "$STORE" "$target" <<'PYEOF'
import os, sys, types

oauth = types.ModuleType("oauth")
exec(os.environ["CLAUDE_SWAP_OAUTH"], oauth.__dict__)

store_path, target = sys.argv[1], int(sys.argv[2])
store = oauth.load_store(store_path)
# out of the groups and the watch's lists too; the numbers after it move down
gone, slots = oauth.remove_account(store, target)
if slots:  # its saved full logins (main and per group) and its Console session go too
    secrets = oauth.default_io()[0]
    for s in slots:
        secrets.delete(oauth.VAULT, s)
oauth.save_store(store_path, store)
print(f"Account {target} removed. Active: {store['active']}")
PYEOF
      ;;
    *)
      echo "Cancelled."
      ;;
  esac
}

# --- The web (1.23) ---
# claude-swap web: the page of WEB_PY, on 127.0.0.1 only. On macOS a
# LaunchAgent of its own runs it (as the watch's); `tailscale serve` exposes
# it on the tailnet. The server writes "<pid> <port>" to its pidfile.

WEB_LABEL="com.claude-swap.web"
WEB_PLIST="$HOME/Library/LaunchAgents/$WEB_LABEL.plist"
WEB_PID="$HOME/.claude/claude-swap-web.pid"
WEB_LOG="$HOME/.claude/claude-swap-web.log"
WEB_PORT=10002

_web_usage() {
  echo "Usage: claude-swap web [start] [--port N] | web stop | web status | web --foreground [--port N]"
  echo "       claude-swap web devices [<name|ip>... | any]"
  echo "  start (the default) runs it as a LaunchAgent on http://127.0.0.1:N (N: $WEB_PORT);"
  echo "  --foreground serves in this terminal. On the tailnet:"
  echo "    tailscale serve --bg --https=N http://127.0.0.1:N"
  echo "  devices lists the tailnet's devices; with names or IPs it lets only those use the page"
  echo "  (any: every device of the allowed logins again)."
}

_web_pid() {
  local pid=""
  read -r pid _ < "$WEB_PID" 2>/dev/null || true
  echo "$pid"
}

_web_port() {
  local port=""
  read -r _ port < "$WEB_PID" 2>/dev/null || true
  echo "${port:-?}"
}

web_alive() {
  [ -f "$WEB_PID" ] || return 1
  local pid
  pid="$(_web_pid)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

_web_launchd_install() {
  # $1 = absolute path of this script, the rest = its arguments
  local py
  py="$(python3 -c 'import sys; print(sys.executable)')"
  launchctl bootout "gui/$(id -u)/$WEB_LABEL" >/dev/null 2>&1 || true
  mkdir -p "$(dirname "$WEB_PLIST")"
  # PATH pins this shell's python3, and has where tailscale usually is
  python3 - "$WEB_PLIST" "$WEB_LABEL" "$WEB_LOG" \
    "$(dirname "$py"):$(dirname "$1"):/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin" \
    "$@" <<'PYEOF'
import os, plistlib, sys
path, label, log, path_env, *argv = sys.argv[1:]
env = {"PATH": path_env}
# not CLAUDE_SWAP_WEB_BIN nor CLAUDE_SWAP_TAILSCALE: test hooks, never the agent's
for k in ("CLAUDE_SWAP_STORE", "CLAUDE_CONFIG_DIR", "CLAUDE_SWAP_VAULT", "CLAUDE_SWAP_RUN"):
    if os.environ.get(k):
        env[k] = os.environ[k]
with open(path, "wb") as f:
    plistlib.dump({"Label": label, "ProgramArguments": argv,
                   "RunAtLoad": True, "KeepAlive": True, "ThrottleInterval": 30,
                   "StandardOutPath": log, "StandardErrorPath": log,
                   "EnvironmentVariables": env}, f)
PYEOF
  launchctl bootstrap "gui/$(id -u)" "$WEB_PLIST"
}

cmd_web() {
  local sub="" port="" fg=0
  if [ "${1:-}" = devices ]; then
    shift
    cmd_web_devices "$@"
    return
  fi
  while [ $# -gt 0 ]; do
    case "$1" in
      start|stop|status)
        if [ -n "$sub" ]; then _web_usage; exit 1; fi
        sub="$1" ;;
      --foreground) fg=1 ;;
      --port)
        if [ $# -lt 2 ]; then _web_usage; exit 1; fi
        port="$2"; shift ;;
      --port=*) port="${1#--port=}" ;;
      help|-h|--help) _web_usage; return 0 ;;
      *) _web_usage; exit 1 ;;
    esac
    shift
  done
  if [ -n "$port" ]; then
    case "$port" in
      ""|*[!0-9]*) _web_usage; exit 1 ;;
    esac
    if [ "${#port}" -gt 5 ] || [ "$port" -lt 1024 ] || [ "$port" -gt 65535 ]; then
      _web_usage; exit 1
    fi
  fi
  if [ "$fg" = 1 ]; then
    if [ -n "$sub" ]; then _web_usage; exit 1; fi
    cmd_web_serve "${port:-$WEB_PORT}"
    return
  fi
  case "${sub:-start}" in
    start) cmd_web_start "${port:-$WEB_PORT}" ;;
    stop|status)
      if [ -n "$port" ]; then _web_usage; exit 1; fi
      "cmd_web_$sub" ;;
  esac
}

cmd_web_devices() {
  # no arguments: the tailnet's devices and which the list lets in; names or
  # IPs: save them as web.devices; any: remove the list
  check_store
  CLAUDE_SWAP_WEB="$WEB_PY" python3 - "$STORE" "$@" <<'PYEOF'
import copy, os, sys, types

engine = types.ModuleType("engine")
exec(os.environ["CLAUDE_SWAP_ENGINE"], engine.__dict__)
oauth = types.ModuleType("oauth")
exec(os.environ["CLAUDE_SWAP_OAUTH"], oauth.__dict__)
web = types.ModuleType("web")
web.engine, web.oauth = engine, oauth
exec(os.environ.pop("CLAUDE_SWAP_WEB"), web.__dict__)

store_path, args = sys.argv[1], sys.argv[2:]
store = oauth.load_store(store_path)
store_read = copy.deepcopy(store)
w = store.get("web") if isinstance(store.get("web"), dict) else {}
present = "devices" in w
raw = w.get("devices")
listed = [x for x in raw if isinstance(x, str)] if isinstance(raw, list) else []
low = {x.strip().lower() for x in listed}

devs = {}  # one entry per node (its stable ID), with all its IPs
for ip, info in web.tailscale_nodes().items():
    d = devs.setdefault(info["id"] or "ip:" + ip, {"id": info["id"], "host": info["host"],
                                                   "label": info["label"], "ips": [],
                                                   "login": info["login"], "os": info["os"]})
    d["ips"].append(ip)
devs = sorted(devs.values(), key=lambda d: (d["label"] or d["host"], d["id"]))


def allowed(d):
    return bool(d["id"] and d["id"].lower() in low) or any(i.lower() in low for i in d["ips"])


def resolve(a):
    k = a.strip().lower()
    for pick in (lambda d: k in [i.lower() for i in d["ips"]],
                 lambda d: d["label"].lower() == k,
                 lambda d: d["host"].lower() == k):
        hit = [d for d in devs if pick(d)]
        if len(hit) == 1:
            return hit[0], None
        if hit:
            return None, f"{a} is ambiguous ({len(hit)} devices: " + ", ".join(
                f"{d['label'] or d['host']} {d['id']} {d['ips'][0]}" for d in hit) + ")"
    return None, f"{a} is not a device of this tailnet now"


if args == ["any"]:
    if isinstance(store.get("web"), dict):
        store["web"].pop("devices", None)
        if not store["web"]:
            store.pop("web")
    oauth.save_changes(store_path, store_read, store)
    print("Any device of the allowed logins may use the page.")
elif args:
    chosen, errs = [], []
    for a in args:
        d, why = resolve(a)
        if d:
            chosen.append(d)
        else:
            errs.append(why)
    if errs:
        for e in errs:
            print(e, file=sys.stderr)
        print("Known: " + (", ".join(f"{d['label'] or d['host']} ({d['ips'][0]})" for d in devs)
                           or "none (is tailscale running?)"), file=sys.stderr)
        sys.exit(1)
    if not isinstance(store.get("web"), dict):
        store["web"] = {}
    store["web"]["devices"] = list(dict.fromkeys(d["id"] or d["ips"][0] for d in chosen))
    oauth.save_changes(store_path, store_read, store)
    print("Only these devices may use the page: "
          + ", ".join(d["label"] or d["host"] for d in chosen))
else:
    for d in devs:
        print(f" {'*' if allowed(d) else ' '} {d['host'] or '-':<18} {d['label'] or '-':<18}"
              f" {d['os'] or '-':<8} {d['login'] or '-':<22} {d['id'] or '-':<14}"
              f" {', '.join(d['ips'])}")
    if not devs:
        print("  (no devices: tailscale is not running or not installed)")
    if not present:
        print("Devices allowed: any device of the allowed logins")
    else:
        print("Devices allowed (* above): "
              + (", ".join(d["label"] or d["host"] for d in devs if allowed(d)) or "nobody"))
        stale = [x for x in listed if not any(
            x.strip().lower() == (d["id"] or "").lower()
            or x.strip().lower() in [i.lower() for i in d["ips"]] for d in devs)]
        if not isinstance(raw, list) or len(listed) != len(raw):
            stale.append("(unreadable entries: they let nobody in)")
        if stale:
            print("  no longer in the tailnet: " + ", ".join(stale))
PYEOF
}

cmd_web_serve() {
  # The server itself (what the LaunchAgent runs). Its actions run this very
  # script (CLAUDE_SWAP_WEB_BIN another one, for tests).
  check_store
  local bin="${CLAUDE_SWAP_WEB_BIN:-$0}"
  case "$bin" in
    /*) ;;
    *) bin="$(cd "$(dirname "$bin")" && pwd)/$(basename "$bin")" ;;
  esac
  mkdir -p "$(dirname "$WEB_PID")"
  CLAUDE_SWAP_WEB="$WEB_PY" CLAUDE_SWAP_WEB_PAGE="$(_web_page)" exec python3 - "$STORE" "$bin" "$VERSION" "$1" "$WEB_PID" <<'PYEOF'
import os, sys, types

engine = types.ModuleType("engine")
exec(os.environ["CLAUDE_SWAP_ENGINE"], engine.__dict__)
oauth = types.ModuleType("oauth")
exec(os.environ["CLAUDE_SWAP_OAUTH"], oauth.__dict__)
web = types.ModuleType("web")
web.engine, web.oauth = engine, oauth
exec(os.environ.pop("CLAUDE_SWAP_WEB"), web.__dict__)

store_path, bin_path, version, port, pid_path = sys.argv[1:6]
sys.exit(web.main(store_path, bin_path, version, int(port), pid_path))
PYEOF
}

cmd_web_start() {
  check_store
  local port="$1"
  if web_alive; then
    echo "Web already running (PID $(_web_pid)) on http://127.0.0.1:$(_web_port)." \
         "Stop it first with 'claude-swap web stop'."
    return
  fi
  rm -f "$WEB_PID"
  local self
  self="$(command -v claude-swap || echo "$0")"
  self="$(cd "$(dirname "$self")" && pwd)/$(basename "$self")"
  if [ "$IS_MACOS" = true ]; then
    _web_launchd_install "$self" web --foreground --port "$port"
  else
    nohup "$self" web --foreground --port "$port" >> "$WEB_LOG" 2>&1 &
  fi
  local _
  for _ in $(seq 1 30); do
    web_alive && break
    sleep 0.5
  done
  if ! web_alive; then
    echo "Web did not come up — see $WEB_LOG"
    if [ "$IS_MACOS" = true ]; then
      # else launchd retries every 30 s on a taken port
      launchctl bootout "gui/$(id -u)/$WEB_LABEL" >/dev/null 2>&1 || true
      rm -f "$WEB_PLIST"
    fi
    exit 1
  fi
  echo "Web started — http://127.0.0.1:$port (PID $(_web_pid))"
  if [ "$IS_MACOS" = true ]; then
    echo "  runs as a LaunchAgent: starts at login, restarts if it dies"
  fi
  echo "  on the tailnet: tailscale serve --bg --https=$port http://127.0.0.1:$port"
  echo "  log:  $WEB_LOG"
  echo "  stop: claude-swap web stop"
}

cmd_web_stop() {
  local stopped=false
  if [ "$IS_MACOS" = true ] && [ -f "$WEB_PLIST" ]; then
    launchctl bootout "gui/$(id -u)/$WEB_LABEL" >/dev/null 2>&1 || true
    rm -f "$WEB_PLIST"
    stopped=true
  fi
  if web_alive; then
    kill "$(_web_pid)" 2>/dev/null || true
    stopped=true
  fi
  if [ "$stopped" = true ]; then
    rm -f "$WEB_PID"
    echo "Web stopped."
  elif [ -f "$WEB_PID" ]; then
    rm -f "$WEB_PID"
    echo "Stale pidfile found (process already dead) — cleaned up."
  else
    echo "Web was not running."
  fi
}

cmd_web_status() {
  local port how=""
  if web_alive; then
    port="$(_web_port)"
    [ "$IS_MACOS" = true ] && [ -f "$WEB_PLIST" ] && how=" · LaunchAgent"
    echo "Web RUNNING (PID $(_web_pid)$how) — http://127.0.0.1:$port"
    echo "  on the tailnet: tailscale serve --bg --https=$port http://127.0.0.1:$port"
  elif [ -f "$WEB_PID" ]; then
    echo "Web DEAD (stale pidfile — clean up with 'claude-swap web stop')"
  else
    echo "Web not running."
  fi
  [ -f "$STORE" ] || return 0
  python3 - "$STORE" <<'PYEOF'
import json, sys
try:
    with open(sys.argv[1]) as f:
        web = json.load(f).get("web") or {}
except Exception:
    web = {}
allow = web.get("allow") if isinstance(web, dict) else None
if isinstance(allow, list):
    print("  who may use it: " + (", ".join(a for a in allow if isinstance(a, str)) or "nobody")
          + " (the store's web.allow), and this Mac")
else:
    print("  who may use it: the tailnet node's owner (tailscale status), and this Mac")
dev = web.get("devices") if isinstance(web, dict) else None
if isinstance(dev, list):
    print("  devices: " + str(len([d for d in dev if isinstance(d, str)]))
          + " chosen (the store's web.devices; claude-swap web devices)")
elif isinstance(web, dict) and "devices" in web:
    print("  devices: none (web.devices is not a list: nobody on the tailnet)")
else:
    print("  devices: any device of those logins (claude-swap web devices to choose)")
PYEOF
  if [ -f "$WEB_LOG" ]; then
    echo ""
    echo "Last log lines:"
    tail -5 "$WEB_LOG" | sed 's/^/  /'
  fi
}

