.ch.cl .tag{color:var(--accent)}
.ch .m{display:flex;gap:2px;align-items:stretch;height:52px}
.ch .m i{position:relative;width:6px;border-radius:1.5px;background:var(--track);overflow:hidden}
.ch .m i::before{content:"";position:absolute;left:0;right:0;bottom:0;height:calc(var(--p,0) * 1%);
  background:var(--lvl,var(--ink3));transition:height .5s cubic-bezier(.2,.7,.2,1)}
.ch .m i::after{content:"";position:absolute;inset:0;
  background:repeating-linear-gradient(0deg,transparent 0 calc(12.5% - 1.5px),var(--panel) calc(12.5% - 1.5px) 12.5%)}
.ch .num{font:600 10px/15px var(--f-mono);color:var(--ink2)}
.ch.cl .num{color:var(--on-accent);background:var(--accent);border-radius:3px;padding:0 3px}
.ch.lane .num{box-shadow:inset 0 0 0 1.5px var(--ink2);border-radius:3px;padding:0 3px}
.ch.blocked .num{color:var(--bad)}
.ch.off{opacity:.35}
.bridge-key{flex-basis:100%;font-size:11px;color:var(--ink3);margin-top:2px}

