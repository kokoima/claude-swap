.warns{display:grid;gap:6px;margin:0;padding:0;list-style:none}
.warns li{display:grid;grid-template-columns:86px minmax(0,1fr);gap:10px;align-items:baseline;padding:8px 12px;
  border-radius:9px;border:1px solid var(--rule);border-left-width:4px;background:var(--panel);font-size:14px}
.warns li.red{border-left-color:var(--bad-fill)} .warns li.yellow{border-left-color:var(--warn-fill)}
