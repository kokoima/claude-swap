def is_free(tier):
    t = (tier or "").lower()
    return "free" in t or t in ("", "default_claude_ai")

def plan_end(acc):
    """When the current plan stops: cancellation or scheduled downgrade."""
    dates = [parse_iso(acc.get("plan_ends"))]
    if acc.get("plan_next"):
        dates.append(parse_iso(acc["plan_next"].get("date")))
    dates = [d for d in dates if d and d > datetime.now()]
    return min(dates) if dates else None

def resets_summary(eligible, grants):
    """What is left and the soonest lapse (a local time) per kind, and per
    model for the model resets (None: a model that cannot be told), for the
    Rst cell and the resets lines. None when claude.ai said nothing."""
    if eligible is None:
        return None

    def summary(gs):
        ends = min((g["ends"] for g in gs if g["ends"]), default=None)
        return {"left": sum(g["left"] for g in gs), "ends": local_dt(ends),
                "by_plan": any(g.get("by_plan") for g in gs if g["ends"] == ends)}

    mine = [g for g in grants if g["kind"] == engine.MODEL]
    return {"eligible": eligible,
            engine.FULL: summary([g for g in grants if g["kind"] == engine.FULL]),
            engine.MODEL: summary(mine),
            "models": {m: summary([g for g in mine if g["model"] == m])
                       for m in {g["model"] for g in mine}}}

def parse_epoch(ts):
    try:
        return datetime.fromtimestamp(int(ts))
    except (ValueError, TypeError):
        return None

def parse_iso(s):
    if not s:
        return None
    try:
        dt = datetime.fromisoformat(str(s).replace("Z", "+00:00"))
        if dt.tzinfo:
            dt = dt.astimezone().replace(tzinfo=None)
        # claude.ai returns ...:59.75, which would print as 21:59 where the
        # ratelimit headers printed 22:00. Round to the minute so both
        # sources render the same clock time.
        dt += timedelta(seconds=30)
        return dt.replace(second=0, microsecond=0)
    except (ValueError, TypeError):
        return None

def local_dt(epoch):
    """An epoch as parse_iso gives a time: local, naive, to the minute."""
    if not epoch:
        return None
    return (datetime.fromtimestamp(epoch) + timedelta(seconds=30)).replace(
        second=0, microsecond=0)

def ep(dt):
    return dt.timestamp() if dt else None

