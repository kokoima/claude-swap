def console_failure(st, body):
    """What a failed GET /api/account says, from its status and its body
    (None when it was not JSON): "rejected" — the API's own answer (a JSON
    401/403, or a 200 with no email): that session is dead, log it back in;
    "refused" — a 429, or a 403 the edge sent without JSON: the client is
    being turned away, and two in a row stop a run; "silent" — no answer, or
    the server is down."""
    if st == 429 or (st == 403 and body is None):
        return "refused"
    if not st or st >= 500:
        return "silent"
    return "rejected"

class Console:
    """GET-only client for the Console (platform.claude.com) on a session
    cookie. Requests are spaced across every instance (claude.com throttles
    bursts), and a Cloudflare challenge (an HTML page, even with a 200)
    blocks it: later gets answer (0, None). A failed get's body is None
    when the reply was not JSON (the edge, not the API, answered)."""
    GAP = 1.6
    _last = [0.0]

    def __init__(self, session_key, opener=None, clock=None, sleep=None):
        self._sk = session_key
        self._open = opener or urllib.request.urlopen
        self._clock = clock or time.time
        self._sleep = sleep or time.sleep
        self.blocked = False

    def get(self, path, org=None):
        if self.blocked:
            return 0, None
        wait = self.GAP - (self._clock() - Console._last[0])
        if wait > 0:
            self._sleep(wait)
        h = {"Cookie": f"sessionKey={self._sk}", "User-Agent": BROWSER_UA,
             "Accept": "application/json", "anthropic-client-platform": "web_console",
             "Referer": CONSOLE + "/settings/billing"}
        if org:
            h["x-organization-uuid"] = org
        req = urllib.request.Request(CONSOLE + path, headers=h, method="GET")
        Console._last[0] = self._clock()
        try:
            with self._open(req, timeout=20) as r:
                raw = r.read()
                try:
                    return r.status, (json.loads(raw) if raw else None)
                except ValueError:
                    # an HTML page is never the API's answer, even with a 200
                    if b"Just a moment" in raw or raw.lstrip()[:1] == b"<":
                        self.blocked = True
                        return r.status, None
                    raise
        except urllib.error.HTTPError as e:
            try:
                raw = e.read() or b""
            except Exception:
                raw = b""
            if b"Just a moment" in raw:
                self.blocked = True
                return e.code, None
            try:
                return e.code, json.loads(raw)
            except ValueError:
                return e.code, None
        except Exception:
            return 0, None

    def read_org(self, uuid):
        """The billing replies of one API org, {key: reply or HTTP status};
        it stops after the API's 403 on credits (no billing permission
        there). A failure that did not come with JSON is the edge, not the
        API: it is kept as 0 (unknown), so a 403 always means the API's."""
        out = {}
        for key, path in (("credits", f"/api/organizations/{uuid}/prepaid/credits"),
                          ("spend", f"/api/organizations/{uuid}/current_spend"),
                          ("limits", f"/api/organizations/{uuid}/spend_limits"),
                          ("link", f"/api/quirky-lollipop/organizations/{uuid}"
                                   "/link-state?include_linkable_plans=true"),
                          ("keys", f"/api/console/organizations/{uuid}/api_keys")):
            st, body = self.get(path, uuid)
            out[key] = body if st == 200 and body is not None else (st if body is not None else 0)
            if self.blocked or (key == "credits" and out[key] == 403):
                break
        return out

class Keychain:
    """macOS generic passwords, written the way Claude Code writes its own:
    the secret travels on stdin (`security -i`), never on a command line."""
    def __init__(self, user=None):
        self.user = user or os.environ.get("USER") or ""

    def read(self, service, account=None):
        try:
            r = subprocess.run(["security", "find-generic-password", "-a",
                                account or self.user, "-s", service, "-w"],
                               capture_output=True, text=True, timeout=10)
        except Exception:
            return None
        return r.stdout.strip() if r.returncode == 0 else None

    def write(self, service, text, account=None):
        acct = account or self.user
        if any(c in s for s in (acct, service) for c in '"\n'):
            return False
        cmd = (f'add-generic-password -U -a "{acct}" -s "{service}" '
               f'-X "{text.encode().hex()}"\n')
        try:
            subprocess.run(["security", "-i"], input=cmd, capture_output=True,
                           text=True, timeout=10)
        except Exception:
            return False
        # `security -i` exits 0 even when the command inside it failed. A login
        # may read back in hex; anything else (a cookie) must match exactly,
        # or an old value left in place would pass for the new one
        got = self.read(service, acct)
        return got == text or (parse(text) is not None and parse(got) == parse(text))

    def delete(self, service, account=None):
        try:
            subprocess.run(["security", "delete-generic-password", "-a",
                            account or self.user, "-s", service],
                           capture_output=True, timeout=10)
        except Exception:
            pass

def write_private(path, text):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = f"{path}.{os.getpid()}.tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.replace(tmp, path)
        return True
    except OSError:
        return False

class FileVault:
    """The vault where there is no keychain: one file only its owner reads."""
    def __init__(self, path=None):
        self.path = path or os.path.expanduser("~/.claude/claude-swap-vault.json")

    def _load(self):
        try:
            with open(self.path) as f:
                return json.load(f)
        except Exception:
            return {}

    def read(self, service, account=None):
        return self._load().get(service, {}).get(account or "")

    def write(self, service, text, account=None):
        d = self._load()
        d.setdefault(service, {})[account or ""] = text
        return write_private(self.path, json.dumps(d))

    def delete(self, service, account=None):
        d = self._load()
        if d.get(service, {}).pop(account or "", None) is not None:
            write_private(self.path, json.dumps(d))

class Live:
    """Claude Code's own credential: its keychain item on macOS, which it reads
    before .credentials.json; the .credentials.json file elsewhere."""
    def __init__(self, secrets, macos):
        self.secrets, self.macos = secrets, macos

    def read(self):
        if self.macos:
            return parse(self.secrets.read(cc_service()))
        try:
            with open(cc_creds()) as f:
                return parse(f.read())
        except OSError:
            return None

    def write(self, o):
        if self.macos:
            return self.secrets.write(cc_service(), dump(o))
        return write_private(cc_creds(), json.dumps({"claudeAiOauth": o}, indent=2))

    def backup(self, o):
        """On macOS, .credentials.json keeps the setup-token underneath, as before."""
        if self.macos:
            write_private(cc_creds(), json.dumps({"claudeAiOauth": o}, indent=2))

def default_io(macos=None):
    macos = (os.uname().sysname == "Darwin") if macos is None else macos
    secrets = Keychain() if macos else FileVault()
    return secrets, Live(secrets, macos), Http()

def disk_account(path=None):
    try:
        with open(path or cc_json()) as f:
            return json.load(f).get("oauthAccount")
    except Exception:
        return None

def edit_config(path, fn, create=False):
    """Change a JSON config of Claude Code's under the lock it takes on it (a
    `<file>.lock` directory), writing it whole and atomically. fn gets the
    contents and returns the new ones, or None to leave the file as it is.
    create: start from {} when there is no file yet. -> bool"""
    path = os.path.realpath(path)
    if not create and not os.path.exists(path):
        return False
    lock, held = path + ".lock", False
    for _ in range(40):
        try:
            os.mkdir(lock)
            held = True
            break
        except FileExistsError:
            try:
                if time.time() - os.stat(lock).st_mtime > 10:  # stale, by its rules
                    os.rmdir(lock)
                    continue
            except OSError:
                pass
            time.sleep(0.1)
        except OSError:
            break
    try:
        try:
            with open(path) as f:
                d = json.load(f)
            mode = os.stat(path).st_mode & 0o777
        except FileNotFoundError:
            if not create:
                return False
            d, mode = {}, 0o600
        new = fn(d)
        if new is None:
            return True
        tmp = f"{path}.{os.getpid()}.tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
        with os.fdopen(fd, "w") as f:
            json.dump(new, f, indent=2)
        os.replace(tmp, path)
        return True
    except Exception:
        return False
    finally:
        if held:
            try:
                os.rmdir(lock)
            except OSError:
                pass

def set_account(account, path=None):
    """Write Claude Code's oauthAccount, or drop it with None."""
    def put(d):
        if d.get("oauthAccount") == account:
            return None
        d = dict(d)
        if account is None:
            d.pop("oauthAccount", None)
        else:
            d["oauthAccount"] = account
        return d
    return edit_config(path or cc_json(), put)

def load_store(path):
    with open(path) as f:
        return json.load(f)

def save_store(path, store):
    write_private(path, json.dumps(store, indent=2))

def commit(path, store, top=("active", "live")):
    """Save the logins of `store` (and its `top` keys) onto the store as it is
    on disk now, so that what another process wrote meanwhile is kept."""
    try:
        fresh = load_store(path)
    except Exception:
        return save_store(path, store)
    mine = {(a.get("email") or "").strip().lower(): a
            for a in store.get("accounts", []) if a.get("email")}
    for a in fresh.get("accounts", []):
        b = mine.get((a.get("email") or "").strip().lower())
        if b is None:
            continue
        if b.get("oauth") is None:
            a.pop("oauth", None)
        else:
            a["oauth"] = b["oauth"]
    for k in top:
        if k in store:
            fresh[k] = store[k]
    save_store(path, fresh)


# ---------- the server ----------

class Dead(Exception):
    """The refresh token was refused for good: the login is gone."""

def refresh(o, http, now):
    """A fresh pair for login o; None if there was no clear answer."""
    st, d = http.call(TOKEN_URL, {
        "grant_type": "refresh_token", "refresh_token": o["refreshToken"],
        "client_id": CLIENT_ID, "scope": " ".join(o.get("scopes") or [])})
    if st == 200 and isinstance(d, dict) and d.get("access_token"):
        n = dict(o)
        n["accessToken"] = d["access_token"]
        n["refreshToken"] = d.get("refresh_token") or o["refreshToken"]
        n["expiresAt"] = int((now + float(d.get("expires_in") or 28800)) * 1000)
        if d.get("refresh_token_expires_in"):
            n["refreshTokenExpiresAt"] = int(
                (now + float(d["refresh_token_expires_in"])) * 1000)
        if d.get("scope"):
            n["scopes"] = d["scope"].split()
        return n
    if isinstance(d, dict) and d.get("error") == "invalid_grant":
        raise Dead(d.get("error_description") or "invalid_grant")
    return None

def profile(at, http):
    st, d = http.call(PROFILE_URL, headers={
        "Authorization": f"Bearer {at}", "anthropic-beta": "oauth-2025-04-20"},
        timeout=15)
    ok = st == 200 and isinstance(d, dict) and isinstance(d.get("account"), dict)
    return d if ok else None

def account_of(p):
    """Claude Code's oauthAccount for a profile reply; it fills in the rest."""
    a, o = p.get("account") or {}, p.get("organization") or {}
    out = {"accountUuid": a.get("uuid"), "emailAddress": a.get("email"),
           "organizationUuid": o.get("uuid")}
    if a.get("display_name"):
        out["displayName"] = a["display_name"]
    if o.get("name"):
        out["organizationName"] = o["name"]
    return out


# ---------- keeping Claude Code and the vault in line ----------

def sync(store, secrets, live, http, now):
    """Save the live login into its account's slot.

    -> (n, what, sure): n is the account it belongs to; what is 'setup'
    (a setup-token or nothing: nothing to keep), 'same', 'saved',
    'unknown' or 'vault-failed'; sure says n came from the login itself
    (fingerprint or the server) rather than from Claude Code's config.
    """
    o = live.read()
    if not is_full(o):
        return None, "setup", False
    accounts = store.get("accounts", [])
    n, sure, account = owner(o, accounts), True, None
    if n is None:
        # Not what claude-swap installed: Claude Code refreshed it, or someone
        # logged in by hand. The server says whose it is.
        disk = disk_account()
        p = profile(o["accessToken"], http)
        if p:
            account = account_of(p)
            if disk and disk.get("accountUuid") == account["accountUuid"]:
                account = disk  # Claude Code's record is the fuller one
            n = by_identity(accounts, account["accountUuid"], account["emailAddress"])
        elif disk:
            # Expired access token, so no answer: Claude Code's config may
            # name it, but only the account installed last is taken on that
            # word. A wrong guess would overwrite another account's login.
            k = by_identity(accounts, disk.get("accountUuid"), disk.get("emailAddress"))
            if k and k == (store.get("live") or {}).get("n"):
                n, sure, account = k, False, disk
        if n is None:
            return None, "unknown", False
    acc = accounts[n - 1]
    m = acc.get("oauth") or {}
    if (m.get("fp") == fp(o["refreshToken"]) and m.get("fp_at") == fp(o["accessToken"])
            and not m.get("dead")):
        return n, "same", sure
    if not secrets.write(VAULT, dump(o), slot(acc)):
        return n, "vault-failed", sure
    note_login(acc, o, now, account or m.get("account"))
    return n, "saved", sure

def vault_login(store, n, secrets, http, now):
    """Account n's saved full login, ready to install: refreshed first when
    about to expire. -> (login or None, note)"""
    acc = store["accounts"][n - 1]
    o, note = None, None
    if usable(acc, now):
        o = parse(secrets.read(VAULT, slot(acc)))
        if o is None:
            note = "its saved login could not be read"
    if o and (o.get("expiresAt") or 0) / 1000 - now < REFRESH_MARGIN:
        try:
            r = refresh(o, http, now)
        except Dead as e:
            acc["oauth"].update(dead=int(now), dead_reason=str(e))
            o, note = None, f"its login was refused ({e}): claude-swap auth {n}"
        else:
            if r:
                # the old refresh token is spent: keep the new pair first
                if secrets.write(VAULT, dump(r), slot(acc)):
                    note_login(acc, r, now)
                o = r
            # no answer: install it as it is, Claude Code refreshes it later
    return o, note

def install(store, n, secrets, live, http, now):
    """Make account n Claude Code's credential: its full login if it holds a
    usable one (refreshed first when about to expire), else its setup-token.

    -> (mode, note): mode 'oauth', 'setup' or 'failed' (Claude Code's
    credential could not be written; nothing changed).
    """
    acc = store["accounts"][n - 1]
    o, note = vault_login(store, n, secrets, http, now)
    if o:
        if live.write(o):
            live.backup(setup_login(acc))
            set_account((acc.get("oauth") or {}).get("account"))
            return "oauth", note
        return "failed", "could not write Claude Code's credential"
    s = setup_login(acc)
    if not live.write(s):
        return "failed", "could not write Claude Code's credential"
    live.backup(s)
    set_account(None)
    return "setup", note

def mark_live(store, n, mode, now, prev):
    store["live"] = {"n": n, "mode": mode, "at": int(now), "from": prev}

def after_sync(n_live, store, now):
    """What to do when the live login is another account's than the active one.

    'reinstall': it is the account just left, written back by a session
    that refreshed it right after the swap. 'adopt': someone logged in by
    hand (/login), which is their pick. None: nothing to do.
    """
    active = store.get("active")
    if not n_live or n_live == active:
        return None
    last = store.get("live") or {}
    if n_live == last.get("from") and now - (last.get("at") or 0) < RACE_WINDOW:
        return "reinstall"
    return "adopt"

def tick(store_path, secrets, live, http, now=None):
    """One pass keeping the vault and Claude Code in line -> [(kind, msg)],
    kind 'log' or 'notify'."""
    now = now or time.time()
    store = load_store(store_path)
    before = json.dumps(store, sort_keys=True)
    accounts, active = store.get("accounts", []), store.get("active", 0)
    ev = run_sync(store, secrets, now)
    lane0 = json.dumps(store.get("lane"), sort_keys=True)
    lane_adopt(store, secrets)
    ev += lane_sync(store, secrets, http, now)[0]
    # the lane's record only when this pass changed it: a move made meanwhile stays
    top = ("active", "live") + (("lane",) if json.dumps(store.get("lane"), sort_keys=True)
                                != lane0 else ())
    if not 1 <= active <= len(accounts):
        if json.dumps(store, sort_keys=True) != before:
            commit(store_path, store, top)
        return ev
    n_live, what, sure = sync(store, secrets, live, http, now)
    if what == "saved":
        ev.append(("log", f"saved #{n_live}'s refreshed login"))
    elif what == "vault-failed":
        ev.append(("log", f"could not save #{n_live}'s login to the vault"))
    elif what == "unknown":
        ev.append(("log", "Claude Code holds a login of no account here, or one "
                          "the server would not name: left alone"))
    act = after_sync(n_live, store, now) if sure else None
    if act == "reinstall":
        mode, note = install(store, active, secrets, live, http, now)
        if mode != "failed":
            mark_live(store, active, mode, now, n_live)
        ev.append(("log", f"#{n_live}'s login was written back over #{active} "
                          f"right after the swap: #{active} installed again"
                          + (f" ({note})" if note else "")))
    elif act == "adopt":
        store["active"] = n_live
        mark_live(store, n_live, "oauth", now, active)
        ev.append(("notify", f"#{n_live} logged in by hand: now the active account"))
    elif what == "setup" and usable(accounts[active - 1], now):
        mode, note = install(store, active, secrets, live, http, now)
        if mode == "oauth":
            mark_live(store, active, mode, now, (store.get("live") or {}).get("from"))
            ev.append(("log", f"#{active}'s full login installed: Claude in Chrome ready"))
        elif note:
            ev.append(("log", f"#{active}: {note}"))
    if json.dumps(store, sort_keys=True) != before:
        commit(store_path, store, top)
    return ev

def due_reminders(accounts, now, warned):
    """(key, message) for logins about to die or refused, once per login."""
    out = []
    for i, a in enumerate(accounts, 1):
        m = a.get("oauth") or {}
        if a.get("disabled") or not m.get("fp"):
            continue
        st, left = login_state(a, now)
        rt = int(m.get("rt_expires") or 0)
        if st == "dead":
            key, msg = f"{i}:{rt}:dead", f"#{i} lost its Claude in Chrome login"
        elif st == "expiring":  # under the first threshold, so one matches
            h = min(h for h in EXPIRY_WARN_H if left <= h * 3600)
            days = left / 86400
            key = f"{i}:{rt}:{h}"
            msg = (f"#{i}'s Claude in Chrome login expires in "
                   + (f"{days:.0f} days" if days >= 1.5 else f"{left / 3600:.0f} h"))
        else:
            continue
        if key not in warned:
            out.append((key, msg + f" — claude-swap auth {i}"))
    return out


# ---------- Chrome profiles ----------

def has_extension(prof, base=CHROME_BASE):
    return os.path.isdir(os.path.join(base, prof, "Extensions", EXT_ID))

def profile_names(base=CHROME_BASE):
    try:
        with open(os.path.join(base, "Local State")) as f:
            info = json.load(f)["profile"]["info_cache"]
        return {k: v.get("name") or k for k, v in info.items()}
    except Exception:
        return {}

_EXT_PUT = re.compile(rb'accountUuid(.{1,12}?)"([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]'
                      rb'{4}-[0-9a-f]{4}-[0-9a-f]{12})"', re.S)
_EXT_DEL = re.compile(rb'\x00\x0baccountUuid')  # a LevelDB deletion record

def extension_account(prof, base=CHROME_BASE):
    """The account uuid the Claude extension of a Chrome profile is signed in
    to, from its storage (LevelDB): the last write of accountUuid wins,
    tables before logs and both oldest first. None: signed out or absent."""
    d = os.path.join(base, prof, "Local Extension Settings", EXT_ID)

    def num(f):
        try:
            return int(os.path.basename(f).split(".")[0])
        except ValueError:
            return -1
    last = None
    files = (sorted(glob.glob(os.path.join(d, "*.ldb")), key=num)
             + sorted(glob.glob(os.path.join(d, "*.log")), key=num))
    for f in files:
        try:
            with open(f, "rb") as fh:
                b = fh.read()
        except OSError:
            continue
        ev = ([(m.start(), m.group(2).decode()) for m in _EXT_PUT.finditer(b)]
              + [(m.start(), None) for m in _EXT_DEL.finditer(b)])
        for _, v in sorted(ev, key=lambda e: e[0]):
            last = v
    return last

def account_uuid(acc):
    return acc.get("uuid") or (acc.get("oauth") or {}).get("uuid")

def chrome_profile_for(uuid, cookie_profiles=(), current=None, base=CHROME_BASE):
    """The Chrome profile Claude in Chrome drives for an account: one whose
    extension is signed in to it (the current pick first, then one also
    logged in to it on claude.ai). With none, the current pick unless its
    extension is someone else's, else the old guess from claude.ai cookies."""
    cookie_profiles = list(cookie_profiles)
    if uuid:
        ext = [p for p in sorted(profile_names(base)) if extension_account(p, base) == uuid]
        for c in [current] + cookie_profiles + ext:
            if c in ext:
                return c
    if current and extension_account(current, base) in (None, uuid):
        return current
    with_ext = [p for p in cookie_profiles if has_extension(p, base)]
    return (with_ext or cookie_profiles or [None])[0]

def login_profile_for(uuid, cookie_profiles, base=CHROME_BASE):
    """Where `auth` opens the authorization page: a profile logged in to the
    account on claude.ai, its Claude in Chrome one if that is among them."""
    for p in cookie_profiles:
        if uuid and extension_account(p, base) == uuid:
            return p
    return cookie_profiles[0] if cookie_profiles else None

def chrome_ready(acc, base=CHROME_BASE):
    """Whether the account's Chrome profile has the extension signed in to it."""
    prof, uuid = acc.get("chrome_profile"), account_uuid(acc)
    return bool(prof and uuid and extension_account(prof, base) == uuid)

def open_profile(prof, url=None):
    subprocess.run(["open", "-na", "Google Chrome", "--args",
                    f"--profile-directory={prof}"] + ([url] if url else []),
                   capture_output=True)

NATIVE_HOSTS = ["Google/Chrome", "BraveSoftware/Brave-Browser", "Arc/User Data",
                "Microsoft Edge", "Chromium", "Vivaldi", "com.operasoftware.Opera"]

def restore_native_hosts(tmpdir):
    """`claude` run on a throwaway CLAUDE_CONFIG_DIR may point the browsers'
    native-messaging manifests into it: point them back."""
    good = os.path.join(cc_dir(), "chrome", "chrome-native-host")
    for b in NATIVE_HOSTS:
        p = os.path.expanduser(f"~/Library/Application Support/{b}/NativeMessagingHosts/"
                               "com.anthropic.claude_code_browser_extension.json")
        try:
            with open(p) as f:
                m = json.load(f)
            if str(m.get("path", "")).startswith(tmpdir):
                m["path"] = good
                with open(p, "w") as f:
                    json.dump(m, f, indent=2)
        except Exception:
            continue


# ---------- a reserved account's own sessions (claude-swap run) ----------
# A reserved account is never the shared login, so its sessions used to run
# on its setup-token (CLAUDE_CODE_OAUTH_TOKEN), which Claude in Chrome turns
# away. Once it holds a full login they get a Claude Code config directory of
# their own instead: their credential is that directory's keychain item,
# which Claude Code refreshes in place for all the account's sessions, and
# nearly everything else is ~/.claude itself, linked, so transcripts, memory,
# settings, plugins and claude-snapshot work as in any other session.
#
# Measured on Claude Code 2.1.288 (6 Nov 2026): transcripts, sessions/<pid>.json
# and the prompt history are written through those links, and a settings
# change made in such a session lands in ~/.claude/settings.json. The Chrome
# bridge takes the room of the account the token in use belongs to.

RUN_BASE = os.environ.get("CLAUDE_SWAP_RUN") or os.path.expanduser("~/.claude-swap/run")
# Each account's own: Claude Code's backups of its config (it restores them),
# its caches of the org's models and policies, its logs, and its background
# daemon and jobs, which sign in with the directory's login. Files are shared
# only when named in RUN_FILES: Claude Code keeps account caches next to them,
# and other tools find their files in ~/.claude by full path.
RUN_OWN = ("backups", "cache", "daemon", "debug", "jobs", "statsig", "telemetry",
           "claude-swap-auth")
RUN_FILES = ("settings.json", "settings.local.json", "CLAUDE.md", "history.jsonl",
             "keybindings.json")
# Claude Code's cleanup deletes some of its directories when they are empty
# (plans, todos...), which would leave a link to nothing: an empty directory
# is linked only if it is one of these, which it keeps. Until then a session
# makes its own, and what it holds moves into ~/.claude once that has one.
RUN_KEEP = ("projects", "sessions", "skills", "agents", "commands", "hooks",
            "output-styles", "plugins", "ide", "chrome")
# copied from ~/.claude.json at each start: preferences, the user's MCP servers
# and what each project allows, nothing about the account
RUN_CONFIG = ("mcpServers", "hasCompletedOnboarding", "lastOnboardingVersion",
              "lastReleaseNotesSeen", "installMethod", "autoUpdates",
              "autoUpdatesProtectedForNative", "verbose", "theme", "editorMode",
              "preferredNotifChannel", "hasIdeOnboardingBeenShown",
              "shiftEnterKeyBindingInstalled", "optionAsMetaKeyInstalled",
              "hasAcknowledgedCostThreshold", "hasCompletedClaudeInChromeOnboarding",
              "claudeInChromeDefaultEnabled", "cachedChromeExtensionInstalled",
              "githubRepoPaths", "deepLinkTerminal", "copyFullResponse",
              "diffSidebarOpen", "showSpinnerTree")
RUN_PROJECT = ("allowedTools", "mcpServers", "enabledMcpServers", "disabledMcpServers",
               "enabledMcpjsonServers", "disabledMcpjsonServers", "mcpContextUris",
               "ignorePatterns")
# a yes given in either place holds in both
RUN_PROJECT_YES = ("hasTrustDialogAccepted", "hasClaudeMdExternalIncludesApproved",
                   "hasClaudeMdExternalIncludesWarningShown")
CHAIN_SLACK = 3600 * 1000  # ms; the refresh tokens of one authorization die together

def run_dir(acc, base=None):
    """Where an account's own sessions keep their config, named by its email."""
    email = (acc.get("email") or "").strip().lower()
    if not email or "/" in email or email.startswith("."):
        return None
    return os.path.realpath(os.path.join(base or RUN_BASE, email))

def run_service(d):
    """Claude Code's keychain item for config dir d (passed as its realpath)."""
    return "Claude Code-credentials-" + config_hash(d)

def run_account(config_dir, accounts, base=None):
    """The account whose own sessions run on config_dir, or None."""
    if not config_dir:
        return None
    d = os.path.realpath(config_dir)
    if os.path.dirname(d) != os.path.realpath(base or RUN_BASE):
        return None
    return by_identity(accounts, None, os.path.basename(d))

def same_chain(o, m):
    """Whether login o comes from the authorization the store records (m):
    a refresh changes the tokens, not when the refresh token dies."""
    rt, mine = o.get("refreshTokenExpiresAt"), m.get("rt_expires")
    return (fp(o.get("refreshToken")) == m.get("fp")
            or bool(rt and mine and abs(rt - mine) < CHAIN_SLACK))

def alive(o, now):
    rt = (o or {}).get("refreshTokenExpiresAt")
    return is_full(o) and (not rt or rt / 1000 > now)

def merge_into(src, dst):
    """Move into directory dst what src holds and dst lacks; -> whether src
    was emptied (and removed)."""
    for e in os.listdir(src):
        a, b = os.path.join(src, e), os.path.join(dst, e)
        if not os.path.lexists(b):
            os.rename(a, b)
        elif os.path.isdir(a) and not os.path.islink(a) and os.path.isdir(b):
            merge_into(a, b)
    try:
        os.rmdir(src)
        return True
    except OSError:
        return False

def link_config(d, home):
    """Have config dir d share ~/.claude (home): a link for each directory but
    an account's own ones, and for each file in RUN_FILES.
    -> the names left alone (a session's own, clashing with home's)."""
    home = os.path.realpath(home)
    os.makedirs(d, mode=0o700, exist_ok=True)
    for name in ("projects", "sessions"):
        try:
            os.makedirs(os.path.join(home, name), exist_ok=True)
        except OSError:
            pass
    want = {}
    for name in os.listdir(home):
        src = os.path.join(home, name)
        if name.startswith(".") or name in RUN_OWN:
            continue  # .credentials.json above all
        if os.path.isdir(src):
            try:
                if name in RUN_KEEP or os.listdir(src):
                    want[name] = src
            except OSError:
                pass
        elif name in RUN_FILES and os.path.isfile(src):
            want[name] = src
    kept = []
    for name, src in sorted(want.items()):
        dst = os.path.join(d, name)
        if os.path.islink(dst):
            if os.readlink(dst) == src:
                continue
            os.unlink(dst)
        elif os.path.isdir(dst) and os.path.isdir(src):
            if not merge_into(dst, src):
                kept.append(name)
                continue
        elif os.path.lexists(dst):
            kept.append(name)
            continue
        os.symlink(src, dst)
    for name in os.listdir(d):  # links to what home no longer has
        p = os.path.join(d, name)
        if (name not in want and os.path.islink(p)
                and os.readlink(p).startswith(home + os.sep)):
            os.unlink(p)
    return kept

def run_config(d, home_json, account):
    """Config dir d's .claude.json: its account's oauthAccount, and from
    ~/.claude.json (home_json) the preferences and what each project allows."""
    try:
        with open(home_json) as f:
            g = json.load(f)
    except Exception:
        g = {}

    def merge(c):
        n = dict(c)
        for k in RUN_CONFIG:
            if k in g:
                n[k] = g[k]
        projects = dict(n.get("projects") or {})
        for path, gp in (g.get("projects") or {}).items():
            if not isinstance(gp, dict):
                continue
            share = {k: gp[k] for k in RUN_PROJECT if k in gp}
            share.update({k: True for k in RUN_PROJECT_YES if gp.get(k)})
            if share:
                projects[path] = {**(projects.get(path) or {}), **share}
        n["projects"] = projects
        if account:
            n["oauthAccount"] = account
        return None if n == c else n
    return edit_config(os.path.join(d, ".claude.json"), merge, create=True)

def run_sync(store, secrets, now, base=None):
    """Save to the vault the logins Claude Code refreshed in the keychain
    items of the reserved accounts' own config dirs (1.14's, before the
    lane), which are read, never written. -> [(kind, msg)]"""
    ev, lane = [], lane_dir(base)
    for i, acc in enumerate(store.get("accounts", []), 1):
        m = acc.get("oauth") or {}
        if not acc.get("reserved") or not m.get("fp"):
            continue
        d = run_dir(acc, base)
        if not d or not os.path.isdir(d) or d == lane:
            continue
        o = parse(secrets.read(run_service(d)))
        if not alive(o, now) or fp(o["refreshToken"]) == m["fp"] or not same_chain(o, m):
            continue
        if secrets.write(VAULT, dump(o), slot(acc)):
            note_login(acc, o, now)
            ev.append(("log", f"saved #{i}'s login, refreshed by its own sessions"))
        else:
            ev.append(("log", f"could not save #{i}'s login to the vault"))
    return ev

# ---------- the reserved accounts' sessions: one lane ----------
# Every session `claude-swap run` opens on a reserved account shares one
# config dir, the lane (RUN_BASE/reserved): its keychain item holds the
# login of the reserved account the lane is on (store["lane"]). Moving the
# lane writes another reserved account's login there, and the open sessions
# follow within 30 s, as the shared login's do: a Team seat at its limit
# hands its sessions to another without restarting them. A reserved
# account's full login is live in one place only, the lane or the vault,
# since a refresh token is single-use.

LANE = "reserved"

def lane_dir(base=None):
    return os.path.realpath(os.path.join(base or RUN_BASE, LANE))

def lane_of(store):
    """The reserved account the lane is on, while it still is one: n or None."""
    n = (store.get("lane") or {}).get("n")
    accounts = store.get("accounts", [])
    if not isinstance(n, int) or not 1 <= n <= len(accounts):
        return None
    a = accounts[n - 1]
    return n if a.get("reserved") and a.get("token") and not a.get("disabled") else None

def lane_owner(o, store, http=None):
    """The reserved account a full login found in the lane belongs to: by its
    fingerprints, or as one the lane's sessions refreshed (the same
    authorization). Two accounts authorized within the hour look alike that
    way: then the server says whose it is, or nobody does. -> n or None"""
    accounts = store.get("accounts", [])
    n = owner(o, accounts)
    if n:
        return n if accounts[n - 1].get("reserved") else None
    near = [i for i, a in enumerate(accounts, 1)
            if a.get("reserved") and (a.get("oauth") or {}).get("fp")
            and same_chain(o, a["oauth"])]
    if len(near) == 1:
        return near[0]
    p = profile(o["accessToken"], http) if near and http else None
    if p:
        account = account_of(p)
        n = by_identity(accounts, account["accountUuid"], account["emailAddress"])
        return n if n in near else None
    return None

def lane_put(store, n, secrets, http, now, base=None):
    """Put the lane on reserved account n: its full login if it holds a
    usable one (refreshed first when about to expire), else its setup-token.
    -> (mode, note): mode 'oauth', 'setup', or 'failed' (nothing changed)."""
    d = lane_dir(base)
    os.makedirs(d, mode=0o700, exist_ok=True)
    acc = store["accounts"][n - 1]
    o, note = vault_login(store, n, secrets, http, now)
    m = acc.get("oauth") or {}
    if not o and not note and m.get("fp"):
        note = (f"its full login {'was refused' if m.get('dead') else 'expired'}:"
                f" claude-swap auth {n}")
    if not secrets.write(run_service(d), dump(o or setup_login(acc))):
        return "failed", "could not write the reserved sessions' credential"
    set_account((acc.get("oauth") or {}).get("account") if o else None,
                os.path.join(d, ".claude.json"))
    rec = store.get("lane") or {}
    store["lane"] = {"n": n, "mode": "oauth" if o else "setup", "at": int(now),
                     "from": rec.get("n") if rec.get("n") != n else rec.get("from")}
    return store["lane"]["mode"], note

def lane_sync(store, secrets, http, now, base=None):
    """Keep the lane's login in line, as the watch does each minute: save to
    the vault what its sessions refreshed, and put the lane's account back
    if a session wrote the one the lane just left over it.
    -> (events, ok): ok False when a refreshed login could not be saved."""
    rec, d = store.get("lane") or {}, lane_dir(base)
    if not rec.get("n") or not os.path.isdir(d):
        return [], True
    o = parse(secrets.read(run_service(d)))
    if not is_full(o):
        return [], True
    n = lane_owner(o, store, http)
    if n is None:
        return [("log", "the reserved sessions hold a login of no reserved account:"
                        " left alone")], True
    acc, ev = store["accounts"][n - 1], []
    m = acc.get("oauth") or {}
    if alive(o, now) and (m.get("fp") != fp(o["refreshToken"])
                          or m.get("fp_at") != fp(o["accessToken"])):
        if not secrets.write(VAULT, dump(o), slot(acc)):
            return [("log", f"could not save #{n}'s login to the vault")], False
        note_login(acc, o, now)
        ev.append(("log", f"saved #{n}'s login, refreshed by the reserved sessions"))
    if n != rec["n"]:
        if n == rec.get("from") and now - (rec.get("at") or 0) < RACE_WINDOW:
            # a session refreshed the account just left and wrote it back
            mode, note = lane_put(store, rec["n"], secrets, http, now, base)
            ev.append(("log", f"#{n}'s login was written back over the reserved sessions'"
                              f" #{rec['n']} right after the move: #{rec['n']} put back"
                              + (f" ({note})" if note else "")))
        else:
            store["lane"] = {"n": n, "mode": "oauth", "at": int(now), "from": rec["n"]}
            ev.append(("notify", f"#{n} logged in by hand in a reserved session:"
                                 " the reserved sessions are on it now"))
    return ev, True

def lane_move(store, n, secrets, http, now, base=None):
    """Move the lane to reserved account n, saving first what its sessions
    refreshed. -> (mode, note, events); mode 'failed': nothing changed."""
    ev, ok = lane_sync(store, secrets, http, now, base)
    if not ok:
        return "failed", "moving now would lose the login in use", ev
    mode, note = lane_put(store, n, secrets, http, now, base)
    return mode, note, ev

def lane_prepare(store, n, secrets, http, now, base=None, home=None, home_json=None):
    """The lane ready for a new session on reserved account n, moved to it
    first if it is on another one (its open sessions move too).
    -> (dir or None, mode, note, moved_from)"""
    d = lane_dir(base)
    ev, ok = lane_sync(store, secrets, http, now, base)
    if not ok:
        return None, "failed", ev[-1][1], None
    acc = store["accounts"][n - 1]
    m, on = acc.get("oauth") or {}, lane_of(store)
    o = parse(secrets.read(run_service(d))) if os.path.isdir(d) else None
    keep = False
    if on == n and o:
        if is_full(o):
            # what its sessions refreshed is the live copy, unless a fresh
            # `claude-swap auth` or a refusal says otherwise
            refused = m.get("dead") and fp(o.get("refreshToken")) == m.get("fp")
            keep = bool(alive(o, now) and m.get("fp") and same_chain(o, m) and not refused)
        else:
            keep = o.get("accessToken") == acc.get("token") and not usable(acc, now)
    if keep:
        mode, note = ("oauth" if is_full(o) else "setup"), None
    else:
        mode, note = lane_put(store, n, secrets, http, now, base)
        if mode == "failed":
            return None, mode, note, None
    link_config(d, home or cc_dir())
    run_config(d, home_json or cc_json(),
               (acc.get("oauth") or {}).get("account") if mode == "oauth" else None)
    return d, mode, note, (on if on and on != n else None)

def lane_adopt(store, secrets, base=None):
    """Up to 1.14 each reserved account's sessions had a config dir of their
    own. With no lane yet and just one such dir, that dir becomes the lane
    (through a link), with its open sessions in it. -> n or None"""
    base = base or RUN_BASE
    path = os.path.join(base, LANE)
    if store.get("lane") or os.path.lexists(path):
        return None
    dirs = [(i, run_dir(a, base)) for i, a in enumerate(store.get("accounts", []), 1)
            if a.get("reserved") and run_dir(a, base) and os.path.isdir(run_dir(a, base))]
    if len(dirs) != 1:
        return None
    i, d = dirs[0]
    os.symlink(os.path.basename(d), path)
    o = parse(secrets.read(run_service(d)))
    if is_full(o):
        n = lane_owner(o, store)
    else:  # a setup-token: whose
        n = next((k for k, a in enumerate(store.get("accounts", []), 1)
                  if o and a.get("reserved") and a.get("token") == o.get("accessToken")), None)
    store["lane"] = {"n": n or i, "mode": "oauth" if is_full(o) else "setup",
                     "at": int(time.time()), "from": None}
    return n or i

def reserved_sessions(base=None):
    """The open sessions of `claude-swap run`: [(pid, name, follows)], follows
    meaning they run on the lane and move with it; the others carry a
    setup-token in their environment, which pins them until restarted."""
    try:
        out = subprocess.run(["ps", "eww", "-axo", "pid=,command="], capture_output=True,
                             text=True, timeout=10).stdout
    except Exception:
        return []
    lane, found = lane_dir(base), []
    for line in out.splitlines():
        pid, _, cmd = line.strip().partition(" ")
        words = cmd.split()
        if not pid.isdigit() or not words or os.path.basename(words[0]) != "claude":
            continue
        env = dict(w.split("=", 1) for w in words[1:] if "=" in w)
        if "CLAUDE_SWAP_PINNED" not in env:
            continue
        cfg = env.get("CLAUDE_CONFIG_DIR")
        try:
            with open(os.path.join(cc_dir(), "sessions", pid + ".json")) as f:
                name = json.load(f).get("name")
        except Exception:
            name = None
        found.append((int(pid), name, bool(cfg) and os.path.realpath(cfg) == lane))
    return found

def lane_summary(store, sessions=None):
    """Where the reserved sessions are, for status: (n, line), or None while
    the lane is on no reserved account."""
    n = lane_of(store)
    if not n:
        return None
    accounts = store.get("accounts", [])
    a = accounts[n - 1]
    if (store.get("lane") or {}).get("mode") == "oauth":
        how = "full login, " + ("Claude in Chrome ready" if chrome_ready(a)
                                else "no Chrome profile has its extension signed in")
    else:
        how = "setup-token, no Claude in Chrome"
    found = reserved_sessions() if sessions is None else sessions
    follow = sum(1 for s in found if s[2])
    pinned = len(found) - follow
    parts = [how, f"{follow} open session{'' if follow == 1 else 's'} on it"
             + (f" ({pinned} more on a token of their own, which do not move)" if pinned else "")]
    want = [e.lower() for e in store.get("lane_rotate") or []]
    rot = [i for i, x in enumerate(accounts, 1)
           if (x.get("email") or "").lower() in want and x.get("reserved")]
    pool = ", ".join(f"#{i}" for i in rot)
    if len(rot) < 2:
        parts.append("the watch does not move them (claude-swap watch reserved <n...>)")
    elif n in rot:
        parts.append(f"the watch moves them among {pool}")
    else:
        parts.append(f"outside the watch's list ({pool}): they stay here until claude-swap <n>")
    return n, f"{n} ({a.get('label', '?')} / {a.get('email') or '-'}) — " + " · ".join(parts)
PYEOF
