# --- Decision engine (general strategy) ---
# Which account to be on, shared by check, auto and watch: each Python block
# runs exec(os.environ["CLAUDE_SWAP_ENGINE"]). Pure — rows in, decision out,
# the clock passed in — so tests/test_engine.py can replay any situation.
read -r -d '' ENGINE_PY <<'PYEOF' || true
# A row: n, label, u5/u7 (% or None), r5/r7 (window resets, epoch or None),
# plan_end (cancellation or downgrade, epoch or None), cancel_at (when a
# cancelled plan stops, epoch or None), free, disabled, error,
# rate_limited, resets (spendable count or None), resets_ends (when they
# lapse, epoch or None), reset_cooldown (epoch or None).
#
# Consume first the quota that is lost first. A week is lost at its renewal,
# or earlier if the plan stops, so that is each account's deadline. Within
# that: quota that dies within a day goes first (now or never), then accounts
# holding a free reset (reaching the limit early is what makes the reset
# worth a whole week), then the rest.

def _leave_setting(default=98):
    """LEAVE override: CLAUDE_SWAP_LEAVE, else ~/.claude/claude-swap-leave.

    100 squeezes the last 2% of every account: it is left only at its hard
    limit or on a 429, at the price of the odd rejected request. Anything
    that is not a number in (0, 100] falls back to the default. Read once
    per process, so a running watch needs a restart to pick a change up."""
    import os
    v = os.environ.get("CLAUDE_SWAP_LEAVE")
    if not v:
        try:
            with open(os.path.expanduser("~/.claude/claude-swap-leave")) as f:
                v = f.read().strip()
        except OSError:
            v = None
    try:
        x = float(v) if v else default
    except ValueError:
        x = default
    if not 0 < x <= 100:  # also rejects nan and inf
        x = default
    return int(x) if x == int(x) else x


LEAVE = _leave_setting()    # leave an account once its 5h or 7d reaches this %
ROOM_5H = 80                # worth switching to: 5h at or below this...
ROOM_7D = 95                # ...and 7d at or below this
LAST_DAY = 24 * 3600        # quota expiring within this goes first
MIN_DWELL = 15 * 60         # no voluntary switch sooner than this after the last
RESET_MIN_LEFT = 24 * 3600  # a week renewing sooner than this refills for free
RESET_RETRY = 6 * 3600      # at most one reset per account in this span
ERROR_RETRY = 300           # probe failed on the active account: look again

INF = float("inf")


def deadline(r, now):
    """When the account's unused quota is lost: weekly renewal or plan end."""
    ends = [t for t in (r.get("r7"), r.get("plan_end")) if t and t > now]
    return min(ends) if ends else INF


def eligible(r):
    return (not (r.get("disabled") or r.get("free") or r.get("error"))
            and r.get("u5") is not None)


def blocked(r):
    return (bool(r.get("rate_limited")) or (r.get("u5") or 0) >= LEAVE
            or (r.get("u7") or 0) >= LEAVE)


def holds_reset(r, now):
    ends = r.get("resets_ends")
    return (r.get("resets") or 0) > 0 and (ends is None or ends > now)


def roomy(r, now):
    # A reset holder needs no 7d room: its reset refills it at the limit.
    return (r.get("u5") or 0) <= ROOM_5H and (
        (r.get("u7") or 0) <= ROOM_7D or holds_reset(r, now))


def load(r):
    return max(r.get("u5") or 0, r.get("u7") or 0)


def tier(r, now):
    if deadline(r, now) - now < LAST_DAY:
        return 0
    return 1 if holds_reset(r, now) else 2


def priority(r, now):
    return (tier(r, now), deadline(r, now))


def rank(rows, now):
    """Eligible accounts in consumption order, blocked ones included."""
    return sorted((r for r in rows if eligible(r)),
                  key=lambda r: (priority(r, now), load(r), r["n"]))


def unblock_at(r):
    """When a blocked account is usable again; None if unknown or never,
    which is the case when its cancelled plan ends first."""
    times = []
    if (r.get("u5") or 0) >= LEAVE:
        times.append(r.get("r5"))
    if (r.get("u7") or 0) >= LEAVE:
        times.append(r.get("r7"))
    if not times or None in times:
        return None
    cancel = r.get("cancel_at")
    if cancel and max(times) >= cancel:
        return None
    return max(times)


def reset_due(r, now, state):
    """Aggressive policy: spend a free reset as soon as the week is spent."""
    if (r.get("u7") or 0) < LEAVE or not holds_reset(r, now):
        return False
    if (r.get("reset_cooldown") or 0) > now:
        return False
    if r["n"] in (state.get("reset_failed") or []):
        return False
    tried = (state.get("reset_tried") or {}).get(str(r["n"]))
    if tried and now - tried < RESET_RETRY:
        return False
    r7 = r.get("r7")
    if r7 and r7 - now < RESET_MIN_LEFT:
        # the week refills for free soon: spend only if the reset lapses first
        ends = r.get("resets_ends")
        return bool(ends and ends <= r7)
    return True


def next_event(rows, now):
    """Soonest instant at which a block lifts or the order can change."""
    times = []
    for r in rows:
        if not eligible(r):
            continue
        d = deadline(r, now)
        times += [r.get("r5"), r.get("r7"), r.get("plan_end"),
                  r.get("reset_cooldown"), d - LAST_DAY if d < INF else None]
    times = [t for t in times if t and t > now]
    return min(times) if times else None


def usage(r):
    if r.get("u5") is None:
        return "no data"
    return f"5h {r['u5']:.0f}% · 7d {(r.get('u7') or 0):.0f}%"


def decide(rows, active, now, state, auto_reset=False):
    """What to do now: stay, switch, spend a reset, or wait at the wall.

    state carries last_switch (epoch), manual (the active account was picked
    by hand), reset_tried ({"n": epoch}) and reset_failed ([n]). Returns
    {"action", "target", "reason", "wake"}; wake is the next instant worth
    looking again, or None.
    """
    def out(action, target, reason, wake=None):
        ev = next_event(rows, now)
        if wake is None or (ev is not None and ev < wake):
            wake = ev
        return {"action": action, "target": target, "reason": reason,
                "wake": wake}

    cur = next((r for r in rows if r["n"] == active), None)
    ranked = rank(rows, now)

    if auto_reset:
        for r in ranked:
            if reset_due(r, now, state):
                return out("reset", r["n"],
                           f"#{r['n']} spent its week ({usage(r)}) and holds a reset")

    if (cur is not None and cur.get("error")
            and not (cur.get("disabled") or cur.get("free"))):
        return out("stay", active, f"#{active} probe failed ({cur['error']})",
                   now + ERROR_RETRY)

    usable = [r for r in ranked if not blocked(r)]
    best = next((r for r in usable if roomy(r, now)), None)

    if cur is None or not eligible(cur) or blocked(cur):
        if cur is None:
            why = "no active account"
        elif not eligible(cur):
            why = f"#{active} is no longer usable"
        else:
            why = f"#{active} at its limit ({usage(cur)})"
        target = best or min(usable, key=lambda r: (load(r), priority(r, now)),
                             default=None)
        if target is None:
            waits = [t for t in (unblock_at(r) for r in ranked) if t and t > now]
            return out("wall", None, why + " and every account is at its limit",
                       min(waits) if waits else None)
        return out("switch", target["n"], why)

    if best and best["n"] != active and priority(best, now) < priority(cur, now):
        ahead = f"#{best['n']} goes first ({usage(best)})"
        if state.get("manual"):
            return out("stay", active, f"#{active} picked by hand; {ahead}")
        last = state.get("last_switch") or 0
        if now - last < MIN_DWELL:
            return out("stay", active, f"{ahead}, after the dwell time",
                       last + MIN_DWELL)
        return out("switch", best["n"], ahead)

    return out("stay", active, f"#{active} goes first")


# --- Plan timeline: what check draws, and when the watch re-reads it ---
# cancel_at is when a cancelled plan stops (the account turns free) and
# down_at when a booked downgrade lands (the account goes on, smaller).

WEEK = 7 * 86400
SUB_TTL = 86400     # a subscription is re-read once a day
SUB_RETRY = 3600    # ...or an hour after a read that failed


def timeline(r, days):
    """One calendar mark per day, days being (start, end) epochs.

    ("end", t) on the day the plan stops and ("gone", None) on every day
    after it; ("down", t) on a downgrade; ("renew", t) on the weekly
    renewal and ("fable", t) on a Fable one on another day, both only if
    they come before the end. A weekly renewal after the end shows as
    ("would_renew", t): it only comes if the plan is renewed. One mark
    per day: end beats downgrade beats renewal beats Fable. None = nothing.
    """
    cancel, r7 = r.get("cancel_at"), r.get("r7")
    events = [("end", cancel), ("down", r.get("down_at"))]
    events += [(kind, t) for kind, t in (("renew", r7), ("fable", r.get("rf")))
               if t and not (cancel and t >= cancel)]
    marks = []
    for start, end in days:
        if cancel and start >= cancel:
            later = r7 and r7 >= cancel and start <= r7 < end
            marks.append(("would_renew", r7) if later else ("gone", None))
            continue
        marks.append(next(((kind, t) for kind, t in events
                           if t and start <= t < end), None))
    return marks


def ending(r, end):
    """What a plan stopping at `end` leaves of the weekly quota.

    left: % of the current week still unused, which the end cuts off when
    it comes before the renewal. Otherwise renews is the last renewal before
    the end and tail the stretch from it to the end; projected says it was
    counted a week at a time from the next one, so it is an estimate.
    """
    out = {"left": None, "renews": None, "tail": None, "projected": False}
    u7, r7 = r.get("u7"), r.get("r7")
    if r7 is None or r7 >= end:
        if u7 is not None:
            out["left"] = max(0, round(100 - u7))
        return out
    weeks = int((end - r7) // WEEK)
    if r7 + weeks * WEEK >= end:
        weeks -= 1
    out.update(renews=r7 + weeks * WEEK, tail=end - (r7 + weeks * WEEK),
               projected=weeks > 0)
    return out


def parse_subscription(s):
    """plan_ends / plan_next as the store keeps them, from subscription_details.

    plan_ending_at is claude.ai's "Your subscription ends on …"; a smaller
    plan booked for later comes as scheduled_downgrade instead.
    """
    s = s or {}
    down = s.get("scheduled_downgrade") or {}
    return {"plan_ends": s.get("plan_ending_at"),
            "plan_next": ({"plan": down.get("plan_type"), "date": down.get("date")}
                          if down.get("plan_type") else None)}


def subs_due(accounts, now, tried):
    """1-based numbers of the accounts whose subscription is worth re-reading.

    Paid plans with a cookie, once a day. A plan past its cached end is read
    too, which is how a resubscription shows up. tried maps "n" to the
    last failed read, retried an hour later.
    """
    due = []
    for n, acc in enumerate(accounts, 1):
        tier = (acc.get("plan") or "").lower()
        if (acc.get("disabled") or not acc.get("session_key")
                or not acc.get("org_id")
                or "free" in tier or tier in ("", "default_claude_ai")):
            continue
        if now - (acc.get("sub_checked") or 0) < SUB_TTL:
            continue
        if now - (tried.get(str(n)) or 0) < SUB_RETRY:
            continue
        due.append(n)
    return due


def needs_billed_probe(free, web_ok, has_windows):
    """Whether check falls back to the billed ratelimit probe (Haiku call).

    Not when the cookie reply brought the windows, and not for a free plan
    that answered without any: Claude Code refuses free plans (403
    permission_error), so the probe would only print that refusal. With no
    working cookie it stays, being the only source, and the way a free
    account that moved to a paid plan gets noticed.
    """
    if web_ok and (has_windows or free):
        return False
    return True
PYEOF
export CLAUDE_SWAP_ENGINE="$ENGINE_PY"

# --- Full logins (Claude in Chrome) ---
# Saving, refreshing and installing each account's full OAuth login, shared
# by the swap, check, auth and the watch: each Python block runs
# exec(os.environ["CLAUDE_SWAP_OAUTH"]). The outside world comes in through
# small objects, so tests/test_oauth.py can replay any situation.
read -r -d '' OAUTH_PY <<'PYEOF' || true
# A setup-token is enough to chat, but Claude in Chrome's bridge turns it
# away (403 "missing scope"): it needs the full login that /login or
# `claude auth login` leaves in Claude Code's credential store. So an account
# can also keep that login in a vault (the macOS keychain, service
# "claude-swap"), and a swap installs it as Claude Code's credential, falling
# back to the setup-token for an account that has none.
#
# How these logins behave (measured on 26 Oct 2026):
# - A refresh token works once. Refreshing hands out a new pair and revokes
#   the previous access token on the spot, so a login never lives in two
#   places at once.
# - Refreshing does not extend the refresh token, which dies ~4 weeks after
#   the browser authorization: then `claude-swap auth <n>` has to be redone.
# - Claude Code refreshes the login in use every ~8 h and writes the new pair
#   back, so its copy is the live one: it is saved to its account's slot
#   before anything overwrites it.
# - Deleting Claude Code's keychain item does not reach running sessions,
#   which keep serving their cached copy: it is always overwritten instead.

import glob, hashlib, json, os, re, subprocess, time, unicodedata
import urllib.request, urllib.error

TOKEN_URL = "https://platform.claude.com/v1/oauth/token"
PROFILE_URL = "https://api.anthropic.com/api/oauth/profile"
CLIENT_ID = "9d1c250a-e61b-44d9-88ed-5944d1962f5e"  # Claude Code's own
# Cloudflare turns urllib's default User-Agent away (error 1010)
UA = "claude-swap (+https://github.com/kokoima/claude-swap)"
VAULT = os.environ.get("CLAUDE_SWAP_VAULT") or "claude-swap"
# What claude-swap has always written next to a setup-token: Claude Code
# wants these scopes to start, although the token only carries inference.
SETUP_SCOPES = ["user:file_upload", "user:inference", "user:mcp_servers",
                "user:profile", "user:sessions:claude_code"]
REFRESH_MARGIN = 600       # an access token with less left is refreshed first
RACE_WINDOW = 900          # see after_sync()
EXPIRY_WARN_H = (120, 24)  # remind this many hours before a login dies
EXT_ID = "fcoeoabgfenejglbffodgkkbkcdhcgfn"  # the Claude in Chrome extension
CHROME_BASE = os.path.expanduser("~/Library/Application Support/Google/Chrome")


# ---------- where Claude Code keeps things (CLAUDE_CONFIG_DIR as it does) ----------

def config_hash(d):
    return hashlib.sha256(unicodedata.normalize("NFC", d).encode()).hexdigest()[:8]

def cc_dir():
    return os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")

def cc_service():
    """Claude Code's keychain item, suffixed when CLAUDE_CONFIG_DIR is set."""
    d = os.environ.get("CLAUDE_CONFIG_DIR")
    return "Claude Code-credentials" + (f"-{config_hash(d)}" if d else "")

def cc_json():
    d = os.environ.get("CLAUDE_CONFIG_DIR")
    return os.path.join(d, ".claude.json") if d else os.path.expanduser("~/.claude.json")

def cc_creds():
    return os.path.join(cc_dir(), ".credentials.json")


# ---------- logins ----------

def parse(text):
    """The claudeAiOauth object of a stored credential (JSON, or the hex
    `security` prints for it), or None."""
    if not text:
        return None
    try:
        d = json.loads(text)
    except ValueError:
        try:
            d = json.loads(bytes.fromhex(text.strip()).decode())
        except Exception:
            return None
    o = d.get("claudeAiOauth") if isinstance(d, dict) else None
    return o if isinstance(o, dict) and o.get("accessToken") else None

def dump(o):
    return json.dumps({"claudeAiOauth": o})

def is_full(o):
    """A full login carries a refresh token; a setup-token never does."""
    return bool(o and o.get("refreshToken"))

def fp(tok):
    return hashlib.sha256(tok.encode()).hexdigest()[:12] if tok else None

def slot(acc):
    """An account's vault entry, by email so that removing one shifts none."""
    return "oauth:" + (acc.get("email") or "").strip().lower()

def setup_login(acc):
    return {"accessToken": acc["token"], "refreshToken": "",
            "expiresAt": acc.get("expires", 0), "scopes": SETUP_SCOPES,
            "subscriptionType": "max", "rateLimitTier": "default_claude_max_20x"}

def note_login(acc, o, now, account=None):
    """Record in the store what a saved login is, never its tokens."""
    m = {k: v for k, v in (acc.get("oauth") or {}).items()
         if k not in ("dead", "dead_reason")}
    m.update({"fp": fp(o.get("refreshToken")), "fp_at": fp(o.get("accessToken")),
              "expires": o.get("expiresAt"),
              "rt_expires": o.get("refreshTokenExpiresAt"), "saved": int(now)})
    if account:
        m["account"] = account
        m["uuid"] = account.get("accountUuid")
    acc["oauth"] = m

def usable(acc, now):
    """Whether the account holds a login that can still be installed."""
    m = acc.get("oauth") or {}
    if not m.get("fp") or m.get("dead"):
        return False
    rt = m.get("rt_expires")
    return not rt or rt / 1000 > now

def login_state(acc, now):
    """('ok' | 'expiring' | 'dead' | 'none', seconds left or None)."""
    m = acc.get("oauth") or {}
    if not m.get("fp"):
        return "none", None
    rt = m.get("rt_expires")
    left = rt / 1000 - now if rt else None
    if m.get("dead") or (left is not None and left <= 0):
        return "dead", left
    if left is not None and left < EXPIRY_WARN_H[0] * 3600:
        return "expiring", left
    return "ok", left

def owner(o, accounts):
    """The account a login belongs to, from the fingerprints the store keeps."""
    rt, at = fp(o.get("refreshToken")), fp(o.get("accessToken"))
    for i, a in enumerate(accounts, 1):
        m = a.get("oauth") or {}
        if (rt and m.get("fp") == rt) or (at and m.get("fp_at") == at):
            return i
    return None

def by_identity(accounts, uuid=None, email=None):
    if uuid:
        for i, a in enumerate(accounts, 1):
            if (a.get("oauth") or {}).get("uuid") == uuid:
                return i
    if email:
        for i, a in enumerate(accounts, 1):
            if (a.get("email") or "").strip().lower() == email.strip().lower():
                return i
    return None


# ---------- the outside world ----------

class Http:
    """JSON over HTTPS -> (status, body or None); status 0 = no answer."""
    def call(self, url, body=None, headers=None, timeout=20):
        h = {"User-Agent": UA, "Accept": "application/json", **(headers or {})}
        data = None
        if body is not None:
            data = json.dumps(body).encode()
            h["Content-Type"] = "application/json"
        try:
            req = urllib.request.Request(url, data=data, headers=h)
            with urllib.request.urlopen(req, timeout=timeout) as r:
                return r.status, json.load(r)
        except urllib.error.HTTPError as e:
            try:
                return e.code, json.loads(e.read())
            except Exception:
                return e.code, None
        except Exception:
            return 0, None

class Keychain:
    """macOS generic passwords, written the way Claude Code writes its own:
    the secret travels on stdin (`security -i`), never on a command line."""
    def __init__(self, user=None):
        self.user = user or os.environ.get("USER") or ""

    def read(self, service, account=None):
        try:
            r = subprocess.run(["security", "find-generic-password", "-a",
                                account or self.user, "-s", service, "-w"],
                               capture_output=True, text=True, timeout=10)
        except Exception:
            return None
        return r.stdout.strip() if r.returncode == 0 else None

    def write(self, service, text, account=None):
        acct = account or self.user
        if any(c in s for s in (acct, service) for c in '"\n'):
            return False
        cmd = (f'add-generic-password -U -a "{acct}" -s "{service}" '
               f'-X "{text.encode().hex()}"\n')
        try:
            subprocess.run(["security", "-i"], input=cmd, capture_output=True,
                           text=True, timeout=10)
        except Exception:
            return False
        # `security -i` exits 0 even when the command inside it failed
        got = self.read(service, acct)
        return got == text or (got is not None and parse(got) == parse(text))

    def delete(self, service, account=None):
        try:
            subprocess.run(["security", "delete-generic-password", "-a",
                            account or self.user, "-s", service],
                           capture_output=True, timeout=10)
        except Exception:
            pass

def write_private(path, text):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = f"{path}.{os.getpid()}.tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.replace(tmp, path)
        return True
    except OSError:
        return False

class FileVault:
    """The vault where there is no keychain: one file only its owner reads."""
    def __init__(self, path=None):
        self.path = path or os.path.expanduser("~/.claude/claude-swap-vault.json")

    def _load(self):
        try:
            with open(self.path) as f:
                return json.load(f)
        except Exception:
            return {}

    def read(self, service, account=None):
        return self._load().get(service, {}).get(account or "")

    def write(self, service, text, account=None):
        d = self._load()
        d.setdefault(service, {})[account or ""] = text
        return write_private(self.path, json.dumps(d))

    def delete(self, service, account=None):
        d = self._load()
        if d.get(service, {}).pop(account or "", None) is not None:
            write_private(self.path, json.dumps(d))

class Live:
    """Claude Code's own credential: its keychain item on macOS, which it reads
    before .credentials.json; the .credentials.json file elsewhere."""
    def __init__(self, secrets, macos):
        self.secrets, self.macos = secrets, macos

    def read(self):
        if self.macos:
            return parse(self.secrets.read(cc_service()))
        try:
            with open(cc_creds()) as f:
                return parse(f.read())
        except OSError:
            return None

    def write(self, o):
        if self.macos:
            return self.secrets.write(cc_service(), dump(o))
        return write_private(cc_creds(), json.dumps({"claudeAiOauth": o}, indent=2))

    def backup(self, o):
        """On macOS, .credentials.json keeps the setup-token underneath, as before."""
        if self.macos:
            write_private(cc_creds(), json.dumps({"claudeAiOauth": o}, indent=2))

def default_io(macos=None):
    macos = (os.uname().sysname == "Darwin") if macos is None else macos
    secrets = Keychain() if macos else FileVault()
    return secrets, Live(secrets, macos), Http()

def disk_account(path=None):
    try:
        with open(path or cc_json()) as f:
            return json.load(f).get("oauthAccount")
    except Exception:
        return None

def set_account(account, path=None):
    """Write Claude Code's oauthAccount, or drop it with None, under the lock
    Claude Code takes on that file (a `<file>.lock` directory)."""
    path = os.path.realpath(path or cc_json())
    if not os.path.exists(path):
        return False
    lock, held = path + ".lock", False
    for _ in range(40):
        try:
            os.mkdir(lock)
            held = True
            break
        except FileExistsError:
            try:
                if time.time() - os.stat(lock).st_mtime > 10:  # stale, by its rules
                    os.rmdir(lock)
                    continue
            except OSError:
                pass
            time.sleep(0.1)
        except OSError:
            break
    try:
        with open(path) as f:
            d = json.load(f)
        if d.get("oauthAccount") == account:
            return True
        if account is None:
            d.pop("oauthAccount", None)
        else:
            d["oauthAccount"] = account
        tmp = f"{path}.{os.getpid()}.tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC,
                     os.stat(path).st_mode & 0o777)
        with os.fdopen(fd, "w") as f:
            json.dump(d, f, indent=2)
        os.replace(tmp, path)
        return True
    except Exception:
        return False
    finally:
        if held:
            try:
                os.rmdir(lock)
            except OSError:
                pass

def load_store(path):
    with open(path) as f:
        return json.load(f)

def save_store(path, store):
    write_private(path, json.dumps(store, indent=2))

def commit(path, store, top=("active", "live")):
    """Save the logins of `store` (and its `top` keys) onto the store as it is
    on disk now, so that what another process wrote meanwhile is kept."""
    try:
        fresh = load_store(path)
    except Exception:
        return save_store(path, store)
    mine = {(a.get("email") or "").strip().lower(): a
            for a in store.get("accounts", []) if a.get("email")}
    for a in fresh.get("accounts", []):
        b = mine.get((a.get("email") or "").strip().lower())
        if b is None:
            continue
        if b.get("oauth") is None:
            a.pop("oauth", None)
        else:
            a["oauth"] = b["oauth"]
    for k in top:
        if k in store:
            fresh[k] = store[k]
    save_store(path, fresh)


# ---------- the server ----------

class Dead(Exception):
    """The refresh token was refused for good: the login is gone."""

def refresh(o, http, now):
    """A fresh pair for login o; None if there was no clear answer."""
    st, d = http.call(TOKEN_URL, {
        "grant_type": "refresh_token", "refresh_token": o["refreshToken"],
        "client_id": CLIENT_ID, "scope": " ".join(o.get("scopes") or [])})
    if st == 200 and isinstance(d, dict) and d.get("access_token"):
        n = dict(o)
        n["accessToken"] = d["access_token"]
        n["refreshToken"] = d.get("refresh_token") or o["refreshToken"]
        n["expiresAt"] = int((now + float(d.get("expires_in") or 28800)) * 1000)
        if d.get("refresh_token_expires_in"):
            n["refreshTokenExpiresAt"] = int(
                (now + float(d["refresh_token_expires_in"])) * 1000)
        if d.get("scope"):
            n["scopes"] = d["scope"].split()
        return n
    if isinstance(d, dict) and d.get("error") == "invalid_grant":
        raise Dead(d.get("error_description") or "invalid_grant")
    return None

def profile(at, http):
    st, d = http.call(PROFILE_URL, headers={
        "Authorization": f"Bearer {at}", "anthropic-beta": "oauth-2025-04-20"},
        timeout=15)
    ok = st == 200 and isinstance(d, dict) and isinstance(d.get("account"), dict)
    return d if ok else None

def account_of(p):
    """Claude Code's oauthAccount for a profile reply; it fills in the rest."""
    a, o = p.get("account") or {}, p.get("organization") or {}
    out = {"accountUuid": a.get("uuid"), "emailAddress": a.get("email"),
           "organizationUuid": o.get("uuid")}
    if a.get("display_name"):
        out["displayName"] = a["display_name"]
    if o.get("name"):
        out["organizationName"] = o["name"]
    return out


# ---------- keeping Claude Code and the vault in line ----------

def sync(store, secrets, live, http, now):
    """Save the live login into its account's slot.

    -> (n, what, sure): n is the account it belongs to; what is 'setup'
    (a setup-token or nothing: nothing to keep), 'same', 'saved',
    'unknown' or 'vault-failed'; sure says n came from the login itself
    (fingerprint or the server) rather than from Claude Code's config.
    """
    o = live.read()
    if not is_full(o):
        return None, "setup", False
    accounts = store.get("accounts", [])
    n, sure, account = owner(o, accounts), True, None
    if n is None:
        # Not what claude-swap installed: Claude Code refreshed it, or someone
        # logged in by hand. The server says whose it is.
        disk = disk_account()
        p = profile(o["accessToken"], http)
        if p:
            account = account_of(p)
            if disk and disk.get("accountUuid") == account["accountUuid"]:
                account = disk  # Claude Code's record is the fuller one
            n = by_identity(accounts, account["accountUuid"], account["emailAddress"])
        elif disk:
            # Expired access token, so no answer: Claude Code's config may
            # name it, but only the account installed last is taken on that
            # word. A wrong guess would overwrite another account's login.
            k = by_identity(accounts, disk.get("accountUuid"), disk.get("emailAddress"))
            if k and k == (store.get("live") or {}).get("n"):
                n, sure, account = k, False, disk
        if n is None:
            return None, "unknown", False
    acc = accounts[n - 1]
    m = acc.get("oauth") or {}
    if (m.get("fp") == fp(o["refreshToken"]) and m.get("fp_at") == fp(o["accessToken"])
            and not m.get("dead")):
        return n, "same", sure
    if not secrets.write(VAULT, dump(o), slot(acc)):
        return n, "vault-failed", sure
    note_login(acc, o, now, account or m.get("account"))
    return n, "saved", sure

def install(store, n, secrets, live, http, now):
    """Make account n Claude Code's credential: its full login if it holds a
    usable one (refreshed first when about to expire), else its setup-token.

    -> (mode, note): mode 'oauth', 'setup' or 'failed' (Claude Code's
    credential could not be written; nothing changed).
    """
    acc = store["accounts"][n - 1]
    o, note = None, None
    if usable(acc, now):
        o = parse(secrets.read(VAULT, slot(acc)))
        if o is None:
            note = "its saved login could not be read"
    if o and (o.get("expiresAt") or 0) / 1000 - now < REFRESH_MARGIN:
        try:
            r = refresh(o, http, now)
        except Dead as e:
            acc["oauth"].update(dead=int(now), dead_reason=str(e))
            o, note = None, f"its login was refused ({e}): claude-swap auth {n}"
        else:
            if r:
                # the old refresh token is spent: keep the new pair first
                if secrets.write(VAULT, dump(r), slot(acc)):
                    note_login(acc, r, now)
                o = r
            # no answer: install it as it is, Claude Code refreshes it later
    if o:
        if live.write(o):
            live.backup(setup_login(acc))
            set_account((acc.get("oauth") or {}).get("account"))
            return "oauth", note
        return "failed", "could not write Claude Code's credential"
    s = setup_login(acc)
    if not live.write(s):
        return "failed", "could not write Claude Code's credential"
    live.backup(s)
    set_account(None)
    return "setup", note

def mark_live(store, n, mode, now, prev):
    store["live"] = {"n": n, "mode": mode, "at": int(now), "from": prev}

def after_sync(n_live, store, now):
    """What to do when the live login is another account's than the active one.

    'reinstall': it is the account just left, written back by a session
    that refreshed it right after the swap. 'adopt': someone logged in by
    hand (/login), which is their pick. None: nothing to do.
    """
    active = store.get("active")
    if not n_live or n_live == active:
        return None
    last = store.get("live") or {}
    if n_live == last.get("from") and now - (last.get("at") or 0) < RACE_WINDOW:
        return "reinstall"
    return "adopt"

def tick(store_path, secrets, live, http, now=None):
    """One pass keeping the vault and Claude Code in line -> [(kind, msg)],
    kind 'log' or 'notify'."""
    now = now or time.time()
    store = load_store(store_path)
    before = json.dumps(store, sort_keys=True)
    accounts, active = store.get("accounts", []), store.get("active", 0)
    if not 1 <= active <= len(accounts):
        return []
    ev = []
    n_live, what, sure = sync(store, secrets, live, http, now)
    if what == "saved":
        ev.append(("log", f"saved #{n_live}'s refreshed login"))
    elif what == "vault-failed":
        ev.append(("log", f"could not save #{n_live}'s login to the vault"))
    elif what == "unknown":
        ev.append(("log", "Claude Code holds a login of no account here, or one "
                          "the server would not name: left alone"))
    act = after_sync(n_live, store, now) if sure else None
    if act == "reinstall":
        mode, note = install(store, active, secrets, live, http, now)
        if mode != "failed":
            mark_live(store, active, mode, now, n_live)
        ev.append(("log", f"#{n_live}'s login was written back over #{active} "
                          f"right after the swap: #{active} installed again"
                          + (f" ({note})" if note else "")))
    elif act == "adopt":
        store["active"] = n_live
        mark_live(store, n_live, "oauth", now, active)
        ev.append(("notify", f"#{n_live} logged in by hand: now the active account"))
    elif what == "setup" and usable(accounts[active - 1], now):
        mode, note = install(store, active, secrets, live, http, now)
        if mode == "oauth":
            mark_live(store, active, mode, now, (store.get("live") or {}).get("from"))
            ev.append(("log", f"#{active}'s full login installed: Claude in Chrome ready"))
        elif note:
            ev.append(("log", f"#{active}: {note}"))
    if json.dumps(store, sort_keys=True) != before:
        commit(store_path, store)
    return ev

def due_reminders(accounts, now, warned):
    """(key, message) for logins about to die or refused, once per login."""
    out = []
    for i, a in enumerate(accounts, 1):
        m = a.get("oauth") or {}
        if a.get("disabled") or not m.get("fp"):
            continue
        st, left = login_state(a, now)
        rt = int(m.get("rt_expires") or 0)
        if st == "dead":
            key, msg = f"{i}:{rt}:dead", f"#{i} lost its Claude in Chrome login"
        elif st == "expiring":  # under the first threshold, so one matches
            h = min(h for h in EXPIRY_WARN_H if left <= h * 3600)
            days = left / 86400
            key = f"{i}:{rt}:{h}"
            msg = (f"#{i}'s Claude in Chrome login expires in "
                   + (f"{days:.0f} days" if days >= 1.5 else f"{left / 3600:.0f} h"))
        else:
            continue
        if key not in warned:
            out.append((key, msg + f" — claude-swap auth {i}"))
    return out


# ---------- Chrome profiles ----------

def has_extension(prof, base=CHROME_BASE):
    return os.path.isdir(os.path.join(base, prof, "Extensions", EXT_ID))

def profile_names(base=CHROME_BASE):
    try:
        with open(os.path.join(base, "Local State")) as f:
            info = json.load(f)["profile"]["info_cache"]
        return {k: v.get("name") or k for k, v in info.items()}
    except Exception:
        return {}

_EXT_PUT = re.compile(rb'accountUuid(.{1,12}?)"([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]'
                      rb'{4}-[0-9a-f]{4}-[0-9a-f]{12})"', re.S)
_EXT_DEL = re.compile(rb'\x00\x0baccountUuid')  # a LevelDB deletion record

def extension_account(prof, base=CHROME_BASE):
    """The account uuid the Claude extension of a Chrome profile is signed in
    to, from its storage (LevelDB): the last write of accountUuid wins,
    tables before logs and both oldest first. None: signed out or absent."""
    d = os.path.join(base, prof, "Local Extension Settings", EXT_ID)

    def num(f):
        try:
            return int(os.path.basename(f).split(".")[0])
        except ValueError:
            return -1
    last = None
    files = (sorted(glob.glob(os.path.join(d, "*.ldb")), key=num)
             + sorted(glob.glob(os.path.join(d, "*.log")), key=num))
    for f in files:
        try:
            with open(f, "rb") as fh:
                b = fh.read()
        except OSError:
            continue
        ev = ([(m.start(), m.group(2).decode()) for m in _EXT_PUT.finditer(b)]
              + [(m.start(), None) for m in _EXT_DEL.finditer(b)])
        for _, v in sorted(ev, key=lambda e: e[0]):
            last = v
    return last

def account_uuid(acc):
    return acc.get("uuid") or (acc.get("oauth") or {}).get("uuid")

def chrome_profile_for(uuid, cookie_profiles=(), current=None, base=CHROME_BASE):
    """The Chrome profile Claude in Chrome drives for an account: one whose
    extension is signed in to it (the current pick first, then one also
    logged in to it on claude.ai). With none, the current pick unless its
    extension is someone else's, else the old guess from claude.ai cookies."""
    cookie_profiles = list(cookie_profiles)
    if uuid:
        ext = [p for p in sorted(profile_names(base)) if extension_account(p, base) == uuid]
        for c in [current] + cookie_profiles + ext:
            if c in ext:
                return c
    if current and extension_account(current, base) in (None, uuid):
        return current
    with_ext = [p for p in cookie_profiles if has_extension(p, base)]
    return (with_ext or cookie_profiles or [None])[0]

def login_profile_for(uuid, cookie_profiles, base=CHROME_BASE):
    """Where `auth` opens the authorization page: a profile logged in to the
    account on claude.ai, its Claude in Chrome one if that is among them."""
    for p in cookie_profiles:
        if uuid and extension_account(p, base) == uuid:
            return p
    return cookie_profiles[0] if cookie_profiles else None

def chrome_ready(acc, base=CHROME_BASE):
    """Whether the account's Chrome profile has the extension signed in to it."""
    prof, uuid = acc.get("chrome_profile"), account_uuid(acc)
    return bool(prof and uuid and extension_account(prof, base) == uuid)

def open_profile(prof, url=None):
    subprocess.run(["open", "-na", "Google Chrome", "--args",
                    f"--profile-directory={prof}"] + ([url] if url else []),
                   capture_output=True)

NATIVE_HOSTS = ["Google/Chrome", "BraveSoftware/Brave-Browser", "Arc/User Data",
                "Microsoft Edge", "Chromium", "Vivaldi", "com.operasoftware.Opera"]

def restore_native_hosts(tmpdir):
    """`claude` run on a throwaway CLAUDE_CONFIG_DIR may point the browsers'
    native-messaging manifests into it: point them back."""
    good = os.path.join(cc_dir(), "chrome", "chrome-native-host")
    for b in NATIVE_HOSTS:
        p = os.path.expanduser(f"~/Library/Application Support/{b}/NativeMessagingHosts/"
                               "com.anthropic.claude_code_browser_extension.json")
        try:
            with open(p) as f:
                m = json.load(f)
            if str(m.get("path", "")).startswith(tmpdir):
                m["path"] = good
                with open(p, "w") as f:
                    json.dump(m, f, indent=2)
        except Exception:
            continue
