cmd_init() {
  if [ -f "$STORE" ]; then
    echo "Store already exists at $STORE"
    echo "Use 'claude-swap add' to add more accounts."
    return
  fi

  echo "claude-swap — Multi-account manager for Claude Code"
  echo ""

  mkdir -p "$(dirname "$STORE")"
  echo '{"version":1,"active":0,"accounts":[]}' > "$STORE"
  chmod 600 "$STORE"

  echo "To add an account, you need a setup token (lasts 1 year):"
  echo "  1. Open a new terminal"
  echo "  2. Log in with the account:  claude login"
  echo "  3. Generate a token:         claude setup-token"
  echo "  4. Come back here and paste it"
  echo ""

  while true; do
    _add_account_interactive
    echo ""
    read -r -p "Add another account? (y/n) " more
    case "$more" in
      [yY]*) echo "" ;;
      *) break ;;
    esac
  done

  # Set first account as active if we have any
  local count
  count=$(python3 -c "import json; print(len(json.load(open('$STORE'))['accounts']))")
  if [ "$count" -gt 0 ]; then
    python3 -c "
import json
with open('$STORE') as f:
    d = json.load(f)
d['active'] = 1
with open('$STORE', 'w') as f:
    json.dump(d, f, indent=2)
"
    echo ""
    echo "Account 1 set as active."
    _do_rotate 1

    # --- Onboarding: sessionKeys (Fable % / plan columns) ---
    echo ""
    echo "Optional: the Fable % and Plan columns need each account's claude.ai"
    echo "sessionKey cookie (from a logged-in claude.ai browser session)."
    if python3 -c "import browser_cookie3" 2>/dev/null; then
      read -r -p "Scan Chrome profiles for logged-in claude.ai sessions now? (y/n) " sync
      case "$sync" in
        [yY]*) echo ""; cmd_keys_sync ;;
        *) echo "You can do it later with: claude-swap keys-sync" ;;
      esac
    else
      echo ""
      echo "  Automatic import needs browser_cookie3:"
      echo "    pip3 install --user browser_cookie3 && claude-swap keys-sync"
      echo "  Or paste a key manually per account: claude-swap key <n>"
    fi

    # --- Onboarding: watcher ---
    echo ""
    read -r -p "Start the auto-switcher? It switches at 98% of 5h or 7d, spending first what expires first (y/n) " w
    case "$w" in
      [yY]*) cmd_watch_start general ;;
      *) echo "You can start it later with: claude-swap watch start" ;;
    esac

    echo ""
    echo "All set. Run 'claude-swap check' to see the dashboard."
  fi
}

cmd_status() {
  check_store
  python3 - "$STORE" "$CLAUDE_CREDS" "$CLAUDE_JSON" "$IS_MACOS" "$VERSION" <<'PYEOF'
import json, hashlib, time, os, sys, subprocess, binascii
from datetime import datetime

store_path = sys.argv[1]
creds_path = sys.argv[2]
claude_json_path = sys.argv[3]
is_macos = sys.argv[4] == "true"
version = sys.argv[5]

with open(store_path) as f:
    store = json.load(f)

accounts = store.get("accounts", [])
active = store.get("active", 0)
now_ms = int(time.time() * 1000)

def fingerprint(token):
    return hashlib.sha256(token.encode()).hexdigest()[:12]

def match_token(token):
    fp = fingerprint(token)
    for i, acc in enumerate(accounts):
        if acc.get("token") and fingerprint(acc["token"]) == fp:
            return i + 1, fp
    return None, fp

print(f"claude-swap v{version}")
print()

if not accounts:
    print("No accounts configured. Run 'claude-swap add' to add one.")
    sys.exit(0)

if 1 <= active <= len(accounts):
    acc = accounts[active - 1]
    print(f"Active: {active} ({acc.get('label', '?')} / {acc.get('email') or '-'})")
else:
    print(f"Active: none")

# Watcher
wpid_path = os.path.expanduser("~/.claude/claude-swap-watch.pid")
wstate_path = os.path.expanduser("~/.claude/claude-swap-watch.state")
wpid, walive = None, False
try:
    wpid = int(open(wpid_path).read().strip())
    os.kill(wpid, 0)
    walive = True
except Exception:
    pass
try:
    ws = json.load(open(wstate_path))
except Exception:
    ws = {}
if walive:
    extra = " + auto-reset" if ws.get("auto_reset") else ""
    parts = [f"RUNNING ({ws.get('strategy', '?')}{extra}, PID {wpid})"]
    if ws.get("active"):
        parts.append(f"watching #{ws['active']}"
                     + (" (picked by hand)" if ws.get("manual") else ""))
    if ws.get("last"):
        parts.append(f"last probe {ws.get('last_time', '?')}: {ws['last']}")
    print("Watch:  " + " — ".join(parts))
elif wpid is not None:
    print(f"Watch:  stale pidfile (PID {wpid} dead) — clean up with 'claude-swap watch stop'")
else:
    print("Watch:  not running")
print()

# Keychain check (macOS only)
if is_macos:
    try:
        out = subprocess.run(
            ["security", "find-generic-password", "-s", "Claude Code-credentials", "-w"],
            capture_output=True, text=True, check=True
        )
        raw = out.stdout.strip()
        if raw:
            try:
                kd = json.loads(raw)
            except json.JSONDecodeError:
                kd = json.loads(binascii.unhexlify(raw).decode("utf-8"))
            ko = kd.get("claudeAiOauth", {})
            ktoken = ko.get("accessToken", "")
            has_refresh = bool(ko.get("refreshToken"))
            kmatch, kfp = match_token(ktoken)
            kind = "OAuth" if has_refresh else "setup-token"
            label = f"account {kmatch}" if kmatch else "UNKNOWN"
            print(f"  Keychain: {kfp} ({label}, {kind}) ** HAS PRIORITY **")
        else:
            print(f"  Keychain: empty (OK)")
    except subprocess.CalledProcessError:
        print(f"  Keychain: not found (OK)")

# .credentials.json check
try:
    with open(creds_path) as f:
        d = json.load(f)
    o = d["claudeAiOauth"]
    cmatch, cfp = match_token(o["accessToken"])
    label = f"account {cmatch}" if cmatch else "UNKNOWN"
    print(f"  .credentials.json: {cfp} ({label})")
except FileNotFoundError:
    print(f"  .credentials.json: not found")
except Exception as e:
    print(f"  .credentials.json: error ({e})")

print()

# Account list
print(f"  #  {'Label':<20} {'Email':<30} Expires")
for i, acc in enumerate(accounts):
    n = i + 1
    marker = "*" if n == active else " "
    label = acc.get("label", "")[:20]
    email = (acc.get("email") or "-")[:30]
    exp_ms = acc.get("expires", 0)
    if exp_ms > now_ms:
        exp_dt = datetime.fromtimestamp(exp_ms / 1000).strftime("%Y-%m-%d")
    else:
        exp_dt = "EXPIRED"
    print(f"  {marker}{n}  {label:<20} {email:<30} {exp_dt}")
PYEOF
}

