.wacts{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-left:auto}
.check{display:inline-flex;align-items:center;gap:6px;font-size:13px}
pre{margin:0;font:12px/1.5 var(--f-mono);white-space:pre-wrap;overflow-wrap:anywhere}
.wlines{margin-top:12px;padding:10px 12px;border-radius:9px;background:var(--inset)}
.log{margin-top:10px;max-height:320px;overflow:auto;padding:10px 12px;border-radius:9px;background:var(--inset);
  border:1px solid var(--rule)}
.sub-h{margin:14px 0 0;font:700 14px/1 var(--f-display);letter-spacing:.06em;text-transform:uppercase;color:var(--ink2)}

footer{max-width:1320px;margin:0 auto;padding:0 var(--gutter) max(28px,env(safe-area-inset-bottom));
  font-size:12px;color:var(--ink3)}

/* the dialog: every action asks first */
dialog{width:min(560px,calc(100vw - 24px));max-height:calc(100vh - 24px);max-height:calc(100dvh - 24px);padding:0;border:1px solid var(--rule);
  border-radius:14px;background:var(--panel);color:var(--ink);box-shadow:0 20px 50px rgba(0,0,0,.3)}
dialog::backdrop{background:rgba(10,14,18,.5);backdrop-filter:blur(2px);-webkit-backdrop-filter:blur(2px)}
.dlg{padding:18px 18px 16px;display:grid;gap:12px}
.dlg h3{font-size:22px;letter-spacing:.03em}
.dlg p{margin:0;font-size:14px}
.cmd{display:block;padding:8px 10px;border-radius:8px;background:var(--inset);border:1px solid var(--rule);
  font:12.5px/1.4 var(--f-mono);overflow-wrap:anywhere}
.cmd::before{content:"$ ";color:var(--ink3)}
.out{max-height:42vh;overflow:auto;padding:10px 12px;border-radius:8px;background:var(--inset);border:1px solid var(--rule)}
.result{font-weight:700}
.dlg-actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:8px}
.opts{display:grid;gap:6px}
.opt{display:grid;grid-template-columns:auto 1fr;gap:2px 10px;align-items:center;padding:8px 10px;border-radius:9px;
  border:1px solid var(--rule);cursor:pointer;font-size:14px}
.opt input{grid-row:1/3}
.opt small{color:var(--ink2);font-size:12px}
.opt.dis{opacity:.5;cursor:default}
.confirm-in{width:100%;min-height:40px;padding:8px 10px;border-radius:8px;border:1px solid var(--rule);
  background:var(--bg);font-size:16px}
.toast{position:fixed;left:50%;bottom:max(16px,env(safe-area-inset-bottom));transform:translateX(-50%);z-index:20;
  max-width:calc(100vw - 32px);padding:9px 14px;border-radius:10px;background:var(--ink);color:var(--bg);
  font-size:13px;box-shadow:0 8px 24px rgba(0,0,0,.25)}

@media (max-width:1080px){
  .hero{grid-template-columns:auto minmax(0,1fr)}
  .gauges{grid-column:1/-1}
}
@media (max-width:900px){
  .qrow{grid-template-columns:repeat(var(--cols,3),minmax(0,1fr));gap:8px 12px}
  .qrow.head{display:none}
  .qname,.qnext{grid-column:1/-1}
  .qcell .lbl{display:block;font:700 12px/1 var(--f-display);letter-spacing:.06em;text-transform:uppercase;
    color:var(--ink2);margin-bottom:4px}
  /* accounts: a card each, on a grid: name line, bars, figures, groups, buttons */
  table.acc thead{display:none}
  table.acc,table.acc tbody{display:block}
  table.acc tr{display:grid;grid-template-columns:auto repeat(4,minmax(0,1fr)) auto;gap:7px 10px;
    align-items:center;padding:12px 14px;border-bottom:1px solid var(--rule)}
  table.acc tr:last-child{border-bottom:0}
  table.acc td{display:block;padding:0;border:0;min-width:0}
  table.acc .c-n{order:1;grid-column:1;font-size:15px}
  table.acc .c-acct{order:2;grid-column:2/6;max-width:none;min-width:0}
  table.acc .c-plan{order:3;grid-column:6;justify-self:end;font:600 12px var(--f-mono)}
  table.acc .c-mark{order:4;grid-column:1/-1}
  table.acc .c-mark:empty{display:none}
  table.acc .c-bar{width:auto;display:grid;grid-template-columns:44px minmax(0,1fr);align-items:center}
  table.acc .c-b5{order:5;grid-column:1/5}
  table.acc .c-r5{order:6;grid-column:5/-1;justify-self:end}
  table.acc .c-b7{order:7;grid-column:1/-1}
  table.acc .c-bm{order:8;grid-column:1/-1}
  table.acc .c-renews{order:9;grid-column:1/4}
  table.acc .c-rst{order:10;grid-column:4/6}
  table.acc .c-chr{order:11;grid-column:5/-1;justify-self:end}
  table.acc .c-grp{order:12;grid-column:1/-1}
  table.acc .c-act{order:13;grid-column:1/-1;text-align:left}
  table.acc .c-act:empty{display:none}
  table.acc .c-act .acts{justify-content:flex-start}
  table.acc td[data-k]::before{content:attr(data-k);margin-right:6px;font:700 12px/1 var(--f-display);
    letter-spacing:.06em;text-transform:uppercase;color:var(--ink2)}
  table.acc .c-bar::before{margin:0}
  .btn{min-height:40px}
  .btn.small{min-height:36px}
}
@media (max-width:560px){
  .top{gap:8px}
  .brand .ver{display:none}
  .chip{font-size:11px;padding:3px 7px}
  .hero{padding:14px;gap:14px}
  .plate .n{font-size:60px}
  .plate{min-width:70px}
  .who .email{font-size:17px}
  .warns li{grid-template-columns:1fr;gap:2px}
  .orow{grid-template-columns:20px 30px minmax(0,1fr) 96px}
  .group{padding:12px}
  .wacts{margin-left:0}
  select{font-size:16px;min-height:40px}
  table.cal{font-size:10.5px}
  table.cal col.c0{width:50px}
  table.cal td{padding:5px 1px}
  table.cal td.who{padding-left:8px}
  table.cal td.who small{display:none}
}
@media (prefers-reduced-motion:reduce){
  *{transition:none!important;animation:none!important}
  html{scroll-behavior:auto}
}
.vsw{display:flex;flex-wrap:wrap;gap:4px;margin:-2px 0 10px}
.vsw button{border:1px solid var(--rule);background:var(--panel);color:var(--ink2);border-radius:999px;padding:4px 12px;font-size:13px;cursor:pointer}
.vsw button[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
/* the other views of groups, accounts and the calendar (x- classes, under .vx) */
.vx .x-filters{display:flex;gap:6px;align-items:center;padding:8px 0 9px;overflow-x:auto;scrollbar-width:none}
.vx .x-chip{border:1px solid var(--rule);background:transparent;border-radius:6px;padding:3px 9px;cursor:pointer;font-size:12.5px;white-space:nowrap}
.vx .x-chip[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.vx .x-note{margin:0 0 10px;color:var(--ink2);font-size:13px;max-width:70ch}
.vx .x-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;border:1px solid var(--rule);border-radius:10px;background:var(--panel)}
.vx table{border-collapse:separate;border-spacing:0;width:max-content;min-width:100%}
.vx th,.vx td{padding:7px 10px;border-bottom:1px solid var(--rule);text-align:left;vertical-align:middle;white-space:nowrap}
.vx thead th{position:sticky;top:0;background:var(--inset);font:600 12px/1.1 var(--f-display);letter-spacing:.06em;
  text-transform:uppercase;color:var(--ink2);z-index:2}
.vx th.x-sort{cursor:pointer;user-select:none}
.vx th.x-sort:hover{color:var(--ink)}
.vx th .x-arr{color:var(--accent);margin-left:3px}
.vx tbody tr:hover td{background:color-mix(in srgb,var(--accent) 5%,var(--panel))}
.vx .x-stk{position:sticky;left:0;z-index:1;background:var(--panel)}
.vx .x-stk2{position:sticky;left:46px;z-index:1;background:var(--panel);box-shadow:1px 0 0 var(--rule)}
.vx thead .x-stk,.vx thead .x-stk2{z-index:3;background:var(--inset)}
.vx td.x-n,.vx th.x-n{width:46px;min-width:46px;font:600 13px var(--f-mono);color:var(--ink2)}
.vx .x-acct b{font-weight:600;display:block;max-width:190px;overflow:hidden;text-overflow:ellipsis}
.vx .x-acct small{display:block;color:var(--ink3);font-size:11.5px;max-width:190px;overflow:hidden;text-overflow:ellipsis}
.vx tr.x-off td{opacity:.5}
.vx tr.x-on-cl td.x-stk2{box-shadow:inset 3px 0 0 var(--accent),1px 0 0 var(--rule)}
.vx tr.x-on-lane td.x-stk2{box-shadow:inset 3px 0 0 var(--cyan),1px 0 0 var(--rule)}
.vx .x-bc{display:flex;align-items:center;gap:8px}
.vx .x-bar{position:relative;display:inline-block;width:104px;height:12px;border-radius:6px;background:var(--track);overflow:hidden;flex:none}
.vx .x-bar>i{position:absolute;left:0;top:0;bottom:0;width:calc(var(--p,0) * 1%);background:var(--ok-fill);border-radius:6px}
.vx .x-bar.x-warn>i{background:var(--warn-fill)}
.vx .x-bar.x-bad>i{background:var(--bad-fill)}
.vx .x-bar.x-none>i{width:0}
.vx .x-bar.x-sm{width:46px;height:7px}
.vx .x-pv{font:700 14px/1 var(--f-mono);min-width:44px;text-align:right}
.vx .x-pv.x-ok{color:var(--ok)}
.vx .x-pv.x-warn{color:var(--warn)}
.vx .x-pv.x-bad{color:var(--bad)}
.vx .x-pv.x-none{color:var(--ink3)}
.vx .x-tc{display:flex;flex-direction:column;line-height:1.15}
.vx .x-tc .x-t1{font:600 13.5px var(--f-mono)}
.vx .x-tc .x-t1 .x-d{color:var(--ink2);font-weight:500}
.vx .x-tc .x-t2{font-size:11.5px;color:var(--ink3)}
.vx .x-tc.x-soon .x-t2{color:var(--accent);font-weight:600}
.vx .x-pill{display:inline-block;font:600 11px/1 var(--f-mono);padding:3px 6px;border-radius:5px;border:1px solid var(--rule);margin-right:4px;color:var(--ink2)}
.vx .x-pill.x-cl{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
.vx .x-pill.x-lane{border-color:var(--cyan);color:var(--cyan)}
.vx .x-pill.x-flag{border-color:var(--bad);color:var(--bad)}
.vx .x-pill.x-watch{border-color:var(--cyan);color:var(--cyan)}
.vx .x-why span{margin-right:8px;font-size:12.5px}
.vx tr.x-band td{background:var(--inset);border-bottom:1px solid var(--rule);padding:10px 10px 9px}
.vx tr.x-band .x-bandin{position:sticky;left:10px;display:flex;flex-wrap:wrap;gap:4px 16px;align-items:baseline;max-width:calc(100vw - 2 * var(--gutter) - 24px)}
.vx tr.x-band h3{margin:0;font:700 19px/1 var(--f-display);letter-spacing:.05em;text-transform:uppercase}
.vx tr.x-band .x-kv{font-size:12.5px;color:var(--ink2)}
.vx tr.x-band .x-kv b{color:var(--ink)}
.vx tr.x-band select{padding:2px 4px;border-radius:5px;border:1px solid var(--rule);background:var(--panel)}
.vx td.x-pos{font:600 13px var(--f-mono);color:var(--ink3);width:30px}
.vx tr.x-lo td{opacity:.55}
.vx td.x-heat{padding:0;border-left:2px solid var(--panel)}
.vx .x-hc{display:flex;flex-direction:column;justify-content:center;min-width:86px;height:48px;padding:4px 9px;position:relative}
.vx .x-hc.x-ok{background:var(--ok-bg)}
.vx .x-hc.x-warn{background:var(--warn-bg)}
.vx .x-hc.x-bad{background:var(--bad-bg)}
.vx .x-hc.x-none{background:var(--inset)}
.vx .x-hc b{font:700 17px/1 var(--f-mono)}
.vx .x-hc.x-ok b{color:var(--ok)}
.vx .x-hc.x-warn b{color:var(--warn)}
.vx .x-hc.x-bad b{color:var(--bad)}
.vx .x-hc.x-none b{color:var(--ink3)}
.vx .x-hc small{font:11px/1.2 var(--f-mono);color:var(--ink2);margin-top:3px}
.vx .x-hc>i{position:absolute;left:0;bottom:0;height:3px;width:calc(var(--p,0) * 1%);background:currentColor;opacity:.55}
.vx .x-hc.x-ok>i{color:var(--ok-fill)}
.vx .x-hc.x-warn>i{color:var(--warn-fill)}
.vx .x-hc.x-bad>i{color:var(--bad-fill)}
.vx .x-board{display:flex;gap:12px;overflow-x:auto;padding-bottom:6px;align-items:flex-start}
.vx .x-col{flex:0 0 300px;min-width:0;background:var(--panel);border:1px solid var(--rule);border-radius:10px;overflow:hidden}
.vx .x-colh{padding:10px 12px;background:var(--inset);border-bottom:1px solid var(--rule)}
.vx .x-colh h3{margin:0 0 3px;font:700 19px/1 var(--f-display);letter-spacing:.05em;text-transform:uppercase}
.vx .x-colh .x-kv{font-size:12px;color:var(--ink2)}
.vx .x-card{display:grid;grid-template-columns:22px minmax(0,1fr) auto;gap:2px 8px;padding:8px 12px;border-bottom:1px solid var(--rule)}
.vx .x-card.x-is-on{box-shadow:inset 3px 0 0 var(--accent)}
.vx .x-card .x-p{font:600 12px var(--f-mono);color:var(--ink3)}
.vx .x-card .x-w{font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.vx .x-card .x-r{font:12px var(--f-mono);color:var(--ink2);text-align:right}
.vx .x-card .x-bars{grid-column:2/4;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}
.vx .x-mini{display:flex;flex-direction:column;gap:2px;font:11px var(--f-mono)}
.vx .x-mini .x-bar{width:100%;height:7px}
.vx .x-mini span{display:flex;justify-content:space-between;color:var(--ink3)}
.vx .x-mini span b{font-weight:700}
.vx .x-card .x-why{grid-column:2/4;font-size:11.5px}
.vx .x-card.x-blk{opacity:.6}
.vx .x-q{display:flex;flex-direction:column;gap:3px;min-width:130px}
.vx .x-q small{font:11px var(--f-mono);color:var(--ink3)}
.vx .x-tl{position:relative;width:max-content}
.vx .x-tlh,.vx .x-tlr{display:flex}
.vx .x-tlh{position:sticky;top:0;z-index:3;background:var(--inset);border-bottom:1px solid var(--rule)}
.vx .x-tll{position:sticky;left:0;z-index:2;flex:0 0 178px;width:178px;background:var(--panel);padding:6px 10px;border-right:1px solid var(--rule);
  border-bottom:1px solid var(--rule);overflow:hidden}
.vx .x-tlh .x-tll{background:var(--inset);font:600 12px var(--f-display);letter-spacing:.06em;text-transform:uppercase;color:var(--ink2)}
.vx .x-tll b{display:block;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.vx .x-tll small{display:block;font:11px var(--f-mono);color:var(--ink3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.vx .x-tlt{position:relative;flex:none;border-bottom:1px solid var(--rule)}
.vx .x-hr{position:absolute;top:0;bottom:0;border-left:1px solid var(--rule);opacity:.6}
.vx .x-hr.x-mid{border-left:2px solid var(--ink3);opacity:.8}
.vx .x-hl{position:absolute;top:6px;font:600 12px var(--f-mono);color:var(--ink2);transform:translateX(4px)}
.vx .x-hl.x-mid{color:var(--ink)}
.vx .x-dl{position:absolute;top:22px;font:600 10.5px var(--f-display);letter-spacing:.06em;text-transform:uppercase;color:var(--ink3);transform:translateX(4px)}
.vx .x-win{position:absolute;top:9px;height:26px;border-radius:6px;background:color-mix(in srgb,var(--ok-fill) 22%,transparent);
  border:1px solid var(--ok-fill);display:flex;align-items:center;justify-content:flex-end;padding:0 6px;overflow:hidden}
