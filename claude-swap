  watch)
    case "${2:-status}" in
      start) shift 2; cmd_watch_start "$@" ;;
      run) shift 2; cmd_watch_run "$@" ;;
      stop) cmd_watch_stop ;;
      status) cmd_watch_status ;;
      reserved) shift 2; cmd_watch_reserved "$@" ;;
      help|-h|--help) _watch_usage ;;
      -*) _watch_usage; exit 1 ;;
      *) shift; cmd_watch_group "$@" ;;
    esac
    ;;
  add)
    cmd_add "${2:-}"
    ;;
  run)
    shift
    cmd_run "$@"
    ;;
  reserve)
    cmd_set_reserved "${2:-}" 1 reserve
