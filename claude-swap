def _console_where(acc):
    # the profile it came from before, else the one logged in to claude.ai
    p = acc.get("console_profile") or acc.get("login_profile") or acc.get("chrome_profile")
    return f" ({p})" if p else ""

if console_blocked:
    print()
    print("Console not checked (Cloudflare is challenging platform.claude.com):"
          " run 'claude-swap keys-sync' again later")
else:
    no_console, console_stale = [], []
    for i, acc in live:
        em = (acc.get("email") or "").lower()
        if not secrets.read(oauth.VAULT, oauth.console_slot(em)):
            no_console.append(f"{i+1}{_console_where(acc)}")
        elif em not in console_ok:
