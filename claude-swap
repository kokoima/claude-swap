def auth_none_left(store):
    """What `claude-swap auth all` says when it has nobody to authorize."""
    return ("Every paid account " + ("of general " if has_general(store) else "")
            + "already holds a good login.")

# ---------- what the commands decide ----------

def run_seat(store, n=None, g=None, lanes=True):
    """Where a new session of `claude-swap run [n] [--group g]` goes.
    -> (group, seat, asked, error). The group is g, else n's home group,
    else the default one; None for an account in general and in no lane
    group (not reserved), whose session runs on its own setup-token. A
    number never moves a lane (an old alias in an open shell did, onto a
    seat at its limit): while the group's lane is on another of its seats
    the session joins it there, and asked is the number it asked for.
    Without a number: the seat the lane is on, else the group's only seat.
    lanes False (no keychain): there are none."""
    accounts, groups = store.get("accounts", []), groups_of(store)
    if g is not None and g not in groups:
        return None, None, None, f"Error: there is no group {g}"
    if n is not None:
        if not 1 <= n <= len(accounts):
            return None, None, None, f"Error: account {n} does not exist (valid: 1-{len(accounts)})"
        acc = accounts[n - 1]
        if acc.get("disabled") or not acc.get("token"):
            return None, None, None, f"Error: account {n} is disabled or has no token"
        gs = groups_for(store, n)
        if not gs and in_general(store, n):
            if g:
                return None, None, None, (f"Error: account {n} is not reserved: only a reserved"
                                          " seat runs on a group's lane")
            return None, n, None, None
        if g and g not in gs:
            return None, None, None, f"Error: #{n} is not in {g} (it is in {', '.join(gs)})"
        if not gs:
            return None, None, None, "Error: " + resolve_group(store, n)[1]
        g = g or gs[0]
        on = lane_of(store, g) if lanes else None
        return g, on or n, (n if on and on != n else None), None
    named, g = g is not None, g or default_group(store)
    on = lane_of(store, g) if lanes else None
    if on:
        return g, on, None, None
    pool = groups.get(g, [])
    if not pool:
        return None, None, None, (f"No live seat in {g}:  claude-swap group {g} <n...>"
                                  if lane_group_lists(store) else
                                  "No reserved account: mark one with  claude-swap reserve <n>")
    if len(pool) > 1:
        seats = ", ".join(f"#{i} {accounts[i - 1].get('email') or accounts[i - 1].get('label') or '?'}"
                          for i in pool)
        return None, None, None, (
            f"Several seats in {g} ({seats}): say which one,  claude-swap run --group {g} <n>"
            " -- <claude args>" if named else
            f"Several reserved accounts ({seats}): say which one,  claude-swap run <n>"
            " -- <claude args>")
    return g, pool[0], None, None

def watch_reserved(store, args):
    """`claude-swap watch reserved [<g>] [<n>... | off]` applied to the store.
    -> (lane key, error). Without a group name (the first argument a number
    or off) it is the default group's list, lane_rotate, as up to 1.20; with
    one, that group's (lane_rotates[g]; the default group's is lane_rotate
    still), of its own seats only. No seats: the list is only shown. A group
    whose watch has settings of its own (watch <g>, 1.22) has them set too:
    the seats and on, or off."""
    accounts, g = store.get("accounts", []), None
    if args and not args[0].isdigit() and args[0] != "off":
        g, args = args[0], args[1:]
        if g not in groups_of(store):
            return None, f"Error: there is no group {g}"
    k = lane_key(store, g)
    if not args:
        return k, None
    picked = []
    if args != ["off"]:
        seats = groups_of(store)[g] if g else None
        for x in args:
            n = int(x) if x.isdigit() else 0
            if not 1 <= n <= len(accounts):
                return k, f"Error: account {x} does not exist (valid: 1-{len(accounts)})"
            a = accounts[n - 1]
            if in_general(store, n) and not groups_for(store, n):
                return k, (f"Error: account {n} is not reserved: the watch moves it as the"
                           " shared login already")
            if g and n not in seats:
                return k, (f"Error: #{n} is not in {g} (its seats: "
                           + ", ".join(f"#{i}" for i in seats) + ")")
            if not a.get("email"):
                return k, f"Error: account {n} has no email in the store"
            if n not in picked:
                picked.append(n)
        if len(picked) < 2:
            return k, (f"Say at least two seats of {g}, or off" if g else
                       "Say at least two reserved accounts, or off")
    emails = [accounts[n - 1]["email"] for n in picked]
    if k is None:
        if emails:
            store["lane_rotate"] = emails
        else:
            store.pop("lane_rotate", None)
    else:
        rots = {x: v for x, v in (store.get("lane_rotates") or {}).items() if x != k}
        if emails:
            rots[k] = emails
        if rots:
            store["lane_rotates"] = rots
        else:
            store.pop("lane_rotates", None)
    name, wg = k or default_group(store), store.get("watch_groups") or {}
    if isinstance(wg.get(name), dict):
        cfg = dict(wg[name])
        cfg.update({"on": True, "seats": emails} if emails else {"on": False})
        store["watch_groups"] = {**wg, name: cfg}
    return k, None

def remove_account(store, n):
    """Take account n out of the store, and what names it there: its email
    in the groups and in the watch's lists, its number in the live and lane
    records (those after it move down). A group left empty goes, but for
    general and for the default one while other lane groups exist: its lane
    is the one of 1.15, which the next group would take over.
    -> (the account, its vault entries to delete)"""
    gone = store["accounts"].pop(n - 1)
    for rec in [store.get("live"), store.get("lane")] + list((store.get("lanes") or {}).values()):
        for f in ("n", "from"):
            if not isinstance((rec or {}).get(f), int):
                continue
            if rec[f] == n:
                rec[f] = None
            elif rec[f] > n:
                rec[f] -= 1
    active = store.get("active", 0)
    if active == n:
        store["active"] = 1 if store["accounts"] else 0
    elif active > n:
        store["active"] = active - 1
    e = (gone.get("email") or "").strip().lower()
    groups = dict(store.get("groups") or {})
    dflt, lanes = default_group(store), len(lane_group_lists(store))
    for g in list(groups):
        left = [x for x in groups[g] if x.lower() != e]
        if left or g == GENERAL or (g == dflt and lanes > 1):
            groups[g] = left
        else:
            groups.pop(g)
    if any(groups.values()) or GENERAL in groups:
        store["groups"] = groups
    else:
        store.pop("groups", None)
    left = [x for x in store.get("lane_rotate") or [] if x.lower() != e]
    if left:
        store["lane_rotate"] = left
    else:
        store.pop("lane_rotate", None)
    rots = {}
    for g, emails in (store.get("lane_rotates") or {}).items():
        left = [x for x in emails if x.lower() != e]
        if left:
            rots[g] = left
    if rots:
        store["lane_rotates"] = rots
    else:
        store.pop("lane_rotates", None)
    # a list of a group's watch keeps what is left of it, even nothing: an
    # empty one moves nothing, where none at all would move among every seat
    for cfg in (store.get("watch_groups") or {}).values():
        if isinstance(cfg, dict) and isinstance(cfg.get("seats"), list):
            cfg["seats"] = [x for x in cfg["seats"]
                            if not isinstance(x, str) or x.strip().lower() != e]
    slots = []
    if e:
        if gone.get("oauth"):
            slots.append(slot(gone))
        slots += [group_slot(gone, g) for g in gone.get("oauth_groups") or {}]
        slots.append(console_slot(gone["email"]))
    return gone, slots

def file_login(store, k, o, account, secrets, live, http, now, group=None, base=None):
    """File login o, which `claude-swap auth` brought back for account k:
    k's login of group, as login_group says (None: its main one, for k's
    home group, no group, or a group k is not in; general: its login of
    general when general is not its home), saved to its vault slot, then put
    where that login is in use: Claude Code's credential if k is the shared
    login and that is the login it takes, else every lane on k that holds
    that login (a lane on k holding another of its logins keeps it until
    its next move). -> (login key, installed, [(lane key, mode)]), or None
    when the vault refused it (nothing changed)."""
    acc = store["accounts"][k - 1]
    key = (cl_login(store, k) if group == GENERAL
           else login_group(store, k, group) if group in groups_for(store, k) else None)
    if not secrets.write(VAULT, dump(o), group_slot(acc, key)):
        return None
    note_group_login(acc, key, o, now, account)
    installed, lanes = False, []
    if store.get("active") == k and key == cl_login(store, k):
        mode, _ = install(store, k, secrets, live, http, now)
        if mode == "oauth":
            mark_live(store, k, mode, now, (store.get("live") or {}).get("from"))
            installed = True
    else:
        for lk in lane_groups(store):
            if lane_of(store, lk) == k and lane_login(store, lk) == key:
                mode = lane_put(store, k, secrets, http, now, base, group=lk)[0]
                if mode != "failed":
                    lanes.append((lk, mode))
    return key, installed, lanes
