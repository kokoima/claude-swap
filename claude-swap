.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
.btn.danger{border-color:var(--bad-fill);color:var(--bad)}
.btn.danger.solid{background:var(--bad-fill);color:#fff}
.btn.small{min-height:28px;padding:3px 9px;font-size:12px}
.btn.link{border:0;background:none;box-shadow:none;padding:2px 4px;min-height:0;color:var(--accent);font-weight:600}
