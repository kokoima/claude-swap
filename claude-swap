        kids.push(h("div", { class: "win " + level(a.u5), vars: { "--p": clamp(a.u5) }, css: { left: x(s) + "px", width: Math.max(4, x(e) - x(s)) + "px" },
          title: "5h window: " + pct(a.u5) + " used, starts again at " + hm(a.r5) }, h("i"), h("b", { text: pct(a.u5) })));
        kids.push(h("span", { class: "endlbl t-" + level(a.u5), css: { left: x(e) + "px" }, text: hm(a.r5) }));
      } else {
        kids.push(h("span", { class: "freebar", css: { left: x(now) + 8 + "px" }, text: a.u5 ? "" : "no 5h window", title: "a fresh 5h window starts with the first message" }));
      }
      if (a.r7 && a.r7 > start && a.r7 < end) kids.push(h("span", { class: "mk w7", css: { left: x(a.r7) + "px" }, title: "the week starts again", text: "wk " + hm(a.r7) + " · " + pct(a.u7) }));
      if (a.rf && !sameT(a.rf, a.r7) && a.rf > start && a.rf < end) kids.push(h("span", { class: "mk fb", css: { left: x(a.rf) + "px" }, text: "Fb " + hm(a.rf) }));
      const r = a.renews || {};
      if (r.kind === "ends" && r.at > start && r.at < end) kids.push(h("span", { class: "mk end", css: { left: x(r.at) + "px" }, text: "✕ " + hm(r.at) }));
      return h("div", { class: "tlr" + (a.cl ? " on-cl" : (a.lanes || []).length ? " on-lane" : "") },
        h("div", { class: "tll", title: a.label }, h("b", {}, "#" + a.n + " " + short(a)),
          h("small", { text: "5h " + pct(a.u5) + " wk " + pct(a.u7) + " " + modelName().slice(0, 2) + " " + pct(a.model_pct) })),
        h("div", { class: "tlt", css: { width: W + "px", height: "44px" } }, kids));
    });
    const sc = scroll(h("div", { class: "tl" }, head, rows, h("div", { class: "nowl", css: { left: LBL + x(now) + "px" } })));
    if (fresh) requestAnimationFrame(() => { sc.scrollLeft = Math.max(0, x(now) - 60); });
    return [filters(redo), note("The next 24 hours, the soonest 5h reset first. The bar is the running 5h window (filled by how much is used) and ends at the hour it starts again. Yellow: the week starts again; magenta: " + modelName() + " on its own; red: a plan ends."), sc];
  }

  function calWeek(redo) {
    const days = (S.calendar && S.calendar.days) || [];
    if (!days.length) return h("p", { class: "faint", text: "No calendar." });
    const now = nowS();
    const ev = events(Math.min(now, days[0].start), days[days.length - 1].start + 86400);
    const cell = {};
    for (const e of ev) {
      const d = days.findIndex((x) => e.t >= x.start && e.t < x.start + 86400);
      if (d >= 0) (cell[d + "|" + D(e.t).getHours()] = cell[d + "|" + D(e.t).getHours()] || []).push(e);
    }
    const hours = [];
    for (let hh = 0; hh < 24; hh++) if (!vu.compact || days.some((_, d) => cell[d + "|" + hh]) || hh === D(now).getHours()) hours.push(hh);
    const grid = h("div", { class: "wk" });
    grid.style.gridTemplateColumns = "52px repeat(" + days.length + ", minmax(128px, 1fr))";
    grid.append(h("div", { class: "wh corner" }));
    days.forEach((d) => grid.append(h("div", { class: "wh" + (dayKey(d.start) === dayKey(now) ? " today" : ""), text: DAYS[D(d.start).getDay()] + " " + D(d.start).getDate() })));
    for (const hh of hours) {
      grid.append(h("div", { class: "hh", text: pad2(hh) + ":00" }));
      days.forEach((d, i) => {
        const t0 = d.start + hh * 3600;
        grid.append(h("div", { class: now >= t0 && now < t0 + 3600 ? "cur" : t0 + 3600 <= now ? "past" : "" },
          (cell[i + "|" + hh] || []).map((e) => h("span", { class: "ev " + e.k, title: e.a.label + ": " + e.what + " " + hm(e.t) },
            hm(e.t) + " #" + e.a.n + " " + TAG[e.k] + " ", e.p != null ? h("em", { text: pct(e.p) }) : null))));
      });
    }
    const compact = h("button", { type: "button", class: "chip", "aria-pressed": String(vu.compact), text: "only hours with something",
      onclick: () => { vu.compact = !vu.compact; redo(); } });
    return [filters(redo, compact), note("A week by the hour: when each limit starts again. The % is what is used now and comes back then."),
      h("div", { class: "legend" }, h("span", { class: "ev h5", text: "5h window" }), h("span", { class: "ev wk7", text: "week (and " + modelName() + " at the same time)" }),
        h("span", { class: "ev fb", text: modelName() + " alone" }), h("span", { class: "ev end", text: "plan ends / downgrade" })),
      scroll(grid)];
  }

  function calAgenda(redo) {
    const now = nowS();
    const out = [];
    let day = null;
    for (const e of events(now - 600, now + 8 * 86400)) {
      const k = dayKey(e.t);
      if (k !== day) {
        day = k;
        out.push(h("div", { class: "agd", text: k === dayKey(now) ? "Today · " + dateStr(e.t) : k === dayKey(now + 86400) ? "Tomorrow · " + dateStr(e.t) : dateStr(e.t) }));
      }
      out.push(h("div", { class: "agr" },
        h("span", { class: "tm", text: hm(e.t) }),
        h("span", { class: "cd" + (e.t - now < 3 * 3600 ? " soon" : ""), text: until(e.t) }),
        h("span", { class: "ty " + e.k, text: TAG[e.k] }),
        h("div", { class: "wh2" }, h("b", { text: "#" + e.a.n + " " + short(e.a) }),
          e.p != null ? h("span", { class: "bc" }, bar(e.p, "sm"), h("span", { class: "fig t-" + level(e.p), text: pct(e.p) + " " + e.what + " back" }))
            : h("span", { class: "t-bad", text: e.what }), onPills(e.a))));
    }
    return [filters(redo), note("What starts again, in order, for the next 8 days."),
      h("div", { class: "ag" }, out.length ? out : h("p", { class: "faint", text: "Nothing." }))];
  }

  return {
    grp: { table: grpTable, board: grpBoard },
    acc: { table: accTable, all: accAll, groups: accGroups, heat: accHeat },
    cal: { all: accAll, timeline: calTimeline, week: calWeek, agenda: calAgenda },
  };
})();

// The switch of an area and, when it is not on "classic", its view instead of
// the classic one. true when the area is done (an other view drew it).
function altView(area, redo) {
  const sw = $("sw-" + area);
  fill(sw, VIEW_OPTS[area].map(([k, t]) => h("button", { type: "button", "aria-pressed": String(ui.vw[area] === k), text: t,
    onclick: () => { if (ui.vw[area] === k) return; ui.vw[area] = k; writeViews(); redo(); } })));
  const mode = ui.vw[area];
  const host = $("alt-" + area);
  const classic = { grp: ["groups-body"], acc: ["acc-wrap", "ungrouped"], cal: ["cal", "legend"] }[area].map($);
  if (mode === "classic" || !Views[area][mode]) {
    host.hidden = true; fill(host); host.removeAttribute("data-mode");
    classic.forEach((e) => { if (e.id !== "ungrouped") e.hidden = false; });
    return false;
  }
  classic.forEach((e) => { e.hidden = true; });
  host.hidden = false;
  const fresh = host.getAttribute("data-mode") !== mode;
  const old = fresh ? [] : [...host.querySelectorAll(".x-scroll,.x-board")].map((e) => e.scrollLeft);
  fill(host, Views[area][mode](redo, fresh));
  host.setAttribute("data-mode", mode);
  [...host.querySelectorAll(".x-scroll,.x-board")].forEach((e, i) => { if (old[i] != null) e.scrollLeft = old[i]; });
  return true;
}

