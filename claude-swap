.cal-gone{display:block;height:2px;margin:0 2px;background:var(--ink3);opacity:.5}
.cal-would{color:var(--ink3);text-decoration:line-through}
.legend{display:flex;flex-wrap:wrap;gap:4px 14px;margin:8px 2px 0;font-size:12px;color:var(--ink2)}

/* watch */
.watch{padding:14px 16px}
.wstate{display:flex;flex-wrap:wrap;align-items:center;gap:10px 16px}
.wstate .big{font:700 22px/1 var(--f-display);letter-spacing:.04em;text-transform:uppercase}
