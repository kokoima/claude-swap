        row["r7"] = parse_epoch(headers.get("anthropic-ratelimit-unified-7d-reset"))

    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            take_limits(dict(r.headers))
    except urllib.error.HTTPError as e:
        take_limits(dict(e.headers))
        try:
            body = json.loads(e.read())
            et = body.get("error", {}).get("type", "?")
        except Exception:
            et = f"HTTP {e.code}"
        if et == "rate_limit_error":
            row["error"] = "RATE LIMITED"
        elif et == "authentication_error":
            row["error"] = "AUTH ERROR"
        elif et == "overloaded_error":
            row["error"] = "OVERLOADED"
        else:
            row["error"] = et
    except Exception as e:
        row["error"] = type(e).__name__

