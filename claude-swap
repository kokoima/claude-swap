.gauge .bar{height:15px;border-radius:3px}
.gauge .pc{font:700 26px/1 var(--f-display);text-align:right}
.gauge .pc.ok{color:var(--ok)} .gauge .pc.warn{color:var(--warn)} .gauge .pc.bad{color:var(--bad)} .gauge .pc.none{color:var(--ink3)}
