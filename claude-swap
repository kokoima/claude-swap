cmd_credits() {
  # API credits per account and Console organization (read-only)
  check_store
  python3 - "$STORE" "${1:-}" <<'PYEOF'
import json, os, re, sys, time, types
engine = types.ModuleType("engine")
exec(os.environ["CLAUDE_SWAP_ENGINE"], engine.__dict__)
oauth = types.ModuleType("oauth")
exec(os.environ["CLAUDE_SWAP_OAUTH"], oauth.__dict__)

store_path, only = sys.argv[1], sys.argv[2].strip()
store = oauth.load_store(store_path)
accounts = store.get("accounts", [])
if only and not (only.isdigit() and 1 <= int(only) <= len(accounts)):
    sys.exit(f"Error: account {only} does not exist (valid: 1-{len(accounts)})")
USE_COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
RED, YELLOW, GREEN, GREY, BOLD, CYAN = "31", "33", "32", "90", "1", "36"
_ANSI = re.compile(r"\x1b\[[0-9;]*m")
def paint(code, s):
    return f"\x1b[{code}m{s}\x1b[0m" if USE_COLOR else s
def pad(s, w, right=False):
    gap = w - len(_ANSI.sub("", s))
    if gap <= 0:
        return s
    return (" " * gap + s) if right else (s + " " * gap)
def trunc(s, w):
    return s if len(s) <= w else s[:w - 1] + "…"
def day(t):
    # with the year when far off: "01 Nov" a year ahead would read as past
    if not t:
        return ""
    far = abs(t - time.time()) > 180 * 86400
    return time.strftime("%d %b %Y" if far else "%d %b", time.localtime(t))
def money(v):
    return "-" if v is None else f"{v:,.2f}"
def http(st):
    return f"HTTP {st}" if st else "no answer"

secrets = oauth.default_io()[0]
now = time.time()

# Widths fit the cells, measured without ANSI, so every row lines up whatever
# the amounts; a row cut short (no permission, no API org) ends in a message
# that spans the columns it leaves out. What could not be read shows as ?,
# never as 0.
TIER = {"auto_trust_tier_a": "a", "auto_trust_tier_b": "b", "auto_trust_tier_c": "c",
        "auto_api_evaluation": "eval"}
head = ["#", "Account", "Org", "Link", "Included", "Purchased", "Month", "Tier", "Keys"]
RIGHT = (0, 8)
UNKNOWN = paint(GREY, "?")

def account_rows(i, label, summaries, org_err):
    """The table rows of one account."""
    lead = [str(i), trunc(label, 22)]
    if org_err is not None:
        return [lead + [paint(GREY, f"could not read organizations ({http(org_err)})")]]
    if not summaries:
        return [lead + [paint(GREY, "no API organization")]]
    rows = []
    for s in summaries:
        name = trunc(s["name"] or "", 24)
        if s["no_permission"]:
            rows.append(lead + [name, paint(GREY, "no billing permission")])
            continue
        ln = s["link"] or {}
        link = {"linked": f"{ln.get('plan') or '?'} {(ln.get('monthly') or 0):.0f}$/m",
                "eligible": paint(YELLOW, "eligible"), "ineligible": "ineligible"}.get(
                    ln.get("status"), "—")
        inc = s["included"]
        if inc is None:  # the credits read failed (the API's 403 is no_permission, above)
            inc_txt = pur_txt = UNKNOWN
        else:
            if not inc.get("left"):
                inc_txt = paint(GREY, "-")
            elif not inc.get("expires"):
                inc_txt = paint(GREEN, f"{money(inc['left'])} $")
            else:
                left = inc["expires"] - now
                color = RED if left < engine.CREDIT_URGENT else (YELLOW if left < engine.CREDIT_SOON else GREEN)
                inc_txt = paint(color, f"{money(inc['left'])} $ → {day(inc['expires'])}")
            pur = s["purchased"] or {}
            pur_txt = (f"{money(pur.get('left'))} $" + (f" → {day(pur['expires'])}" if pur.get("expires") else "")
                       if pur.get("left") else paint(GREY, "0"))
        spend = "?" if s["spend"] is None else money(s["spend"])
        cap = "?" if s["cap"] is None else f"{s['cap']:,.0f}"
        month = f"{spend}/{cap} $"
        keys = str((s["keys"] or {}).get("active", 0)) if s["keys"] is not None else "?"
        t = s["tier"] or ""
        tier = TIER.get(t) or t.rsplit("_", 1)[-1] or "?"
        rows.append(lead + [name, link, inc_txt, pur_txt, month, tier, keys])
    return rows

# results: email -> (n, its table rows, its summaries, why its organizations
# are unknown, or None); turned: the accounts the Console turned away
results, missing, unread, rejected, silent, turned = {}, [], [], [], [], []
stop, refused = None, []  # refused: the latest accounts in a row turned away
for i, acc in enumerate(accounts, 1):
    # a disabled account only when asked for by number (it is a read)
    if (only and i != int(only)) or (not only and acc.get("disabled")):
        continue
    em = (acc.get("email") or "").lower()
    ck = secrets.read(oauth.VAULT, oauth.console_slot(em)) if em else None
    if not ck:
        # keys-sync saved one: the keychain did not give it back (over SSH it
        # is locked), which is not the same as never having logged in
        (unread if acc.get("console_checked") else missing).append(i)
        continue
    label = acc.get("label") or em
    c = oauth.Console(ck)
    try:
        st, acct = c.get("/api/account")
        if c.blocked:
            stop = f"Cloudflare is challenging the Console: stopped at #{i}."
            break
        if st == 200 and not isinstance(acct, dict):
            raise ValueError("/api/account: not an object")
        if st != 200 or not acct.get("email_address"):
            # the API rejecting this session is not the edge turning the
            # client away: only the latter, twice in a row, stops the run
            kind = oauth.console_failure(st, acct)
            {"rejected": rejected, "refused": turned, "silent": silent}[kind].append((i, st))
            refused = refused + [(i, st)] if kind == "refused" else []
            if len(refused) >= 2:
                (a, sa), (b, sb) = refused[-2:]
                stop = f"The Console turned away #{a} and #{b} in a row ({http(sa)}, {http(sb)}): stopped."
                break
            continue
        refused = []
        st, orgs = c.get("/api/organizations")
        org_err = None if st == 200 and isinstance(orgs, list) else st
        orgs = orgs if org_err is None else []
        per = {o["uuid"]: c.read_org(o["uuid"]) for o in orgs
               if "api" in (o.get("capabilities") or []) and o.get("uuid")}
        summ = engine.console_summary(acct, orgs, per, now)
        # a shape the table or the warnings would choke on fails here, for
        # this account alone, and never reaches the cache check reads
        rows_i = account_rows(i, label, summ, org_err)
        engine.credit_warnings({f"#{i}": summ}, now)
    except Exception:
        summ, org_err = [], "unexpected"
        rows_i = [[str(i), trunc(label, 22), paint(GREY, "unexpected reply")]]
    if c.blocked:
        # this account was read only in part (a blocked reply would even pass
        # for "no billing permission"): it is left out, and so are the rest
        stop = f"Cloudflare is challenging the Console: stopped at #{i}."
        break
    results[em] = (i, rows_i, summ, org_err)
    sys.stderr.write(f"  read {i} {label}\n")

if stop:
    print(paint(RED, stop + " Try again later (the cache keeps its last full read)."))

rows = [r for _, rows_i, _, _ in sorted(results.values(), key=lambda v: v[0]) for r in rows_i]

def vlen(s):
    return len(_ANSI.sub("", s))
W = [len(h) for h in head]
for r in rows:
    short = len(r) < len(head)
    for c, cell in enumerate(r[:-1] if short else r):
        W[c] = max(W[c], vlen(cell))
def line(cells):
    last = len(cells) - 1
    return "  " + "  ".join(cell if (c == last and c < len(head) - 1)
                            else pad(cell, W[c], c in RIGHT)
                            for c, cell in enumerate(cells))
print()
if rows:
    print(paint(BOLD, line(head)))
    for r in rows:
        print(line(r))
    print()
    print(paint(GREY, "  Included: API, Agent SDK and `claude -p` with a key of that org only — not"
                      " interactive Claude Code. Purchased: everything."))
warns = engine.credit_warnings({f"#{i}": summ for i, _, summ, _ in results.values()}, now)
colors = {"red": RED, "yellow": YELLOW, "grey": GREY}
for level, text in warns:
    print("  " + paint(colors.get(level, GREY), text))

def spans(ns):
    """#11, #13-#28: consecutive accounts as one span."""
    out, k = [], 0
    while k < len(ns):
        j = k
        while j + 1 < len(ns) and ns[j + 1] == ns[j] + 1:
            j += 1
        out.append(f"#{ns[k]}" + (f"-#{ns[j]}" if j > k else ""))
        k = j + 1
    return ", ".join(out)
if unread:
    print(paint(YELLOW, "  The keychain did not give back the Console session keys-sync saved for "
                + spans(unread) + (oauth.keychain_hint() or " — is it locked?")))
if missing:
    print(paint(GREY, "  No Console session: " + spans(missing)
                + " — log platform.claude.com in on the account's Chrome profile, then claude-swap keys-sync"))
if rejected:
    print(paint(GREY, "  Console session rejected: "
                + ", ".join(f"#{i} ({http(st)})" for i, st in rejected)
                + " — log it back in, then claude-swap keys-sync"))
if turned:
    print(paint(GREY, "  Console turned the request away: "
                + ", ".join(f"#{i} ({http(st)})" for i, st in turned) + " — try again later"))
if silent:
    print(paint(GREY, "  Console did not answer: "
                + ", ".join(f"#{i} ({http(st)})" for i, st in silent) + " — try again later"))

# Only a full run rewrites the cache: one account (credits <n>) or a run cut
# short would leave check without the others' warnings. An account whose
# organizations could not be read, or that answered in a shape not expected,
# is unknown, not empty: it stays out.
if results and not only and not stop:
    path = os.path.expanduser("~/.claude/claude-swap-credits.json")
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.fchmod(fd, 0o600)  # a leftover .tmp keeps its mode through O_CREAT
    with os.fdopen(fd, "w") as f:
        json.dump({"updated": now, "accounts": {em: summ for em, (_, _, summ, err) in results.items()
                                                if err is None}}, f)
    os.replace(tmp, path)
PYEOF
}

