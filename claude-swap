# login; any account may also be a seat of any lane group. A store without
# groups.general (up to 1.21) has the accounts not marked reserved there:
# migrate_general writes that list, last in the groups, and from then on the
# list rules and the mark follows it (reserved = not in general), for the
# scripts and menus of before. An account with no email cannot be listed:
# its mark stands.

def _email(a):
    return (a.get("email") or "").strip().lower()

def _live(a):
    return bool(a.get("token")) and not a.get("disabled")

def has_general(store):
    return GENERAL in (store.get("groups") or {})

def lane_group_lists(store):
    """The stored groups but general, {group: [email...]}: the lane groups."""
    return {g: v for g, v in (store.get("groups") or {}).items() if g != GENERAL}

def in_general(store, n):
    """Whether account n is in general, live or not (general_of: the live ones)."""
    accounts = store.get("accounts", [])
    if not 1 <= n <= len(accounts):
        return False
    a, listed = accounts[n - 1], (store.get("groups") or {}).get(GENERAL)
    if listed is None or not _email(a):
        return not a.get("reserved")
    return _email(a) in {e.strip().lower() for e in listed}

