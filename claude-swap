  if [ "$reserved" = "1" ]; then
    echo "Reserved: the watch never uses it. Sessions on it: claude-swap run [$count] -- <claude args>"
  fi
  echo "Next: log claude.ai in to it in a Chrome profile, then claude-swap keys-sync"
}

