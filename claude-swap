.seat input:disabled+span{opacity:.45;cursor:default}
.seat.all span{font-family:var(--f-body)}
select{min-height:32px;padding:4px 8px;border-radius:8px;border:1px solid var(--rule);background:var(--panel);font-size:13px}
.now{margin-top:12px;padding:10px 12px;border-radius:9px;border:1px solid var(--rule);font-size:14px}
.now b{font-weight:700}
.now .hint{margin-top:6px;display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:13px}
.order-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:14px}
.olist{margin:8px 0 0;padding:0;list-style:none;display:grid;gap:2px}
.orow{display:grid;grid-template-columns:22px 34px minmax(0,1fr) 130px;gap:4px 8px;align-items:center;
  padding:6px 6px;border-radius:7px}
