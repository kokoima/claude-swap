              " on its Chrome profile and re-run): #" + ", #".join(console_stale))

if sys.platform == "darwin":
    names = oauth.profile_names()

    def free(a):
        t = (a.get("plan") or "").lower()
        return "free" in t or t in ("", "default_claude_ai")
