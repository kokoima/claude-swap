.vx .x-win.x-bad{background:color-mix(in srgb,var(--bad-fill) 24%,transparent);border-color:var(--bad-fill)}
.vx .x-win>i{position:absolute;left:0;top:0;bottom:0;width:calc(var(--p,0) * 1%);background:currentColor;opacity:.28;color:var(--ok-fill)}
.vx .x-win.x-warn>i{color:var(--warn-fill)}
.vx .x-win.x-bad>i{color:var(--bad-fill)}
.vx .x-win b{position:relative;font:700 12px var(--f-mono);white-space:nowrap}
.vx .x-endlbl{position:absolute;top:12px;font:700 13px var(--f-mono);white-space:nowrap;transform:translateX(5px)}
.vx .x-mk{position:absolute;top:8px;transform:translateX(-50%);font:600 11px/1 var(--f-mono);padding:4px 5px;border-radius:5px;white-space:nowrap;border:1px solid}
.vx .x-mk.x-w7{color:var(--warn);border-color:var(--warn);background:var(--warn-bg)}
.vx .x-mk.x-fb{color:var(--mag);border-color:var(--mag);background:var(--panel);top:24px}
.vx .x-mk.x-end{color:var(--bad);border-color:var(--bad);background:var(--bad-bg)}
.vx .x-nowl{position:absolute;top:0;bottom:0;width:2px;background:var(--accent);z-index:1;pointer-events:none}
.vx .x-nowl::before{content:"now";position:absolute;top:2px;left:4px;font:700 10px var(--f-mono);color:var(--accent)}
.vx .x-freebar{position:absolute;top:15px;height:14px;left:0;right:0;font:11px var(--f-mono);color:var(--ink3);padding-left:8px}
.vx .x-wk{display:grid;width:max-content;min-width:100%}
.vx .x-wk>div{border-bottom:1px solid var(--rule);border-right:1px solid var(--rule);padding:4px 5px;min-height:34px}
.vx .x-wk .x-wh{position:sticky;top:0;z-index:2;background:var(--inset);font:600 12px var(--f-display);letter-spacing:.06em;text-transform:uppercase;color:var(--ink2);min-height:0;padding:7px 6px}
.vx .x-wk .x-wh.x-today{color:var(--accent)}
.vx .x-wk .x-hh{position:sticky;left:0;z-index:1;background:var(--inset);font:600 12px var(--f-mono);color:var(--ink2);text-align:right;padding-right:8px}
