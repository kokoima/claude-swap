.vx .x-ag{background:var(--panel);border:1px solid var(--rule);border-radius:10px;overflow:hidden}
.vx .x-agd{padding:8px 12px;background:var(--inset);font:700 15px var(--f-display);letter-spacing:.06em;text-transform:uppercase;border-bottom:1px solid var(--rule);position:sticky;top:0}
