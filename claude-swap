}

cmd_watch_reserved() {
  # Which seats the watch may move a group's reserved sessions among when the
  # one they are on reaches its limit (none: it leaves them alone). Without a
  # group name, the default group's list (lane_rotate, as up to 1.20).
  check_store
  python3 - "$STORE" "$@" <<'PYEOF'
import json, os, sys, types

oauth = types.ModuleType("oauth")
exec(os.environ["CLAUDE_SWAP_OAUTH"], oauth.__dict__)

store_path, args = sys.argv[1], sys.argv[2:]
store = oauth.load_store(store_path)
accounts = store.get("accounts", [])
store_read = json.loads(json.dumps(store))  # what save_changes compares against
k, err = oauth.watch_reserved(store, args)
if err:
    sys.exit(err)
if store != store_read:
    oauth.save_changes(store_path, store_read, store)  # the lists it set, and nothing else

def name(i):
    a = accounts[i - 1]
    return f"#{i} {a.get('label') or a.get('email') or '?'}"

def show(k):
