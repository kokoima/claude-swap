cmd_auth() {
  check_store
  if [ "$IS_MACOS" != true ]; then
    echo "claude-swap auth needs macOS for now (keychain and Chrome profiles)."
    exit 1
  fi
  command -v claude >/dev/null 2>&1 || { echo "Error: claude (Claude Code) is not in PATH"; exit 1; }
  # passed with -c, not on stdin: stdin stays the terminal, which claude's
  # "Paste code here" prompt and our questions read (claude cannot use a
  # reopened /dev/tty on macOS: kqueue refuses it)
  local auth_py
  read -r -d '' auth_py <<'PYEOF' || true
import json, os, shutil, signal, subprocess, sys, tempfile, time, types
from datetime import datetime

oauth = types.ModuleType("oauth")
exec(os.environ["CLAUDE_SWAP_OAUTH"], oauth.__dict__)

store_path, args = sys.argv[1], sys.argv[2:]
secrets, live, http = oauth.default_io(True)
# a closed terminal or a kill still clears the throwaway login (finally:)
signal.signal(signal.SIGTERM, signal.default_int_handler)
signal.signal(signal.SIGHUP, signal.default_int_handler)
BASE = os.path.expanduser("~/.claude/claude-swap-auth")

def sweep():
    """Throwaway logins an earlier run could not clear (the machine slept,
    or it was killed hard): their keychain item and directory."""
    try:
        old = [os.path.join(BASE, d) for d in os.listdir(BASE)]
    except OSError:
        return
    for d in old:
        try:
            if time.time() - os.stat(d).st_mtime < 3600:
                continue  # perhaps another auth still running
        except OSError:
            continue
        secrets.delete("Claude Code-credentials-" + oauth.config_hash(os.path.realpath(d)))
        shutil.rmtree(d, ignore_errors=True)
names = oauth.profile_names()
COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")

def paint(code, s):
    return f"\x1b[{code}m{s}\x1b[0m" if COLOR else s

def is_free(tier):
    t = (tier or "").lower()
    return "free" in t or t in ("", "default_claude_ai")

def day(ms):
    return datetime.fromtimestamp(ms / 1000).strftime("%a %d %b")

def state_text(a, now):
    st, left = oauth.login_state(a, now)
    m = a.get("oauth") or {}
    if st == "none":
        return paint("90", "none")
    if st == "dead":
        why = "refused" if m.get("dead") else "expired"
        return paint("31", f"{why} — redo it")
    until = f"until {day(m['rt_expires'])}" if m.get("rt_expires") else "no expiry known"
    if st == "expiring":
        return paint("33", f"{until} ({left / 86400:.0f}d left) — redo it soon")
    return paint("32", f"ok {until}") + paint("90", f" ({left / 86400:.0f}d)" if left else "")

def show(store):
    now = time.time()
    accounts = store.get("accounts", [])
    print("Full logins: what Claude in Chrome needs, one per account.")
    print()
    for i, a in enumerate(accounts, 1):
        prof = a.get("chrome_profile")
        where = names.get(prof, prof) if prof else "-"
        mark = "*" if i == store.get("active") else " "
        if a.get("disabled"):
            line = paint("90", "disabled")
        elif is_free(a.get("plan")) and "plan" in a:
            line = paint("90", "free plan: Claude Code does not run on it")
        else:
            line = state_text(a, now)
        print(f" {mark}{i:>2}  {(a.get('label') or '?')[:24]:<24} {(a.get('email') or '-')[:30]:<30} "
              f"{where[:20]:<20} {line}")
    print()
    print("  claude-swap auth <n>   authorize account n in its Chrome profile (one click)")
    print("  claude-swap auth all   every paid account without a good login, one after another")

def login(n):
    """One browser authorization for account n, saved to its slot. -> bool"""
    store = oauth.load_store(store_path)
    acc = store["accounts"][n - 1]
    email = (acc.get("email") or "").strip()
    if not email:
        print(f"#{n} has no email in the store, so its login could not be matched.")
        return False
    prof = acc.get("login_profile") or acc.get("chrome_profile")
    os.makedirs(BASE, mode=0o700, exist_ok=True)
    tmp = os.path.realpath(tempfile.mkdtemp(prefix=f"{n}-", dir=BASE))
    svc = "Claude Code-credentials-" + oauth.config_hash(tmp)
    env = {k: v for k, v in os.environ.items()
           if k not in ("CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_API_KEY",
                        "CLAUDE_CODE_OAUTH_REFRESH_TOKEN", "CLAUDE_CODE_OAUTH_SCOPES")}
    env["CLAUDE_CONFIG_DIR"] = tmp
    if prof:
        opener = os.path.join(tmp, "open-chrome")
        with open(opener, "w") as f:
            f.write('#!/bin/sh\nexec open -na "Google Chrome" --args '
                    f'"--profile-directory={prof}" "$1"\n')
        os.chmod(opener, 0o700)
        env["BROWSER"] = opener
    print()
    print(paint("1", f"#{n} {email}") + ": authorize it in "
          + (f"Chrome profile '{names.get(prof, prof)}'" if prof else "the browser that opens")
          + f". Check the page shows {email}, then Authorize.")
    print("  If claude.ai asks you to sign in again (it does when the last sign-in is not"
          " recent), do it in that same window: the code it emails goes in that"
          " window's box.")
    if not prof:
        print("  (no Chrome profile known for it: run keys-sync, or claude-swap chrome"
              f" {n} \"<Profile dir>\")")
    try:
        r = subprocess.run(["claude", "auth", "login", "--claudeai", "--email", email], env=env)
        o = oauth.parse(secrets.read(svc))
        try:
            with open(os.path.join(tmp, ".claude.json")) as f:
                account = json.load(f).get("oauthAccount")
        except Exception:
            account = None
        if not oauth.is_full(o) or not account:
            print(f"  No login came back (exit {r.returncode}): nothing changed.")
            print("  The browser tab it ended on says why (error_description=...):"
                  " account_on_hold means claude.ai has the account restricted"
                  " (claude.ai/restricted); access_denied alone, that it was cancelled.")
            return False
        got = (account.get("emailAddress") or "").strip().lower()
        # it may have taken minutes, and the accounts may have been renumbered
        # meanwhile (a remove): find it again by email, never by number
        store = oauth.load_store(store_path)
        k = oauth.by_identity(store["accounts"], None, got)
        if k is None:
            print(f"  That login is {got}, which is not in claude-swap: discarded.")
            return False
        if got != email.lower():
            print(f"  That login is {got}: kept for #{k} instead.")
        acc = store["accounts"][k - 1]
        if not secrets.write(oauth.VAULT, oauth.dump(o), oauth.slot(acc)):
            print("  Could not save it to the keychain: nothing changed.")
            return False
        now = time.time()
        oauth.note_login(acc, o, now, account)
        installed = in_lane = False
        if store.get("active") == k:
            mode, _ = oauth.install(store, k, secrets, live, http, now)
            if mode == "oauth":
                oauth.mark_live(store, k, mode, now, (store.get("live") or {}).get("from"))
                installed = True
        elif oauth.lane_of(store) == k:
            # the reserved sessions are on it: they move to the new login
            in_lane = oauth.lane_put(store, k, secrets, http, now)[0] == "oauth"
        oauth.commit(store_path, store,
                     top=("active", "live") + (("lane",) if in_lane else ()))
        until = f" until {day(o['refreshTokenExpiresAt'])}" if o.get("refreshTokenExpiresAt") else ""
        print(paint("32", f"  Saved: good{until}.")
              + (" Active account, so installed now: Claude in Chrome ready." if installed else ""))
        if store["accounts"][k - 1].get("reserved"):
            print("  Reserved: the reserved sessions (claude-swap run) are on it, so they moved"
                  " to this login (Claude in Chrome)." if in_lane else
                  f"  Reserved: the reserved sessions (claude-swap run) take this login when"
                  f" they are on #{k}:  claude-swap {k}")
        acc = oauth.load_store(store_path)["accounts"][k - 1]
        cp = acc.get("chrome_profile")
        if oauth.chrome_ready(acc):
            print(f"  Claude in Chrome will drive Chrome profile '{names.get(cp, cp)}'.")
        else:
            print(f"  For Claude in Chrome, sign the extension in to {got} in a Chrome"
                  " profile, then run keys-sync.")
        return True
    except KeyboardInterrupt:
        print("\n  Cancelled.")
        raise
    finally:
        secrets.delete(svc)
        oauth.restore_native_hosts(tmp)
        shutil.rmtree(tmp, ignore_errors=True)

store = oauth.load_store(store_path)
accounts = store.get("accounts", [])
if not args:
    show(store)
    sys.exit(0)
sweep()
if args[0] == "all":
    now = time.time()
    targets = [i for i, a in enumerate(accounts, 1)
               if a.get("token") and not a.get("disabled") and not is_free(a.get("plan"))
               and not a.get("reserved")  # someone's seat: one by one, auth <n>
