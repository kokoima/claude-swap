:root{
  color-scheme:light dark;
  --bg:#e7eaee; --panel:#f8f9fa; --inset:#eef1f4; --ink:#16202a; --ink2:#4e5b67; --ink3:#7d8994;
  --rule:#cbd2d9; --track:#d9dee4; --accent:#4a35d4; --on-accent:#fff; --accent-soft:#e6e2fb;
  --ok:#1d8a4c; --warn:#946d00; --bad:#c42f2a; --cyan:#0b7a8a; --mag:#a0369e;
