              f" claude-swap watch reserved {k + ' ' if k else ''}<n> <m> ...")

# a group named, or a list set: that one; else every group's
for x in ([k] if args else
          [None] + [g for g in oauth.groups_of(store) if oauth.lane_key(store, g)]):
