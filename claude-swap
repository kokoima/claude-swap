    onclick: () => { delete ui.seats[g.name]; renderGroups(); } }) : null;
  rows.push(h("div", { class: "ctl-row" }, h("span", { class: "ctl-lbl", text: "Seats" }),
    h("div", { class: "seats" }, h("label", { class: "seat all" }, all, h("span", { text: "All" })), boxes),
