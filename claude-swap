def _live_grants(r, now):
    return sorted((g for g in r["grants"] or []
                   if (g.get("left") or 0) > 0 and (g.get("ends") is None or g["ends"] > now)),
                  key=lambda g: g.get("ends") or engine.INF)


def resets_view(r, now):
    """The account's free resets: full and model ones left, and each grant
    (its id is what the reset button names); None when nothing is known
    (no valid cookie: check's ?)."""
    cd = r.get("reset_cooldown")
    out = {"eligible": r.get("eligible"), "cooldown": cd if cd and cd > now else None}
    if r["grants"] is None:  # a cache of before 1.23: counts only
        if r.get("resets") is None and r.get("resets_model") is None:
            return None
        return dict(out, full=r.get("resets") or 0, model=r.get("resets_model") or 0, grants=[])
    live = _live_grants(r, now)
    if r.get("eligible") is None and not live:
        return None
    return dict(out, full=sum(g["left"] for g in live if g.get("kind") == engine.FULL),
                model=sum(g["left"] for g in live if g.get("kind") == engine.MODEL),
                grants=[{k: g.get(k) for k in ("id", "kind", "model", "left", "ends", "clears",
                                               "five_hour", "usable_now", "by_plan")}
                        for g in live])


def account_view(store, r, now, active, col, days, lanes_on):
    n = r["n"]
    acc = store["accounts"][n - 1]
    live = bool(acc.get("token")) and not acc.get("disabled")
    st, left = oauth.worst_login(store, n, now)
    kind, at = ("free", None) if is_free(r["plan"]) else engine.billing(acc, now)
    rf = engine.model_reset_at(r, col)
    marks = engine.timeline({"r7": r["r7"], "rf": rf, "cancel_at": r["cancel_at"],
                             "down_at": r["down_at"]}, [(d["start"], d["end"]) for d in days])
    res = resets_view(r, now)
    spendable = (any(g.get("usable_now") is not False for g in res["grants"])
                 or (r["grants"] is None and (res["full"] or res["model"]))) if res else False
    lane_groups = oauth.groups_for(store, n)
    return {
        "n": n, "label": r["label"], "email": acc.get("email") or None,
        "plan": r["plan"], "plan_name": plan_name(r["plan"]), "plan_end": r["plan_end"],
        "renews": {"kind": kind, "at": at},
        "disabled": r["disabled"], "live": live, "error": r["error"],
        "rate_limited": r["rate_limited"], "src": r["src"], "known": r["known"],
        "u5": r["u5"], "u7": r["u7"], "model_pct": engine.model_pct(r, col),
        "r5": r["r5"], "r7": r["r7"], "rf": rf,
        "models": {m: {"pct": v.get("pct"), "resets_at": v.get("resets_at")}
                   for m, v in r["models"].items()},
        "resets": res, "login": {"state": st, "left": left},
        "groups": ([oauth.GENERAL] if oauth.in_general(store, n) else []) + lane_groups,
        "cl": n == active, "lanes": lanes_on.get(n, []),
        "calendar": [list(m) if m else None for m in marks],
        "can": {"use_cl": live and oauth.in_general(store, n) and n != active,
                "move_lane": [g for g in lane_groups if oauth.lane_of(store, g) != n],
                "reset": live and bool(spendable)}}


def order_view(rows, now, model, marked, order=None):
    """check's order table: the accounts in the order the engine takes them
    under order (engine.ORDERS; blocked ones last, by when they free up, but
    under libera), and why each sits there: what caduca looks at, and
    sin-cortes' room in 5h windows, and which limit cuts first and when at
    the pace the account is used now (engine.first_cut; rows with
    engine.with_rates' rate)."""
    out = []
    for e in engine.listing(rows, now, model, order or engine.CADUCA):
        b = engine.blocked(e, model)
        d = engine.deadline(e, now)
        mine = engine.grants_of(e, now, engine.MODEL, model)
        room = engine.headroom(e, model)[0]
        eta, cut = engine.first_cut(e, model)
        out.append({
            "n": e["n"], "blocked": b,
            "unblock_at": engine.unblock_at(e, model) if b else None,
            "cancel_at": e.get("cancel_at"),
            "deadline": None if d == engine.INF else d,
            "deadline_kind": (None if d == engine.INF else
                              "plan ends" if d == e.get("plan_end") else "renews"),
            "last_day": engine.tier(e, now) == 0,
            "full_reset": engine.holds_reset(e, now),
            "model_reset": mine[0].get("model") if mine else None,
            "little_room": not engine.roomy(e, now, model),
            "watch": e["n"] in marked,
            "headroom": None if room is None else round(room, 2),
            "eta_min": eta, "binding": cut})
    return out


def orders_view(rows, now, model, marked, by):
    """A group's orders: the one its watch goes by (by), and every one, by key."""
    every = {k: order_view(rows, now, model, marked, k) for k in engine.ORDER_KEYS}
    return {"order_criterion": by, "order": every[by], "orders": every}


def _now(d, watched, hint=None):
    return {"action": d["action"], "target": d.get("target"), "wake": d.get("wake"),
            "reason": d["reason"], "watched": watched,
            "hint": hint if d["action"] == "switch" and not watched else None}


def watch_view(store, g, auto):
    """A group's watch as its card shows it: on, its seats (all, or a list),
    its free resets, and the seats it may pick from."""
    cfg = oauth.watch_config(store, g, auto)
    choices = oauth.general_of(store) if g == oauth.GENERAL else oauth.groups_of(store).get(g, [])
    return {"on": cfg["on"], "resets": cfg["resets"], "all": cfg["seats"] is None,
            "seats": oauth.watch_seats(store, g), "choices": choices,
            "brief": oauth.watch_brief(store, g, auto), "clause": oauth.watch_clause(store, g),
            "settable": g == oauth.GENERAL or g in oauth.lane_group_lists(store)}


def general_card(store, rows, now, pref, auto):
    active = store.get("active", 0)
    by = oauth.watch_order(store, oauth.GENERAL)
    if oauth.has_general(store):
        d, watched = engine.general_now(rows, active, oauth.general_watch(store), now, pref,
                                        order=by)
    else:
        d, watched = engine.decide(rows, active, now, {}, False, pref, order=by), True
    t = d.get("target")
    return dict({"name": oauth.GENERAL, "kind": "general",
                 "starter": oauth.group_starter(store, oauth.GENERAL),
                 "seats": oauth.general_of(store), "on": active,
                 "watch": watch_view(store, oauth.GENERAL, auto)},
                **orders_view(rows, now, pref, oauth.watch_marked(store, oauth.GENERAL), by),
                left_out=[],
                now=_now(d, watched, ["claude-swap"] + oauth.switch_args(store, t) if t else None))


def lane_cards(store, rows, now, pref, auto, sessions):
    """A card per lane group, as check's «Reserved order» tables: its lane
    (seat, login, open sessions), its watch, its order and «Now:»."""
    out = []
    dflt = oauth.default_group(store)
    for g, ns, strays in oauth.order_tables(store):
        ln = oauth.lane_of(store, g)
        rot = oauth.rotation(store, g)
        watched = len(rot) > 1 and ln in rot
        seats = [dict(e, reserved=False) for e in rows if e["n"] in ns]
        by = oauth.watch_order(store, g)
        orders = orders_view(seats, now, pref, oauth.watch_marked(store, g), by)
        ranked = {e["n"] for e in orders["order"]}
        by_n = {r["n"]: r for r in rows}
        left_out = [{"n": n, "lane": n == ln,
                     "reason": oauth.left_out_reason(store, n, by_n[n]["error"], by_n[n]["plan"],
                                                     is_free(by_n[n]["plan"]))}
                    for n in sorted(ns + strays) if n not in ranked]
        ld = engine.lane_decide(seats, ln, rot, now, {}, False, pref, order=by) if watched else None
        if ld is None:
            ld = engine.decide(seats, ln, now, {}, False, pref, order=by)
        k = oauth.lane_key(store, g)
        d = oauth.lane_dir(None, k)
        on = [s for s in sessions if s[2] == d]
        summ = oauth.lane_summary(store, g, sessions)
        lane = {"n": ln, "mode": oauth.lane_rec(store, g).get("mode") if ln else None,
                "sessions": len(on), "names": [s[1] for s in on if s[1]],
                "pinned": sum(1 for s in sessions if not s[2]) if k is None else 0,
                "text": summ[1] if summ else None}
        t = ld.get("target")
        out.append({"name": g, "kind": "lane", "default": g == dflt,
                    "starter": oauth.group_starter(store, g), "seats": ns, "strays": strays,
                    "lane": lane, "watch": watch_view(store, g, auto), **orders,
                    "left_out": left_out,
                    "now": _now(ld, watched, ["claude-swap"] + oauth.move_args(store, t, g)
                                if t else None)})
    return out


def quota_view(store, rows, now, col, counted):
    """check's «Free quota»: per group, what is free of the 5h, the week and
    the model column, summed (100 = one whole account)."""
    kpi_model = col if counted else None
    out = []
    for name, ns in oauth.quota_groups(store):
        sub = [r for r in rows if r["n"] in ns]
        q = engine.free_quota(sub, now, kpi_model)
        if not q:
            continue
        mq = (engine.free_quota(sub, now, col) if col and not counted else None) or q
        nxt = q["next"]
        out.append({"group": name, "accounts": q["accounts"], "h5": q["h5"], "h5_n": q["h5_n"],
                    "d7": q["d7"], "d7_n": q["d7_n"], "model": mq["model"],
                    "model_n": mq["model_n"], "resets": q["resets"],
                    "next": {"at": nxt[0], "n": nxt[1], "pct": nxt[2]} if nxt else None})
    return out


def resets_holders(rows, now):
    """check's «Full resets» / «<model> resets» lines: who holds one, how
    many and when they lapse."""
    def holders(pick):
        out = []
        for r in rows:
            if r["disabled"]:
                continue
            gs = pick(r)
            if gs:
                ends = min((g["ends"] for g in gs if g.get("ends")), default=None)
                out.append({"n": r["n"], "label": r["label"], "left": sum(g["left"] for g in gs),
                            "ends": ends, "by_plan": any(g.get("by_plan") for g in gs
                                                         if g.get("ends") == ends)})
        return out
    lines = [("Full resets", engine.FULL, None,
              holders(lambda r: engine.grants_of(r, now, engine.FULL)))]
    names = sorted({g["model"] for r in rows for g in r["grants"] or []
                    if g.get("kind") == engine.MODEL and g.get("model")})
    lines += [(f"{m} resets", engine.MODEL, m,
               holders(lambda r, m=m: engine.grants_of(r, now, engine.MODEL, m))) for m in names]
    lines.append(("Model resets", engine.MODEL, None, holders(
        lambda r: [g for g in _live_grants(r, now)
                   if g.get("kind") == engine.MODEL and not g.get("model")])))
    return [{"title": t, "kind": k, "model": m, "holders": h} for t, k, m, h in lines if h]


def warnings_view(store, rows, now, credits, macos):
    """check's warnings: plans that stop, logins about to die (the watch's
    reminders), Claude in Chrome on cl's account, API credit lapsing."""
    accounts = store.get("accounts", [])
    out = []
    for r in rows:
        if r["disabled"] or not r["plan_end"]:
            continue
        acc = accounts[r["n"] - 1]
        nxt = acc.get("plan_next") or {}
        down = engine._iso(nxt.get("date")) == r["plan_end"]
        e = engine.ending({"u7": r["u7"], "r7": r["r7"]}, r["plan_end"])
        when = datetime.fromtimestamp(r["plan_end"]).strftime("%a %d %b %H:%M")
        text = (f"#{r['n']} {r['label']} {plan_name(r['plan'])} → {plan_name(nxt.get('plan'))}"
                f" on {when}" if down else
                f"#{r['n']} {r['label']} {plan_name(r['plan'])} cancelled, ends {when}")
        if e["left"] is not None:
            text += f" · {e['left']}% of this week unused"
        elif e["renews"] is not None:
            tilde = "~" if e["projected"] else ""
            text += (f" · {'last renewal' if e['projected'] else 'renews'} {tilde}"
                     + datetime.fromtimestamp(e["renews"]).strftime("%a %d %H:%M"))
        out.append({"kind": "plan", "level": "red" if r["plan_end"] - now < 86400 else "yellow",
                    "n": r["n"], "at": r["plan_end"], "down": down, "ending": e, "text": text})
    for key, msg in oauth.due_reminders(accounts, now, [], store):
        tag = key.split(":")[0]
        n, _, g = tag.partition("#")
        st, left = oauth.login_state(accounts[int(n) - 1], now, g or None)
        out.append({"kind": "login", "n": int(n), "group": g or None,
                    "level": "red" if st == "dead" or (left is not None and left < 86400)
                    else "yellow", "text": msg})
    act = store.get("active", 0)
    if isinstance(act, int) and 1 <= act <= len(accounts) and not accounts[act - 1].get("disabled"):
        st, _ = oauth.login_state(accounts[act - 1], now)
        if st != "ok":
            why = {"none": "has no full login", "dead": "lost its full login",
                   "expiring": "has a full login about to expire"}[st]
            out.append({"kind": "chrome", "n": act, "level": "yellow",
                        "text": f"Claude in Chrome: #{act} {why} · claude-swap auth {act}"})
        elif macos and not oauth.chrome_ready(accounts[act - 1]):
            out.append({"kind": "chrome", "n": act, "level": "yellow",
                        "text": f"Claude in Chrome: #{act} has its login, but no Chrome profile"
                                " has the extension signed in to it"})
    if isinstance(credits, dict) and isinstance(credits.get("accounts"), dict):
        numbers = {(a.get("email") or "").lower(): n for n, a in enumerate(accounts, 1)}
        by_tag = {f"#{numbers[em]}": s for em, s in credits["accounts"].items()
                  if em in numbers and isinstance(s, list)}
        try:
            warns = engine.credit_warnings(by_tag, now)
        except Exception:
            warns = []
        out += [{"kind": "credits", "level": level, "text": text} for level, text in warns]
        age = now - (credits.get("updated") or 0)
        if age > 86400:
            out.append({"kind": "credits", "level": "grey",
                        "text": f"API credits read {int(age // 86400)}d ago — claude-swap credits"})
    return out


def watch_state_view(store, watch):
    w = watch or {}
    s = w.get("state") if isinstance(w.get("state"), dict) else None
    alive, pid = bool(w.get("alive")), w.get("pid")
    lr = (s or {}).get("last_reset")
    return {"running": alive, "pid": pid, "stale": bool(pid) and not alive,
            "launchagent": bool(w.get("launchagent")),
            "auto_reset": bool((s or {}).get("auto_reset")),
            "started": (s or {}).get("started"), "model": (s or {}).get("model"),
            "line": oauth.watch_running(store, s or {}, pid) if alive else None,
            "lines": oauth.watch_lines(store, s) if s else [],
            "last_reset": ({k: lr.get(k) for k in ("time", "n", "label", "kind", "outcome",
                                                   "lane", "now")}
                           if isinstance(lr, dict) else None),
            "log": [redact(line) for line in w.get("log") or []]}


def web_state(store, cache, now, sessions=(), watch=None, credits=None, viewer=None,
              version="", refreshing=False, macos=None, history=None):
    """/api/state: what check shows, from what is on disk only. store: the
    store; cache: the usage cache; sessions: oauth.reserved_sessions();
    watch: {"alive", "pid", "launchagent", "state", "log"}; credits: the
    credits cache; history: the watch log's readings (oauth.usage_history),
    what sin-cortes measures R and the pace on. Built field by field: never
    a token, a cookie or a key."""
    macos = sys.platform == "darwin" if macos is None else macos
    sessions = list(sessions or [])
    pref = engine.model_setting(store)
    rows = engine.with_rates(engine_rows(store, cache, now), history or {}, now, pref)
    col, counted = model_column(rows, pref)
    days = calendar_days(now)
    active = store.get("active", 0)
    auto = bool(((watch or {}).get("state") or {}).get("auto_reset"))
    lanes_on = {}
    for g in oauth.groups_of(store):
        ln = oauth.lane_of(store, g)
        if ln:
            lanes_on.setdefault(ln, []).append(g)
    updated = (cache or {}).get("updated")
    return _finite({
        "version": version, "now": now, "viewer": viewer,
        "cache": {"updated": updated, "age": now - updated if updated else None,
                  "model": (cache or {}).get("model"), "refreshing": bool(refreshing)},
        "model": {"preferred": pref, "column": col or pref.capitalize(), "counted": counted},
        "leave": engine.LEAVE, "active": active,
        "order_criteria": [{"key": k, "label": label} for k, label in engine.ORDERS],
        "accounts": [account_view(store, r, now, active, col, days, lanes_on) for r in rows],
        "calendar": {"days": [{k: d[k] for k in ("date", "label", "start")} for d in days]},
        "free_quota": quota_view(store, rows, now, col, counted),
        "groups": [general_card(store, rows, now, pref, auto)]
                  + lane_cards(store, rows, now, pref, auto, sessions),
        "ungrouped": oauth.ungrouped(store) if oauth.has_general(store) else [],
        "shared_note": oauth.shared_note(store),
        "warnings": warnings_view(store, rows, now, credits, macos),
        "resets": resets_holders(rows, now),
        "watch": watch_state_view(store, watch)})


# ---------- the whitelist ----------

def _live_n(store, x):
    """(n, None) for an account number as typed that is live, or (None, why)."""
    accounts = store.get("accounts", [])
    if not isinstance(x, str) or not N_RE.match(x) or int(x) > len(accounts):
        return None, f"there is no account {x}"
    n = int(x)
    a = accounts[n - 1]
    if a.get("disabled") or not a.get("token"):
        return None, f"account {n} is disabled or has no token"
    return n, None


def _kind_ok(rows, kind):
    """A kind `reset` takes: full, or the name of a model some account has."""
    if not isinstance(kind, str) or kind.startswith("-") or N_RE.match(kind):
        return False
    names = {m.lower() for r in rows for m in r["models"]}
    names |= {(g.get("model") or "").lower() for r in rows for g in r["grants"] or []}
    return kind.lower() == engine.FULL or kind.lower() in names - {""}


def reset_argv(store, rows, args, confirm, previewed):
    """reset <n> [kind] --grant <id> --yes, exactly: a grant the account holds
    (the state's) or one a preview just showed, and «si» typed."""
    if len(args) not in (5, 6) or args[-3] != "--grant" or args[-1] != "--yes":
        return None, "a reset is: reset <n> [kind] --grant <id> --yes"
    n, err = _live_n(store, args[1])
    if err:
        return None, err
    kind, gid = (args[2] if len(args) == 6 else None), args[-2]
    if not GRANT_RE.match(gid):
        return None, f"{gid} is no reset id"
    if kind is not None and not _kind_ok(rows, kind):
        return None, f"{kind} is no kind of reset (full, or a model's name)"
    if str(confirm or "").strip().lower() not in CONFIRM:
        return None, "a reset cannot be undone: type si to spend it"
    held = next((g for g in rows[n - 1]["grants"] or [] if g.get("id") == gid), None)
    if held is not None:
        if kind is not None and (kind.lower() != engine.FULL if held.get("kind") == engine.FULL
                                 else kind.lower() != (held.get("model") or "").lower()):
            return None, f"reset {gid} is not a {kind} one"
        return args, None
    if (n, gid) in previewed:
        return args, None
    return None, f"#{n} holds no reset {gid} (preview it first)"


def action_argv(store, rows, args, confirm=None, previewed=()):
    """The claude-swap arguments /api/action may run, checked against the
    store and the rows: -> (args, None), or (None, why). Only these pass:
    <n> general (cl), <n> <group> (that group's lane), watch <g> on|off |
    seats <n> <n>...|all | resets on|off | order <key>, watch start
    [--auto-reset], watch stop, and reset <n> [kind] --grant <id> --yes once
    «si» is typed."""
    if (not isinstance(args, list) or not args or len(args) > 40
            or not all(isinstance(a, str) for a in args)):
        return None, "args must be a list of words"
    head, rest = args[0], args[1:]
    if N_RE.match(head):
        if len(rest) != 1:
            return None, "say the account and where: <n> general, or <n> <group>"
        n, err = _live_n(store, head)
        if err:
            return None, err
        g = rest[0]
        if g == oauth.GENERAL:
            return (args, None) if oauth.in_general(store, n) else (None, f"#{n} is not in general")
        lanes = oauth.groups_of(store)
        if g not in lanes:
            return None, f"there is no group {g}"
        return (args, None) if n in lanes[g] else (None, f"#{n} is not in {g}")
    if head == "watch":
        if rest in (["start"], ["start", "--auto-reset"], ["stop"]):
            return args, None
        if not rest or (rest[0] != oauth.GENERAL and rest[0] not in oauth.lane_group_lists(store)):
            return None, f"there is no group {rest[0] if rest else ''}".rstrip()
        g, cmd = rest[0], rest[1:]
        if cmd in (["on"], ["off"], ["seats", "all"]) or (
                len(cmd) == 2 and cmd[0] == "resets" and cmd[1] in ("on", "off")) or (
                len(cmd) == 2 and cmd[0] == "order" and cmd[1] in engine.ORDER_KEYS):
            return args, None
        if cmd[:1] == ["seats"] and len(cmd) >= 3:
            seats = (oauth.general_of(store) if g == oauth.GENERAL
                     else oauth.groups_of(store).get(g, []))
            picked = []
            for x in cmd[1:]:
                n, err = _live_n(store, x)
                if err:
                    return None, err
                if n not in seats or n in picked:
                    return None, f"#{n} is not a seat of {g}, or twice"
                picked.append(n)
            return args, None
        return None, (f"watch {g} takes on, off, seats <n> <n>... | all, resets on|off,"
                      " or order " + "|".join(engine.ORDER_KEYS))
    if head == "reset":
        return reset_argv(store, rows, args, confirm, previewed)
    return None, f"{head} is not something this page runs"


def preview_argv(store, rows, n, kind=None, grant=None):
    """reset <n> [kind] [--grant <id>] --preview: what `reset` shows before
    it asks, and the grant it would spend; never spends."""
    k, err = _live_n(store, n)
    if err:
        return None, err
    if kind is not None and not _kind_ok(rows, kind):
        return None, f"{kind} is no kind of reset (full, or a model's name)"
    if grant is not None and (not isinstance(grant, str) or not GRANT_RE.match(grant)):
        return None, f"{grant} is no reset id"
    return (["reset", n] + ([kind] if kind else []) + (["--grant", grant] if grant else [])
            + ["--preview"]), None


# ---------- the server ----------

def tailscale_self(exe=None, run=subprocess.run):
    """(the owner's login, this node's names) from `tailscale status --json`,
    or (None, []) without it. CLAUDE_SWAP_TAILSCALE names the binary ("none":
    no tailscale)."""
    exe = exe if exe is not None else os.environ.get("CLAUDE_SWAP_TAILSCALE")
    if exe is None:
        exe = shutil.which("tailscale") or next((p for p in TS_PATHS if os.path.exists(p)), None)
    if not exe or exe == "none":
        return None, []
    try:
        d = json.loads(run([exe, "status", "--json"], capture_output=True, text=True,
                           timeout=10).stdout)
        me = d.get("Self") or {}
        user = (d.get("User") or {}).get(str(me.get("UserID"))) or {}
        names = [me.get("DNSName")] + list(d.get("CertDomains") or [])
    except Exception:
        return None, []
    return (user.get("LoginName") or None,
            sorted({h.strip().rstrip(".").lower() for h in names if isinstance(h, str) and h.strip()}))


def tailscale_nodes(exe=None, run=subprocess.run):
    """{ip: {"id": stable node ID, "host": HostName, "label": DNS label,
    "login", "os"}} for this node and every peer of `tailscale status
    --json`, or {} on any failure (same binary rules as tailscale_self)."""
    exe = exe if exe is not None else os.environ.get("CLAUDE_SWAP_TAILSCALE")
    if exe is None:
        exe = shutil.which("tailscale") or next((p for p in TS_PATHS if os.path.exists(p)), None)
    if not exe or exe == "none":
        return {}
    out = {}
    try:
        d = json.loads(run([exe, "status", "--json"], capture_output=True, text=True,
                           timeout=10).stdout)
        users = d.get("User") or {}
        for node in [d.get("Self") or {}] + list((d.get("Peer") or {}).values()):
            host = node.get("HostName")
            host = host.strip() if isinstance(host, str) else ""
            dns = node.get("DNSName")
            label = dns.strip().rstrip(".").split(".")[0] if isinstance(dns, str) else ""
            login = (users.get(str(node.get("UserID"))) or {}).get("LoginName") or None
            for ip in node.get("TailscaleIPs") or []:
                if isinstance(ip, str):
                    out[ip.strip()] = {"id": str(node.get("ID") or ""), "host": host,
                                       "label": label,
                                       "login": login,
                                       "os": node.get("OS") or ""}
    except Exception:
        return {}
    return out


def _read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return None


def _tail(path, n):
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - 32768))
            lines = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return []
    return lines[-n:]


def _hostname(host):
    host = (host or "").strip().lower()
    if host.startswith("["):
        return host[1:host.find("]")] if "]" in host else ""
    return host.rsplit(":", 1)[0] if host.count(":") == 1 else host


# The page (HTML, CSS and JavaScript) is the body of _web_page in the script;
# cmd_web_serve hands it over here. Taken out of the environment, so the
# commands the server runs never inherit it.
PAGE = os.environ.pop("CLAUDE_SWAP_WEB_PAGE", "") or (
    "<!doctype html><meta charset=utf-8><title>claude-swap</title>"
    "<p>The page comes with the script: start it with claude-swap web.</p>")


class App:
    """The web's requests: handle() takes one and gives (status, headers,
    body). Everything outside comes in as arguments, so tests can replay a
    request without a socket: run (subprocess.run) for the actions, popen
    for the background check, sessions for oauth.reserved_sessions, clock."""

    def __init__(self, store_path, bin_path, version="", owner=None, ts_hosts=(), home=None,
                 run=subprocess.run, popen=subprocess.Popen, sessions=None, clock=time.time,
                 log=None, tailscale=None, port=None, nodes=None):
        self.store_path, self.bin, self.version = store_path, bin_path, version
        self.owner = owner
        self.port = port  # the one it listens on, which tailscale serve serves it on too
        self.ts_hosts = {h.strip().rstrip(".").lower() for h in ts_hosts if h}
        home = home or os.path.expanduser("~")
        c = os.path.join(home, ".claude")
        self.paths = {
            "cache": os.path.join(c, "claude-swap-usage.json"),
            "lock": os.path.join(c, "claude-swap-usage.lock"),  # the statusline's
            "credits": os.path.join(c, "claude-swap-credits.json"),
            "watch_pid": os.path.join(c, "claude-swap-watch.pid"),
            "watch_state": os.path.join(c, "claude-swap-watch.state"),
            "watch_log": os.path.join(c, "claude-swap-watch.log"),
            "watch_plist": os.path.join(home, "Library", "LaunchAgents",
                                        "com.claude-swap.watch.plist")}
        self.run, self.popen, self.clock = run, popen, clock
        self.sessions = sessions or oauth.reserved_sessions
        self.log = log or (lambda msg: print(msg, flush=True))
        self.tailscale, self.ts_tried = tailscale, clock()
        self.nodes_fn = nodes if nodes is not None else tailscale_nodes
        self.nodes_cache = (None, {})          # (when read, the map)
        self.secret = secrets.token_bytes(32)  # sessions last as long as the server
        self.busy = threading.Lock()           # one command at a time
        self.previews = {}                     # (n, grant id) -> when a preview showed it
        self.last_refresh = None               # when the last refresh it started began

    # who may use it

    def _retry_tailscale(self):
        """A server started before tailscale was up learns its owner later."""
        if self.owner or not self.tailscale or self.clock() - self.ts_tried < 60:
            return
        self.ts_tried = self.clock()
        owner, hosts = self.tailscale()
        if owner:
            self.owner = owner
            self.ts_hosts |= set(hosts)

    def allowed(self, store):
        web = store.get("web") if isinstance(store.get("web"), dict) else {}
        listed = web.get("allow")
        if isinstance(listed, list):
            return {s.strip().lower() for s in listed if isinstance(s, str) and s.strip()}
        return {self.owner.lower()} if self.owner else set()

    def hosts(self, store):
        web = store.get("web") if isinstance(store.get("web"), dict) else {}
        extra = web.get("hosts") if isinstance(web.get("hosts"), list) else []
        return (set(LOCAL_HOSTS) | self.ts_hosts
                | {h.strip().rstrip(".").lower() for h in extra if isinstance(h, str)})

    def devices(self, store):
        """The store's web.devices (node IDs, or IPs) as a lowercase set, or
        None when absent (any device of the allowed logins)."""
        web = store.get("web") if isinstance(store.get("web"), dict) else {}
        if "devices" not in web:
            return None
        listed = web["devices"]
        if not isinstance(listed, list):
            return set()  # present but unreadable: fail closed
        return {s.strip().lower() for s in listed if isinstance(s, str) and s.strip()}

    def nodes(self):
        when, got = self.nodes_cache
        if when is None or self.clock() - when >= 60:
            try:
                got = self.nodes_fn() or {}
            except Exception:
                got = {}
            self.nodes_cache = (self.clock(), got)
        return got

    def device_ok(self, h, store):
        listed = self.devices(store)
        if listed is None:
            return True
        # the last entry is the one tailscale serve appended
        ip = (h.get("x-forwarded-for") or "").split(",")[-1].strip().lower()
        if ip and ip in listed:
            return True
        # a node is its stable ID: names are self-reported and not unique
        info = self.nodes().get(ip) if ip else None
        return bool(info and info.get("id") and info["id"].lower() in listed)

    def identify(self, h, client, store):
        if client not in LOOPBACK:
            return None, "only this Mac and tailscale serve reach this server"
        login = (h.get("tailscale-user-login") or "").strip()
        if login:
            # tailscale serve always adds X-Forwarded-For: without it the
            # login was typed by whoever sent the request on this Mac
            if not h.get("x-forwarded-for"):
                return None, "a Tailscale login that did not come through tailscale serve"
            self._retry_tailscale()
            if login.lower() in self.allowed(store):
                if not self.device_ok(h, store):
                    return None, "this device may not use this page (claude-swap web devices)"
                return {"login": login, "name": h.get("tailscale-user-name") or None,
                        "local": False}, None
            return None, f"{login} may not use this page"
        if any(h.get(k) for k in ("x-forwarded-for", "forwarded", "x-forwarded-host")):
            return None, "a request through a proxy needs a Tailscale login"
        if _hostname(h.get("host")) not in LOCAL_HOSTS:
            return None, ("a tailnet request without tailscale serve's headers: serve this port"
                          " in HTTP mode (tailscale serve --https=N http://127.0.0.1:N)")
        return {"login": None, "name": None, "local": True}, None

    def origin_ok(self, h, viewer, store):
        """A POST's Origin: one of this server's hosts, and the very one the
        request went to (Host, or the proxy's X-Forwarded-Host); through
        tailscale serve with neither, the node's own name on this server's
        port only: other ports of that name serve other things."""
        o = h.get("origin")
        if not o:
            return False
        try:
            u = urlsplit(o)
            host, netloc = (u.hostname or "").lower(), u.netloc.lower()
            port = u.port or (443 if u.scheme == "https" else 80)
        except ValueError:
            return False
        if u.scheme not in ("http", "https") or host not in self.hosts(store):
            return False
        if netloc in {(h.get("host") or "").lower(), (h.get("x-forwarded-host") or "").lower()}:
            return True
        return (not viewer["local"] and u.scheme == "https" and host in self.ts_hosts
                and self.port is not None and port == self.port)

    def token(self, sid, viewer):
        who = f"{(viewer['login'] or '').lower()}\n{viewer['local']}"
        return hmac.new(self.secret, f"{sid}\n{who}".encode(), hashlib.sha256).hexdigest()

    def csrf_ok(self, h, sid, viewer):
        return bool(sid) and hmac.compare_digest(
            (h.get("x-csrf-token") or "").encode(), self.token(sid, viewer).encode())

    # replies

    def _reply(self, status, body, ctype, extra=()):
        headers = [("Content-Type", ctype), ("Cache-Control", "no-store"),
                   ("X-Content-Type-Options", "nosniff"), ("X-Frame-Options", "DENY"),
                   ("Referrer-Policy", "no-referrer")]
        if not any(k == "Content-Security-Policy" for k, _ in extra):
            headers.append(("Content-Security-Policy", "default-src 'none'; frame-ancestors 'none'"))
        return status, headers + list(extra), body

    def _json(self, status, obj, extra=()):
        return self._reply(status, json.dumps(_finite(obj)).encode(),
                           "application/json; charset=utf-8", extra)

    def _error(self, status, why):
        return self._json(status, {"error": why})

    def too_large(self):
        return self._json(413, {"error": "request too large"}, [("Connection", "close")])

    def length_required(self):
        return self._json(411, {"error": "send a Content-Length, not a Transfer-Encoding"},
                          [("Connection", "close")])

    def _cookie(self, h, sid):
        secure = "; Secure" if (h.get("x-forwarded-proto") or "").lower() == "https" else ""
        return ("Set-Cookie", f"{COOKIE}={sid}; Path=/; HttpOnly; SameSite=Strict{secure}")

    # the requests

    def handle(self, method, target, headers, client, body=b""):
        try:
            return self._handle(method, target, headers, client, body)
        except Exception as e:  # never a traceback to the browser
            self.log(f"[{datetime.now():%Y-%m-%d %H:%M:%S}] web: {type(e).__name__}"
                     f" on {method} {urlsplit(target).path}")
            return self._error(500, "internal error")

    def _handle(self, method, target, headers, client, body):
        h = {}
        for k, v in headers:
            k = k.lower()
            if k in h and k in ONCE:
                return self._error(400, f"{k} sent twice")
            h[k] = v
        if "transfer-encoding" in h:
            return self.length_required()
        store = oauth.load_store(self.store_path)
        viewer, why = self.identify(h, client, store)
        if viewer is None:
            return self._error(403, why)
        if _hostname(h.get("host")) not in self.hosts(store):
            return self._error(403, "not a host of this server")
        url = urlsplit(target)
        # a link clicked in webmail is a cross-site GET of the page itself,
        # which changes nothing (frame-ancestors stops embedding)
        if ((h.get("sec-fetch-site") or "").lower() == "cross-site"
                and not (method == "GET" and url.path == "/")):
            return self._error(403, "a request from another site")
        routes = {"/": "GET", "/api/state": "GET", "/api/reset-preview": "GET",
                  "/api/refresh": "POST", "/api/action": "POST"}
        if url.path not in routes:
            return self._error(404, "not found")
        if method != routes[url.path]:
            return self._reply(405, b"", "text/plain", [("Allow", routes[url.path])])
        m = re.search(rf"(?:^|;)\s*{COOKIE}=([^;]*)", h.get("cookie") or "")
        sid = m.group(1).strip() if m and SID_RE.match(m.group(1).strip()) else None
        if url.path in ("/", "/api/state"):
            extra = [] if sid else [self._cookie(h, secrets.token_urlsafe(32))]
            sid = sid or extra[0][1].split(";")[0].split("=", 1)[1]
            if url.path == "/":
                return self.page(extra)
            return self.state(store, viewer, sid, extra)
        if url.path == "/api/reset-preview":
            if not self.csrf_ok(h, sid, viewer):
                return self._error(403, "no valid session token")
            q = {k: v[0] for k, v in parse_qs(url.query).items()}
            return self.preview(store, viewer, q.get("n"), q.get("kind"), q.get("grant"))
        # POST
        if not self.origin_ok(h, viewer, store):
            return self._error(403, "not an origin of this server")
        if not self.csrf_ok(h, sid, viewer):
            return self._error(403, "no valid session token")
        if len(body) > MAX_BODY:
            return self.too_large()
        if not (h.get("content-type") or "").lower().startswith("application/json"):
            return self._error(415, "send JSON")
        try:
            data = json.loads(body or b"{}")
        except ValueError:
            return self._error(400, "not JSON")
        if not isinstance(data, dict):
            return self._error(400, "send a JSON object")
        if url.path == "/api/refresh":
            return self._json(200, self.refresh())
        argv, err = action_argv(store, self.rows(store), data.get("args"), data.get("confirm"),
                                self.previewed())
        if err:
            return self._error(400, err)
        return self.execute(argv, viewer)

    def page(self, extra):
        nonce = secrets.token_urlsafe(16)
        csp = (f"default-src 'none'; script-src 'nonce-{nonce}'; style-src 'nonce-{nonce}';"
               " connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none';"
               " frame-ancestors 'none'")
        return self._reply(200, PAGE.replace("__NONCE__", nonce).encode(),
                           "text/html; charset=utf-8",
                           list(extra) + [("Content-Security-Policy", csp)])

    def rows(self, store):
        return engine_rows(store, _read_json(self.paths["cache"]), self.clock())

    def watch(self):
        pid, alive = None, False
        try:
            with open(self.paths["watch_pid"]) as f:
                pid = int(f.read().split()[0])
            os.kill(pid, 0)
            alive = True
        except PermissionError:
            alive = True
        except (OSError, ValueError, IndexError):
            pass
        return {"alive": alive, "pid": pid, "launchagent": os.path.exists(self.paths["watch_plist"]),
                "state": _read_json(self.paths["watch_state"]),
                "log": _tail(self.paths["watch_log"], LOG_LINES)}

    def refreshing(self):
        lock = self.paths["lock"]
        try:
            return os.path.isdir(lock) and time.time() - os.path.getmtime(lock) < LOCK_TTL
        except OSError:
            return False

    def state(self, store, viewer, sid, extra):
        try:
            sessions = self.sessions()
        except Exception:
            sessions = []
        now = self.clock()
        try:
            history = oauth.usage_history(self.paths["watch_log"], now)
        except Exception:
            history = {}
        s = web_state(store, _read_json(self.paths["cache"]), now, sessions,
                      self.watch(), _read_json(self.paths["credits"]), viewer, self.version,
                      self.refreshing(), history=history)
        s["csrf"] = self.token(sid, viewer)
        return self._json(200, s, extra)

    def env(self):
        e = {k: v for k, v in os.environ.items() if k != "CLAUDE_SWAP_WEB"}
        e["NO_COLOR"] = "1"
        return e

    def refresh(self):
        """check in the background, under the statusline's lock (a directory:
        one refresh at a time, whoever asks), which it removes when done.
        Not while the data, or the last refresh this server started, is less
        than REFRESH_EVERY old: a check reads claude.ai once per account."""
        now = self.clock()
        updated = (_read_json(self.paths["cache"]) or {}).get("updated")
        ages = [max(0, now - t) for t in (updated, self.last_refresh)
                if isinstance(t, (int, float)) and not isinstance(t, bool)]
        if ages and min(ages) < REFRESH_EVERY:
            wait = int(math.ceil(REFRESH_EVERY - min(ages)))
            return {"started": False, "wait": wait,
                    "reason": f"the data is {int(min(ages))} s old: refresh again in {wait} s"}
        lock = self.paths["lock"]
        try:
            if os.path.isdir(lock):
                if time.time() - os.path.getmtime(lock) < LOCK_TTL:
                    return {"started": False, "reason": "a refresh is already running"}
                os.rmdir(lock)
            os.mkdir(lock)
        except OSError:
            return {"started": False, "reason": "could not take the refresh lock"}
        try:
            self.popen(["/bin/sh", "-c", '"$0" check >/dev/null 2>&1; rmdir "$1" 2>/dev/null',
                        self.bin, lock], start_new_session=True, stdin=subprocess.DEVNULL,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=self.env())
        except Exception:
            try:
                os.rmdir(lock)
            except OSError:
                pass
            return {"started": False, "reason": "could not start check"}
        self.last_refresh = now
        return {"started": True}

    def previewed(self):
        now = self.clock()
        self.previews = {k: t for k, t in self.previews.items() if now - t < PREVIEW_TTL}
        return set(self.previews)

    def _who(self, viewer):
        return viewer["login"] or "this Mac"

    def execute(self, argv, viewer):
        if not self.busy.acquire(blocking=False):
            return self._error(409, "another command is running: try again in a moment")
        try:
            stamp = f"[{datetime.now():%Y-%m-%d %H:%M:%S}] web:"
            self.log(f"{stamp} {self._who(viewer)} runs claude-swap {' '.join(argv)}")
            try:
                r = self.run([self.bin, *argv], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                             stderr=subprocess.STDOUT, text=True, errors="replace",
                             timeout=ACTION_TIMEOUT, env=self.env())
                code, out = r.returncode, r.stdout or ""
            except subprocess.TimeoutExpired as e:
                out = e.stdout.decode("utf-8", "replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
                code, out = None, out + f"\n(stopped after {ACTION_TIMEOUT} s)"
            except OSError as e:
                code, out = None, f"could not run claude-swap ({e.strerror})"
            self.log(f"{stamp} claude-swap {' '.join(argv)} -> {code}")
            return self._json(200, {"ok": code == 0, "code": code, "argv": ["claude-swap", *argv],
                                    "output": redact(out)[-OUTPUT_MAX:]})
        finally:
            self.busy.release()

    def preview(self, store, viewer, n, kind, grant):
        """What `claude-swap reset` shows before it asks (it reads claude.ai,
        spends nothing), and the grant it would spend, which /api/action
        then takes with «si» for a while."""
        argv, err = preview_argv(store, self.rows(store), n, kind, grant)
        if err:
            return self._error(400, err)
        if not self.busy.acquire(blocking=False):
            return self._error(409, "another command is running: try again in a moment")
        try:
            r = self.run([self.bin, *argv], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                         stderr=subprocess.PIPE, text=True, errors="replace",
                         timeout=PREVIEW_TIMEOUT, env=self.env())
            code, out, said = r.returncode, r.stdout or "", r.stderr or ""
        except subprocess.TimeoutExpired:
            code, out, said = None, "", f"(no answer after {PREVIEW_TIMEOUT} s)"
        except OSError as e:
            code, out, said = None, "", f"could not run claude-swap ({e.strerror})"
        finally:
            self.busy.release()
        last = out.strip().splitlines()[-1:] if code == 0 else []
        got = last[0].strip() if last and GRANT_RE.match(last[0].strip()) else None
        if got:
            self.previews[(int(n), got)] = self.clock()
        spend = (["reset", n] + ([kind] if kind else []) + ["--grant", got, "--yes"]) if got else None
        return self._json(200, {"ok": bool(got), "code": code,
                                "text": redact(said + ("" if got else out))[-OUTPUT_MAX:],
                                "grant": got, "argv": spend})


def make_server(app, port):
    """The HTTP server for app on 127.0.0.1:port (OSError if it is taken).
    It reads a body by Content-Length only (a Transfer-Encoding is refused,
    411) and up to MAX_BODY (413), closing the connection on either."""
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    class Handler(BaseHTTPRequestHandler):
        server_version, sys_version = "claude-swap-web", ""
        protocol_version = "HTTP/1.1"
        timeout = 120

        def _go(self):
            try:
                length = int(self.headers.get("Content-Length") or 0)
            except ValueError:
                length = -1
            if self.headers.get("Transfer-Encoding"):
                status, hdrs, out = app.length_required()
                self.close_connection = True
            elif length < 0 or length > MAX_BODY:
                status, hdrs, out = app.too_large()
                self.close_connection = True
            else:
                body = self.rfile.read(length) if length else b""
                status, hdrs, out = app.handle(self.command, self.path, self.headers.items(),
                                               self.client_address[0], body)
            self.send_response(status)
            for k, v in hdrs:
                self.send_header(k, v)
            self.send_header("Content-Length", str(len(out)))
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(out)

        do_GET = do_POST = do_PUT = do_DELETE = do_PATCH = do_HEAD = do_OPTIONS = _go

        def log_message(self, *args):
            pass  # the actions log themselves; no headers or cookies in the log

    httpd = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    httpd.daemon_threads = True
    return httpd


def main(store_path, bin_path, version, port, pid_path, home=None):
    """claude-swap web --foreground: serve on 127.0.0.1:port until stopped
    (SIGTERM: launchctl bootout, web stop), with a pidfile "<pid> <port>"."""
    owner, hosts = tailscale_self()
    app = App(store_path, bin_path, version, owner, hosts, home, tailscale=tailscale_self,
              port=port)
    try:
        httpd = make_server(app, port)
    except OSError as e:
        print(f"claude-swap web: cannot listen on 127.0.0.1:{port} ({e.strerror})", flush=True)
        return 1
    mine = f"{os.getpid()} {port}\n"
    with open(pid_path, "w") as f:
        f.write(mine)

    def stop(*_):
        raise SystemExit(0)
    signal.signal(signal.SIGTERM, stop)
    print(f"[{datetime.now():%Y-%m-%d %H:%M:%S}] claude-swap web {version} on"
          f" http://127.0.0.1:{port} — "
          + (f"tailnet owner {owner}" if owner else "no tailscale owner: this Mac only"),
          flush=True)
    try:
        httpd.serve_forever()
    except (SystemExit, KeyboardInterrupt):
        pass
    finally:
        httpd.server_close()
        try:
            with open(pid_path) as f:
                if f.read() == mine:
                    os.remove(pid_path)
        except OSError:
            pass
    return 0
