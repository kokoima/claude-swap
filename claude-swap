else:
    print(f"Usage: claude-swap auth [n|all]   (n in 1-{len(accounts)})")
    sys.exit(1)
done = 0
try:
    for j, n in enumerate(targets):
        if j:
            nxt = accounts[n - 1]
            if input(f"\nEnter for #{n} {nxt.get('email')}, q to stop: ").strip().lower() == "q":
