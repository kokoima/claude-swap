.vx .x-wk .x-past{background:repeating-linear-gradient(135deg,transparent 0 6px,color-mix(in srgb,var(--ink3) 10%,transparent) 6px 7px)}
.vx .x-wk .x-corner{position:sticky;left:0;top:0;z-index:4;background:var(--inset)}
.vx .x-ev{display:block;font:600 11px/1.25 var(--f-mono);padding:2px 5px;border-radius:4px;margin:0 0 3px;white-space:nowrap;border-left:3px solid}
