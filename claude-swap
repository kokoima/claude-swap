oauth = types.ModuleType("oauth")
exec(os.environ["CLAUDE_SWAP_OAUTH"], oauth.__dict__)

store_path, args = sys.argv[1], sys.argv[2:]
store = oauth.load_store(store_path)
accounts = store.get("accounts", [])
names = oauth.profile_names()

def is_free(tier):
    t = (tier or "").lower()
