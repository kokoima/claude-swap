cmd_interactive() {
  check_store
  cmd_status
  echo ""
  _deep_check
  echo ""

  local count choice order=""
  count=$(python3 -c "import json; print(len(json.load(open('$STORE'))['accounts']))")

  # o shows the order tables by the next order, o<n> by the n-th
  # (engine.ORDERS), redrawn from the cache the check above left
  while true; do
    read -r -p "Switch? (1-$count · a=auto · af=auto (model fable) · wg=watch · wr=watch+resets · wf=watch (model fable) · wp=stop · ws=status · o=order (o1-o5) · Enter=exit) " choice || choice=""
    case "$choice" in
      o|o[0-9]*)
        order=$(_menu_order "$choice" "$order") || break
        echo ""
        _deep_check "$order" replay
        echo ""
        ;;
      *) break ;;
    esac
  done

  case "$choice" in
    "") exit 0 ;;
    auto|a) cmd_auto general ;;
    af) _fable_alias; cmd_auto general ;;
    wf) _fable_alias; cmd_watch_start general ;;
    wg) cmd_watch_start general ;;
    wr) cmd_watch_start general --auto-reset ;;
    wp) cmd_watch_stop ;;
    ws) cmd_watch_status ;;
    [0-9]*) _do_rotate "$choice" "$(_menu_group "$choice")" ;;
    *) echo "Invalid choice: $choice" ;;
  esac
}

_menu_order() {
  # The order the menu's o ($1: o, the next one after $2, the order shown,
  # or after general's watch's while none was picked; o<n>, the n-th) picks,
  # of engine.ORDERS; fails for any other o<n>
  python3 - "$1" "${2:-}" "$STORE" <<'PYEOF'
import os, sys, types

engine = types.ModuleType("engine")
exec(os.environ["CLAUDE_SWAP_ENGINE"], engine.__dict__)
oauth = types.ModuleType("oauth")
exec(os.environ["CLAUDE_SWAP_OAUTH"], oauth.__dict__)
keys, (pick, shown, store_path) = engine.ORDER_KEYS, sys.argv[1:4]
if not shown:
    try:
        shown = oauth.watch_order(oauth.load_store(store_path), oauth.GENERAL)
    except Exception:
        shown = engine.CADUCA
if pick == "o":
    print(keys[(keys.index(shown) + 1) % len(keys)] if shown in keys else keys[1])
elif pick[1:].isdigit() and 1 <= int(pick[1:]) <= len(keys):
    print(keys[int(pick[1:]) - 1])
else:
    sys.exit(1)
PYEOF
}

_menu_group() {
  # The group the menu's "Switch?" names for account $1: general (the shared
  # login) for an account in general, so that it moves cl from a lane's
  # session too (where a bare number of a seat in general and in that lane's
  # group is refused); none for one out of general, whose lane moves, as up
  # to 1.21.
  python3 - "$STORE" "$1" <<'PYEOF'
import os, sys, types

oauth = types.ModuleType("oauth")
exec(os.environ["CLAUDE_SWAP_OAUTH"], oauth.__dict__)

store = oauth.load_store(sys.argv[1])
n = int(sys.argv[2]) if sys.argv[2].isdigit() else 0
print(oauth.GENERAL if 1 <= n <= len(store.get("accounts", []))
      and oauth.in_general(store, n) else "")
PYEOF
}

