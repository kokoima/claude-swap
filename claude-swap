#!/usr/bin/env bash
#
# claude-swap — Rotate between multiple Claude Max accounts in Claude Code
#
# https://github.com/kokoima/claude-swap
#
# Usage:
#   claude-swap              Interactive: status + check + select
#   claude-swap <n>          Rotate to account N
#   claude-swap status       Show current account state
#   claude-swap check [--order <key>]  Status + API rate limit check, orders by <key>
#   claude-swap auto         Auto-rotate to best available account
#   claude-swap reset <n> [full|fable]  Spend account N's free limit reset
#   claude-swap model [name] Model the sessions use (fable, opus...): its weekly limit counts
#   claude-swap credits [n]  API credits per account (Console): included credit and when it lapses, purchased, month spend
#   claude-swap auth [n|all] Full login per account (needed by Claude in Chrome)
#   claude-swap chrome [n]   Open the account's Chrome profile
#   claude-swap web [start|stop|status]  The dashboard as a web page (127.0.0.1)
#   claude-swap add          Add a new account
#   claude-swap remove <n>   Remove an account
#   claude-swap init         First-time setup
#   claude-swap version      Show version

set -e

VERSION="1.24.1"
STORE="${CLAUDE_SWAP_STORE:-$HOME/.claude/claude-swap.json}"
# A session of `claude-swap run` on a full login has its lane's own
# CLAUDE_CONFIG_DIR, which the commands it runs inherit: claude-swap itself
# always works on the shared login. The dir is kept in CLAUDE_SWAP_FROM_DIR,
# which tells `claude-swap <n>` whose lane the session it runs in is on.
unset CLAUDE_SWAP_FROM_DIR
case "${CLAUDE_CONFIG_DIR:-}" in
  "${CLAUDE_SWAP_RUN:-$HOME/.claude-swap/run}"/*)
    export CLAUDE_SWAP_FROM_DIR="$CLAUDE_CONFIG_DIR"
    unset CLAUDE_CONFIG_DIR ;;
esac
# Claude Code's files, where it looks for them (CLAUDE_CONFIG_DIR moves both)
CLAUDE_CREDS="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.credentials.json"
if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
  CLAUDE_JSON="$CLAUDE_CONFIG_DIR/.claude.json"
else
  CLAUDE_JSON="$HOME/.claude.json"
fi
WATCH_PID="$HOME/.claude/claude-swap-watch.pid"
WATCH_LOG="$HOME/.claude/claude-swap-watch.log"
WATCH_STATE="$HOME/.claude/claude-swap-watch.state"
IS_MACOS=false
[ "$(uname -s)" = "Darwin" ] && IS_MACOS=true

# --- Decision engine (general strategy) ---
# Which account to be on, shared by check, auto and watch: each Python block
# runs exec(os.environ["CLAUDE_SWAP_ENGINE"]). Pure — rows in, decision out,
# the clock passed in — so tests/test_engine.py can replay any situation.
read -r -d '' ENGINE_PY <<'PYEOF' || true
# A row: n, label, u5/u7 (% or None), r5/r7 (window resets, epoch or None),
# plan_end (cancellation or downgrade, epoch or None), cancel_at (when a
# cancelled plan stops, epoch or None), free, disabled, reserved, error,
# rate_limited, resets (spendable count or None), resets_ends (when they
# lapse, epoch or None), reset_cooldown (epoch or None).
#
# Consume first the quota that is lost first. A week is lost at its renewal,
# or earlier if the plan stops, so that is each account's deadline. Within
# that: quota that dies within a day goes first (now or never), then accounts
# holding a free reset (reaching the limit early is what makes the reset
# worth a whole week), then the rest.

def _leave_setting(default=98):
    """LEAVE override: CLAUDE_SWAP_LEAVE, else ~/.claude/claude-swap-leave.

    100 squeezes the last 2% of every account: it is left only at its hard
    limit or on a 429, at the price of the odd rejected request. Anything
    that is not a number in (0, 100] falls back to the default. Read once
    per process, so a running watch needs a restart to pick a change up."""
    import os
    v = os.environ.get("CLAUDE_SWAP_LEAVE")
    if not v:
        try:
            with open(os.path.expanduser("~/.claude/claude-swap-leave")) as f:
                v = f.read().strip()
        except OSError:
            v = None
    try:
        x = float(v) if v else default
    except ValueError:
        x = default
    if not 0 < x <= 100:  # also rejects nan and inf
        x = default
    return int(x) if x == int(x) else x


LEAVE = _leave_setting()    # leave an account once its 5h or 7d reaches this %
ROOM_5H = 80                # worth switching to: 5h at or below this...
ROOM_7D = 95                # ...and 7d at or below this
ROOM_MODEL = 95             # ...and the preferred model at or below this
MODEL_RESET_MIN_WEEK = 25   # a model reset only if it leaves this much week
LAST_DAY = 24 * 3600        # quota expiring within this goes first
MIN_DWELL = 15 * 60         # no voluntary switch sooner than this after the last
RESET_MIN_LEFT = 24 * 3600  # a week renewing sooner than this refills for free
RESET_RETRY = 6 * 3600      # at most one reset per account in this span
RESET_DONE = 5              # a spent reset leaves what it clears at or below this
WALL_SOON = 30 * 60         # a seat's reset is not spent on a 5h wall lifting sooner
ERROR_RETRY = 300           # probe failed on the active account: look again

INF = float("inf")
FULL, MODEL = "full", "model"  # the two kinds of free reset (see parse_usage)
MODEL_DEFAULT = "fable"     # the model the sessions use, unless set


def model_setting(store):
    """The model the sessions use (claude-swap model): its own weekly limit
    counts like the 5h and the week. "opus" names no such limit today."""
    m = store.get("model")
    return m.strip() if isinstance(m, str) and m.strip() else MODEL_DEFAULT


def deadline(r, now):
    """When the account's unused quota is lost: weekly renewal or plan end."""
    ends = [t for t in (r.get("r7"), r.get("plan_end")) if t and t > now]
    return min(ends) if ends else INF


def eligible(r):
    # reserved: kept for `claude-swap run` sessions, never the shared login
    return (not (r.get("disabled") or r.get("free") or r.get("reserved")
                 or r.get("error"))
            and r.get("u5") is not None)


def _model_item(r, model):
    """(name, {"pct", "resets_at"}) of r's own weekly limit for `model`,
    matched without case, or (None, None): no such model, or not known."""
    if model:
        for name, m in (r.get("models") or {}).items():
            if name.lower() == model.lower():
                return name, m
    return None, None


def model_pct(r, model):
    return (_model_item(r, model)[1] or {}).get("pct")


def model_reset_at(r, model):
    return (_model_item(r, model)[1] or {}).get("resets_at")


def grants_of(r, now, kind, model=None):
    """r's live resets of one kind, soonest lapse first: FULL, or MODEL for
    the model named. A row without grants (callers that only count them)
    holds its `resets` as full ones."""
    gs = r.get("grants")
    if gs is None:
        ends = r.get("resets_ends")
        if kind == FULL and (r.get("resets") or 0) > 0 and (ends is None or ends > now):
            return [{"id": None, "left": r["resets"], "ends": ends,
                     "clears": ["seven_day"], "kind": FULL, "model": None,
                     "five_hour": False, "usable_now": True}]
        return []
    live = [g for g in gs
            if g["kind"] == kind and g["left"] > 0
            and (g["ends"] is None or g["ends"] > now)
            and (kind == FULL
                 or (model and (g.get("model") or "").lower() == model.lower()))]
    return sorted(live, key=lambda g: g["ends"] or INF)


def spendable(r, now, kind, model=None):
    """grants_of, less the ones claude.ai says cannot be spent right now
    (usable_now false): those still count as held, but are never picked."""
    return [g for g in grants_of(r, now, kind, model) if g.get("usable_now") is not False]


def blocked(r, model=None):
    return (bool(r.get("rate_limited")) or (r.get("u5") or 0) >= LEAVE
            or (r.get("u7") or 0) >= LEAVE or (model_pct(r, model) or 0) >= LEAVE)


def holds_reset(r, now):
    """A full reset, the one that refills the week (and orders accounts)."""
    return bool(grants_of(r, now, FULL))


def roomy(r, now, model=None):
    # A reset holder needs no room on what its reset refills at the limit:
    # a full one the week, a model one the model, while the week has a
    # quarter left for it.
    mp = model_pct(r, model)
    model_ok = (mp is None or mp <= ROOM_MODEL
                or (grants_of(r, now, MODEL, model)
                    and (r.get("u7") or 0) <= 100 - MODEL_RESET_MIN_WEEK))
    return bool((r.get("u5") or 0) <= ROOM_5H and model_ok and (
        (r.get("u7") or 0) <= ROOM_7D or holds_reset(r, now)))


def load(r, model=None):
    return max(r.get("u5") or 0, r.get("u7") or 0, model_pct(r, model) or 0)


def tier(r, now):
    if deadline(r, now) - now < LAST_DAY:
        return 0
    return 1 if holds_reset(r, now) else 2


def priority(r, now):
    return (tier(r, now), deadline(r, now))


# --- Orders (1.23): what check, the web and a group's watch may go by ---
# caduca is the order up to 1.22: what is lost first goes first. The others
# only say where to go: the watch keeps the account in use until it must
# leave it (its limit, a 429), then takes the first of the order with room;
# only caduca and libera come back by themselves (a quota about to be lost,
# a 5h window about to renew, is worth a switch; a few points of room are
# not: every switch makes the open sessions rebuild their prompt cache).
# The margins, the resets and «one reset a look» are the same in all.
CADUCA = "caduca"
ORDERS = (("caduca", "What is lost first"), ("sin-cortes", "Longest without a cut"),
          ("libre", "Most free now"), ("semana", "Most week left"),
          ("libera", "Frees up first"))
ORDER_KEYS = tuple(k for k, _ in ORDERS)
ORDER_PHRASES = {"caduca": "what is lost first", "sin-cortes": "the longest without a cut",
                 "libre": "the most free now", "semana": "the most week left",
                 "libera": "what frees up first"}

# sin-cortes measures room in 5h windows: R is the % of the week one full
# 5h window costs on an account, measured on its readings in the watch log
# (week_per_window); without them, its plan's. Max 20x: 25, the median of
# 123 windows in the watch log of Oct-Nov 2026 (quartiles 24.6-26.3); Team:
# 17, as measured by hand on Team seats; any other plan: 10.
PER_WINDOW = {"team": 17, "max_20x": 25}
PER_WINDOW_DEFAULT = 10
RATE_GAP = 30 * 60      # readings further apart than this are not one stretch
RATE_MIN_5H = 20        # a stretch counts once its 5h rose this much (rounding)
BURN_FRESH = 15 * 60    # the pace counts only with a reading this recent...
BURN_SPAN = 60 * 60     # ...over readings this far back at most...
BURN_MIN = 5 * 60       # ...and this far apart at least


def plan_kind(plan):
    """PER_WINDOW's key for a rate_limit_tier: team, max_20x, max_5x, pro or None."""
    t = (plan or "").lower()
    if "team" in t or "raven" in t:  # raven: claude.ai's name for Team
        return "team"
    for k in ("max_20x", "max_5x", "pro"):
        if k in t:
            return k
    return None


def _figure(x, model=None):
    """A reading's week (u7), or with model, that model's own weekly %."""
    if model is None:
        return x.get("u7")
    for name, p in (x.get("models") or {}).items():
        if name.lower() == model.lower():
            return p
    return None


def window_runs(history, model=None):
    """An account's readings (the watch log's, oldest first: {"t", "u5",
    "u7", "models"}) in stretches where nothing fell and no two readings are
    more than RATE_GAP apart: [(5h it rose, week it rose)], with model the
    rise of that model's own weekly limit instead. A fall (a window renewed,
    a reset spent), a gap, or the week rising while the 5h stays where it
    was (a 5h not reported, which reads 0: it would inflate R) starts
    another."""
    runs, d5, dw, prev = [], 0, 0, None
    for x in history:
        if prev is not None:
            f, pf = _figure(x, model), _figure(prev, model)
            if (x["t"] - prev["t"] <= RATE_GAP and x["u5"] >= prev["u5"]
                    and f is not None and pf is not None and f >= pf
                    and not (x["u5"] == prev["u5"] and f > pf)):
                d5, dw = d5 + x["u5"] - prev["u5"], dw + f - pf
            else:
                if d5 or dw:
                    runs.append((d5, dw))
                d5 = dw = 0
        prev = x
    if d5 or dw:
        runs.append((d5, dw))
    return runs


def week_per_window(history, plan, model=None):
    """R: the % of the week (with model, of that model's own weekly limit)
    one full 5h window costs on an account. Measured on its readings: the
    median, over its stretches (window_runs) where the 5h rose RATE_MIN_5H or
    more and the week (the model) rose too, of what the week rose for each
    whole 5h window. Without one, the plan's (PER_WINDOW); the model's falls
    back to the week's. -> (R, whether it was measured)"""
    got = sorted(dw / d5 * 100 for d5, dw in window_runs(history, model)
                 if d5 >= RATE_MIN_5H and dw > 0)
    if got:
        mid = len(got) // 2
        return (got[mid] if len(got) % 2 else (got[mid - 1] + got[mid]) / 2), True
    if model is not None:
        return week_per_window(history, plan)[0], False
    return PER_WINDOW.get(plan_kind(plan), PER_WINDOW_DEFAULT), False


def burn_rate(history, now, week, per_model=None, model=None):
    """How fast the account is filling now, limit by limit, in 5h windows a
    minute: {"5h", "7d", "model"} (None for a limit that did not move), over
    its last readings (the latest no older than BURN_FRESH, back BURN_SPAN
    at most and to the last fall or gap): the 5h over 100, the week over
    week (its R), the model over per_model (its own R). None when it is not
    in use now, or the readings span less than BURN_MIN."""
    if not history or now - history[-1]["t"] > BURN_FRESH:
        return None
    last = first = history[-1]
    for x in reversed(history[:-1]):
        fm, xm = _figure(first, model), _figure(x, model)
        if (last["t"] - x["t"] > BURN_SPAN or first["t"] - x["t"] > RATE_GAP
                or x["u5"] > first["u5"] or x["u7"] > first["u7"]
                or (fm is not None and xm is not None and xm > fm)):
            break
        first = x
    mins = (last["t"] - first["t"]) / 60
    if mins * 60 < BURN_MIN:
        return None
    def pace(d, per):
        return d / per / mins if d > 0 and per else None
    lm, fm = _figure(last, model), _figure(first, model)
    out = {"5h": pace(last["u5"] - first["u5"], 100),
           "7d": pace(last["u7"] - first["u7"], week),
           "model": (pace(lm - fm, per_model)
                     if model and lm is not None and fm is not None else None)}
    return out if any(out.values()) else None


def five_idle(history):
    """Whether the account's 5h window is not running: in its latest readings
    where the week rose, the 5h stayed at 0 (claude.ai reports no 5h then,
    which reads 0: since Nov 2026, most looks of a Max account)."""
    for prev, x in zip(reversed(history[:-1]), reversed(history[1:])):
        if x["t"] - prev["t"] <= RATE_GAP and x["u7"] > prev["u7"]:
            return x["u5"] == 0 and prev["u5"] == 0
    return False


def with_rates(rows, history, now, model=None):
    """rows, each with what sin-cortes reads ("rate": its R, the model's R,
    whether measured, its pace now per limit, whether its 5h window is not
    running), from the watch log's readings (history: {n: [reading]},
    oauth.usage_history). The rows given are left as they are."""
    out = []
    for r in rows:
        h = (history or {}).get(r["n"]) or []
        week, measured = week_per_window(h, r.get("plan"))
        per_model = week_per_window(h, r.get("plan"), model)[0] if model else week
        out.append(dict(r, rate={"week": week, "model": per_model, "measured": measured,
                                 "burn": burn_rate(h, now, week, per_model, model),
                                 "five_idle": five_idle(h)}))
    return out


def rate_of(r):
    """r's rate (with_rates), or its plan's when it was not measured."""
    if r.get("rate"):
        return r["rate"]
    week = PER_WINDOW.get(plan_kind(r.get("plan")), PER_WINDOW_DEFAULT)
    return {"week": week, "model": week, "measured": False, "burn": None, "five_idle": False}


def rooms(r, model=None):
    """sin-cortes: the room each limit leaves before it cuts, in 5h windows
    (1.0 = one full window): [(windows, "5h" | "7d" | "model")], 100 - 5h
    over 100, 100 - week over R, 100 - model over the model's R (rate_of).
    A 5h window that is not running (no r5, the 5h at 0, and rate_of's
    five_idle) is no limit here: only this measure leaves it out, what
    blocks an account still reads u5. [] without a 5h figure."""
    if r.get("u5") is None:
        return []
    rate = rate_of(r)
    out = []
    if not (rate.get("five_idle") and not r.get("r5") and not r["u5"]):
        out.append(((100 - min(100, r["u5"])) / 100, "5h"))
    out.append(((100 - min(100, r.get("u7") or 0)) / rate["week"], "7d"))
    mp = model_pct(r, model)
    if mp is not None:
        out.append(((100 - min(100, mp)) / rate["model"], "model"))
    return out


def headroom(r, model=None):
    """sin-cortes: the room before the account's first cut, in 5h windows,
    and which limit that is (rooms' smallest). (None, None) without a 5h
    figure."""
    rs = rooms(r, model)
    return min(rs) if rs else (None, None)


def first_cut(r, model=None):
    """(minutes, limit): when the account is cut at the pace it is used now,
    each limit's room over its own pace (rate_of's burn), and which limit
    gives the soonest; with no pace known, (None, the limit with the least
    room). (None, None) without a 5h figure."""
    rs = rooms(r, model)
    if not rs:
        return None, None
    burn = rate_of(r).get("burn") or {}
    times = [(room / burn[k], k) for room, k in rs if burn.get(k)]
    if not times:
        return None, min(rs)[1]
    t, k = min(times)
    return int(round(t)), k


def eta_min(r, model=None):
    """Minutes to the first cut at the pace the account is used now
    (first_cut), or None: not in use, or nothing known."""
    return first_cut(r, model)[0]


def frees_at(r, now, model=None):
    """libera: when the account's 5h is fresh again: a blocked one's unblock
    (INF if unknown or never), else its 5h window's renewal (INF with no
    window running)."""
    if blocked(r, model):
        return unblock_at(r, model) or INF
    r5 = r.get("r5")
    return r5 if r5 and r5 > now else INF


def order_key(r, now, model=None, order=CADUCA):
    """r's place under order, smallest first. An order not known is caduca."""
    if order == "sin-cortes":
        h = headroom(r, model)[0]
        return (-(h if h is not None else 0), load(r, model), priority(r, now), r["n"])
    if order == "libre":
        return (load(r, model), priority(r, now), r["n"])
    if order == "semana":  # a week not known goes after the known ones
        u7 = r.get("u7")
        return (INF if u7 is None else u7, load(r, model), priority(r, now), r["n"])
    if order == "libera":
        return (frees_at(r, now, model), load(r, model), r["n"])
    return (priority(r, now), load(r, model), r["n"])


def rank(rows, now, model=None, order=CADUCA):
    """Eligible accounts in consumption order, blocked ones included."""
    return sorted((r for r in rows if eligible(r)),
                  key=lambda r: order_key(r, now, model, order))


def listing(rows, now, model=None, order=CADUCA):
    """The order check and the web show: rank, then the blocked ones last,
    by when they free up (libera: every account by when it frees up)."""
    ranked = rank(rows, now, model, order)
    if order == "libera":
        return ranked
    return ([r for r in ranked if not blocked(r, model)]
            + sorted((r for r in ranked if blocked(r, model)),
                     key=lambda r: unblock_at(r, model) or INF))


def goes_first(a, b, now, model=None, order=CADUCA):
    """Whether a is worth a switch from b, the account in use and not at its
    limit: under caduca its quota is lost first (up to 1.22), under libera
    its 5h window renews first; under the others never (see ORDERS)."""
    if order == "libera":
        return frees_at(a, now, model) < frees_at(b, now, model)
    if order in ORDER_KEYS and order != CADUCA:
        return False
    return priority(a, now) < priority(b, now)


def unblock_at(r, model=None):
    """When a blocked account is usable again; None if unknown or never,
    which is the case when its cancelled plan ends first."""
    times = []
    if (r.get("u5") or 0) >= LEAVE:
        times.append(r.get("r5"))
    if (r.get("u7") or 0) >= LEAVE:
        times.append(r.get("r7"))
    if (model_pct(r, model) or 0) >= LEAVE:
        times.append(model_reset_at(r, model))
    if not times or None in times:
        return None
    cancel = r.get("cancel_at")
    if cancel and max(times) >= cancel:
        return None
    return max(times)


def lifts_at(rows, now, model=None):
    """When the first of rows, all at their limit, is usable again: None
    if no unblock is known."""
    waits = [t for t in (unblock_at(r, model) for r in rows) if t and t > now]
    return min(waits) if waits else None


def reset_key(g):
    """How the watch remembers a kind of reset it tried on an account."""
    return FULL if g["kind"] == FULL else f"{MODEL}:{g.get('model')}"


def _reset_allowed(r, g, now, state):
    n, key = r["n"], reset_key(g)
    failed = state.get("reset_failed") or []
    # older states hold bare account numbers, which were full resets
    if f"{n}:{key}" in failed or (key == FULL and n in failed):
        return False
    tried = state.get("reset_tried") or {}
    t = tried.get(f"{n}:{key}") or (tried.get(str(n)) if key == FULL else None)
    return not (t and now - t < RESET_RETRY)


def with_resets_of(state, others):
    """state as decide reads it, with the reset marks (reset_tried,
    reset_failed) of the others added: the lanes of two groups on one seat
    spend one quota, so a reset either tried there counts for both (the
    latest try wins). state itself is left as it is: a spend is marked on
    the lane that made it."""
    tried = dict(state.get("reset_tried") or {})
    failed = list(state.get("reset_failed") or [])
    for o in others:
        for k, t in (o.get("reset_tried") or {}).items():
            if t and t > (tried.get(k) or 0):
                tried[k] = t
        failed += [k for k in o.get("reset_failed") or [] if k not in failed]
    return dict(state, reset_tried=tried, reset_failed=failed)


def _worth_before(g, renews, now):
    # the window refills for free soon: spend only if the reset lapses first
    if renews and renews - now < RESET_MIN_LEFT:
        return bool(g["ends"] and g["ends"] <= renews)
    return True


def reset_due(r, now, state, model=None, seat=False):
    """The reset to spend on r now, or None (aggressive policy).

    The week spent: its full reset; without a usable one (none, or one that
    failed on this account), a model reset whose model spent at least
    MODEL_RESET_MIN_WEEK of the week, which it gives back. A full reset
    tried lately blocks that fallback too. The 5h spent on a reserved seat
    (seat=True) whose full reset clears the 5h too: that one. The preferred
    model spent, with at least MODEL_RESET_MIN_WEEK of the week left: a
    reset of that model; with less left, or none of that model to spend,
    the full reset once the week is that far gone (a model reset would
    leave too little). Only resets claude.ai says can be spent now; never
    in a cooldown, never twice within RESET_RETRY, never a kind that did
    not work on that account.
    """
    if (r.get("reset_cooldown") or 0) > now:
        return None

    def failed(g):
        key = f"{r['n']}:{reset_key(g)}"
        return key in (state.get("reset_failed") or []) or (
            g["kind"] == FULL and r["n"] in (state.get("reset_failed") or []))

    def first(gs):
        return next((g for g in gs if _reset_allowed(r, g, now, state)), None)

    u7 = r.get("u7") or 0
    if u7 >= LEAVE:
        full = [g for g in spendable(r, now, FULL) if not failed(g)]
        if full:
            g = first(full)
            return g if g and _worth_before(g, r.get("r7"), now) else None
        for name, share in sorted((r.get("shares") or {}).items(), key=lambda kv: -kv[1]):
            if share < MODEL_RESET_MIN_WEEK:
                break
            g = first(spendable(r, now, MODEL, name))
            if g and _worth_before(g, r.get("r7"), now):
                return g
        return None
    if seat and (r.get("u5") or 0) >= LEAVE:
        g = first(g for g in spendable(r, now, FULL) if g["five_hour"])
        if g:
            return g
    mp = model_pct(r, model)
    if mp is None or mp < LEAVE:
        return None
    if u7 <= 100 - MODEL_RESET_MIN_WEEK:
        g = first(spendable(r, now, MODEL, model))
        if g and _worth_before(g, model_reset_at(r, model), now):
            return g
    if u7 >= 100 - MODEL_RESET_MIN_WEEK:
        g = first(spendable(r, now, FULL))
        if g and _worth_before(g, r.get("r7"), now):
            return g
    return None


def reset_reason(r, g, model=None):
    n, now = r["n"], usage(r, model)
    if g["kind"] == FULL:
        if ((model_pct(r, model) or 0) >= LEAVE
                and 100 - MODEL_RESET_MIN_WEEK <= (r.get("u7") or 0) < LEAVE):
            name = _model_item(r, model)[0]
            return (f"#{n} spent its {name} ({now}) and holds a full reset"
                    f" (too little week left for a {name} one)")
        what = "its week" if (r.get("u7") or 0) >= LEAVE else "its 5h"
        return f"#{n} spent {what} ({now}) and holds a full reset"
    name = g.get("model")
    if (r.get("u7") or 0) >= LEAVE:
        back = (r.get("shares") or {}).get(name) or 0
        return f"#{n} spent its week ({now}); a {name} reset gives {back:.0f}% of it back"
    return f"#{n} spent its {name} ({now}) and holds a {name} reset"


def reset_worked(g, before, after):
    """Whether a spent reset did what its kind does, read on fresh rows: a
    full one empties the week (and the 5h if it clears it); a model one
    empties that model and gives its share of the week back."""
    if g["kind"] == FULL:
        if (after.get("u7") or 0) > RESET_DONE:
            return False
        return not g.get("five_hour") or (after.get("u5") or 0) <= RESET_DONE
    name = g.get("model")
    pct = model_pct(after, name)
    if pct is None or pct > RESET_DONE:
        return False
    back = (before.get("shares") or {}).get(name) or 0
    return (before.get("u7") or 0) - (after.get("u7") or 0) >= back - RESET_DONE


def reset_for(r, now, kind=None, model=None):
    """The reset `claude-swap reset <n> [kind]` spends. kind "full" or a
    model's name; by default what helps now (as the watch would pick it),
    else the full one, else any model one. None if there is none that
    claude.ai says can be spent now."""
    if kind and kind.lower() == FULL:
        return next(iter(spendable(r, now, FULL)), None)
    if kind:
        return next(iter(spendable(r, now, MODEL, kind)), None)
    g = reset_due(r, now, {}, model) or next(iter(spendable(r, now, FULL)), None)
    if g:
        return g
    names = {g.get("model") for g in r.get("grants") or [] if g["kind"] == MODEL}
    return next((g for name in sorted(n for n in names if n)
                 for g in spendable(r, now, MODEL, name)), None)


def next_event(rows, now, model=None):
    """Soonest instant at which a block lifts or the order can change."""
    times = []
    for r in rows:
        if not eligible(r):
            continue
        d = deadline(r, now)
        times += [r.get("r5"), r.get("r7"), r.get("plan_end"),
                  r.get("reset_cooldown"), model_reset_at(r, model),
                  d - LAST_DAY if d < INF else None]
    times = [t for t in times if t and t > now]
    return min(times) if times else None


def usage(r, model=None):
    if r.get("u5") is None:
        return "no data"
    out = f"5h {r['u5']:.0f}% · 7d {(r.get('u7') or 0):.0f}%"
    name, m = _model_item(r, model)
    if m and m.get("pct") is not None:
        out += f" · {name} {m['pct']:.0f}%"
    return out


def decide(rows, active, now, state, auto_reset=False, model=None, order=CADUCA):
    """What to do now: stay, switch, spend a reset, or wait at the wall.

    state carries last_switch (epoch), manual (the active account was picked
    by hand), reset_tried ({"<n>:<reset_key>": epoch}) and reset_failed
    (["<n>:<reset_key>"]; bare numbers in older states count as full resets).
    A "reset" decision also carries the grant to spend. Returns
    {"action", "target", "reason", "wake"}; wake is the next instant worth
    looking again, or None. model: the preferred model, whose own weekly
    limit counts like the 5h and the week (None: none counts). order: where
    to go (ORDERS; the resets are looked at in caduca's order whatever it is).
    """
    def out(action, target, reason, wake=None):
        ev = next_event(rows, now, model)
        if wake is None or (ev is not None and ev < wake):
            wake = ev
        return {"action": action, "target": target, "reason": reason,
                "wake": wake}

    cur = next((r for r in rows if r["n"] == active), None)
    ranked = rank(rows, now, model, order)

    if auto_reset:
        for r in (ranked if order == CADUCA else rank(rows, now, model)):
            g = reset_due(r, now, state, model)
            if g:
                d = out("reset", r["n"], reset_reason(r, g, model))
                d["grant"] = g
                return d

    if (cur is not None and cur.get("error")
            and not (cur.get("disabled") or cur.get("free") or cur.get("reserved"))):
        return out("stay", active, f"#{active} probe failed ({cur['error']})",
                   now + ERROR_RETRY)

    usable = [r for r in ranked if not blocked(r, model)]
    best = next((r for r in usable if roomy(r, now, model)), None)

    if cur is None or not eligible(cur) or blocked(cur, model):
        if cur is None:
            why = "no active account"
        elif not eligible(cur):
            why = f"#{active} is no longer usable"
        else:
            why = f"#{active} at its limit ({usage(cur, model)})"
        target = best or min(usable, key=lambda r: (load(r, model),
                                                    (priority(r, now) if order == CADUCA
                                                     else order_key(r, now, model, order))),
                             default=None)
        if target is None:
            return out("wall", None, why + " and every account is at its limit",
                       lifts_at(ranked, now, model))
        return out("switch", target["n"], why)

    if best and best["n"] != active and goes_first(best, cur, now, model, order):
        ahead = f"#{best['n']} goes first ({usage(best, model)})"
        if state.get("manual"):
            return out("stay", active, f"#{active} picked by hand; {ahead}")
        last = state.get("last_switch") or 0
        if now - last < MIN_DWELL:
            return out("stay", active, f"{ahead}, after the dwell time",
                       last + MIN_DWELL)
        return out("switch", best["n"], ahead)

    if (best and best["n"] != active and order in ORDER_KEYS
            and order not in (CADUCA, "libera")
            and order_key(best, now, model, order) < order_key(cur, now, model, order)):
        return out("stay", active, f"#{active} kept until it must leave"
                                   f" (#{best['n']} goes first, {usage(best, model)})")
    return out("stay", active, f"#{active} goes first")


def lane_decide(rows, lane, pool, now, state, auto_reset=False, model=None, order=CADUCA):
    """The reserved sessions (claude-swap run), moved like the shared login
    but only among pool, the reserved accounts the watch may put them on.
    None when they are not the watch's to move: no pool, or on an account
    outside it (a pick by hand there is left alone). A seat's reset is only
    spent once every seat in the pool is at its limit, and not on a seat
    that only spent its 5h when the wall lifts by itself within WALL_SOON.
    order: where to move them (decide's)."""
    if len(pool) < 2 or lane not in pool:
        return None
    sub = [dict(r, reserved=False) for r in rows if r["n"] in pool]
    d = decide(sub, lane, now, state, False, model, order)
    if auto_reset and d["action"] == "wall":
        ranked = rank(sub, now, model)
        lifts = lifts_at(ranked, now, model)
        soon = lifts is not None and lifts - now < WALL_SOON
        for r in ranked:
            only_5h = ((r.get("u7") or 0) < LEAVE
                       and (model_pct(r, model) or 0) < LEAVE)
            g = reset_due(r, now, state, model, seat=not (soon and only_5h))
            if g:
                return dict(d, action="reset", target=r["n"], grant=g,
                            reason="every seat at its limit; " + reset_reason(r, g, model))
    return d


def watch_decide(rows, active, seats, now, state, auto_reset=False, model=None, order=CADUCA):
    """The shared login's move (decide) by general's watch. seats: the
    accounts it may put it on, None for all of general (decide's own rule,
    as up to 1.21). With a list, no account outside it is ever its target
    or has a reset spent: the list keeps cl's spending off the others. The
    active one is judged as decide judges it wherever it is, but with no
    resets when outside the list: kept while it was picked by hand, until
    it is blocked, then moved onto the list (the shared login must keep
    working: unlike a lane, it is not left at its limit)."""
    if seats is None:
        return decide(rows, active, now, state, auto_reset, model, order)
    return decide([r if r["n"] in seats else
                   dict(r, grants=[], resets=0) if r["n"] == active else
                   dict(r, reserved=True) for r in rows], active, now, state, auto_reset, model,
                  order)


GENERAL_OFF = "general's watch is off: the shared login is left where it is"


def general_step(rows, active, watch, now, state, lanes=(), model=None, order=CADUCA):
    """General's turn in a look of the watch, the first one (the shared
    login's). watch: its (on, seats, resets), oauth.general_watch; state:
    its memory, read with the reset marks of every lane (lanes: their
    memories) added, since a seat may be in general and in lane groups and
    its quota is one. -> (decision, None while its watch is off: the shared
    login is not the watch's then; what watch status tells of it; whether
    the turn spends a reset, which ends the look: the lanes wait for the
    next one, step_lanes). order: general's watch's (oauth.watch_order)."""
    on, seats, resets = watch
    if not on:
        return None, GENERAL_OFF, False
    d = watch_decide(rows, active, seats, now, with_resets_of(state, list(lanes)),
                     resets, model, order)
    return d, d["reason"], d["action"] == "reset"


def general_now(rows, active, watch, now, model=None, order=CADUCA):
    """check's «Now:» for the shared login: what general's watch would do
    on its seats (watch_decide; check never spends a free reset), or, while
    its watch is off, the best account to put cl on by hand, among all of
    general (decide). watch: its (on, seats, resets), oauth.general_watch;
    order: the one to go by. -> (decision, whether it is the watch's)"""
    on, seats, _ = watch
    if on:
        return watch_decide(rows, active, seats, now, {}, False, model, order), True
    return decide(rows, active, now, {}, False, model, order), False


def step_lanes(keys, step):
    """One look's turns, in the order of keys: general's first (the shared
    login's), then each group's lane, the default group's first. step(key)
    does a turn and says whether it spent a reset. That ends the look: the
    turns decide on the rows of the same probe, and a seat just reset
    (whose figures every group holding it shares, general included) would
    still read at its limit, so a turn after it could spend another seat's
    reset and leave the one just freed. The rest wait for the next look, on
    fresh rows. -> the keys stepped."""
    done = []
    for k in keys:
        done.append(k)
        if step(k):
            break
    return done


def free_quota(rows, now, model=None):
    """What a group of accounts has left, summed: the % free of the 5h, of
    the week and of the model's own weekly limit (100 = one whole account).

    Only accounts in the rotation count (a reserved seat in its own group).
    The 5h counts only where the week and the model still let the account
    work: a spent week leaves its 5h worthless. The model counts only where
    it is known. next is the soonest weekly renewal that will come, as
    (epoch, n, % it gives back). None when no account counts."""
    rs = [r for r in (dict(r, reserved=False) for r in rows) if eligible(r)]
    if not rs:
        return None

    def free(p):
        return max(0, 100 - min(100, p or 0))

    def works(r):
        p = model_pct(r, model) if model else None
        return (r.get("u7") or 0) < LEAVE and (p is None or p < LEAVE)

    h5 = [free(r.get("u5")) for r in rs if works(r)]
    week = [free(r.get("u7")) for r in rs if r.get("u7") is not None]
    mod = [free(p) for p in (model_pct(r, model) for r in rs) if p is not None] if model else []
    due = [(r["r7"], r["n"], min(100, round(r.get("u7") or 0))) for r in rs
           if r.get("r7") and r["r7"] > now
           and not (r.get("cancel_at") and r["r7"] >= r["cancel_at"])]
    return {"accounts": len(rs), "h5": sum(h5), "h5_n": len(h5),
            "d7": sum(week), "d7_n": len(week),
            "model": sum(mod) if model else None, "model_n": len(mod),
            "resets": sum(r.get("resets") or 0 for r in rs),
            "next": min(due) if due else None}

# --- Plan timeline: what check draws, and when the watch re-reads it ---
# cancel_at is when a cancelled plan stops (the account turns free) and
# down_at when a booked downgrade lands (the account goes on, smaller).

WEEK = 7 * 86400
SUB_TTL = 86400     # a subscription is re-read once a day
SUB_RETRY = 3600    # ...or an hour after a read that failed


def timeline(r, days):
    """One calendar mark per day, days being (start, end) epochs.

    ("end", t) on the day the plan stops and ("gone", None) on every day
    after it; ("down", t) on a downgrade; ("renew", t) on the weekly
    renewal and ("fable", t) on a Fable one on another day, both only if
    they come before the end. A weekly renewal after the end shows as
    ("would_renew", t): it only comes if the plan is renewed. One mark
    per day: end beats downgrade beats renewal beats Fable. None = nothing.
    """
    cancel, r7 = r.get("cancel_at"), r.get("r7")
    events = [("end", cancel), ("down", r.get("down_at"))]
    events += [(kind, t) for kind, t in (("renew", r7), ("fable", r.get("rf")))
               if t and not (cancel and t >= cancel)]
    marks = []
    for start, end in days:
        if cancel and start >= cancel:
            later = r7 and r7 >= cancel and start <= r7 < end
            marks.append(("would_renew", r7) if later else ("gone", None))
            continue
        marks.append(next(((kind, t) for kind, t in events
                           if t and start <= t < end), None))
    return marks


def ending(r, end):
    """What a plan stopping at `end` leaves of the weekly quota.

    left: % of the current week still unused, which the end cuts off when
    it comes before the renewal. Otherwise renews is the last renewal before
    the end and tail the stretch from it to the end; projected says it was
    counted a week at a time from the next one, so it is an estimate.
    """
    out = {"left": None, "renews": None, "tail": None, "projected": False}
    u7, r7 = r.get("u7"), r.get("r7")
    if r7 is None or r7 >= end:
        if u7 is not None:
            out["left"] = max(0, round(100 - u7))
        return out
    weeks = int((end - r7) // WEEK)
    if r7 + weeks * WEEK >= end:
        weeks -= 1
    out.update(renews=r7 + weeks * WEEK, tail=end - (r7 + weeks * WEEK),
               projected=weeks > 0)
    return out


def parse_subscription(s):
    """plan_ends / plan_next / plan_renews as the store keeps them, from
    subscription_details.

    plan_ending_at is claude.ai's "Your subscription ends on …"; a smaller
    plan booked for later comes as scheduled_downgrade instead. next_charge_at
    is the next renewal; on a cancelled plan it repeats the end, which is not
    a renewal, so it is only kept while the plan goes on.
    """
    s = s or {}
    down = s.get("scheduled_downgrade") or {}
    ends = s.get("plan_ending_at")
    return {"plan_ends": ends,
            "plan_next": ({"plan": down.get("plan_type"), "date": down.get("date")}
                          if down.get("plan_type") else None),
            "plan_renews": None if ends else s.get("next_charge_at")}


def _iso(v):
    from datetime import datetime
    try:
        return datetime.fromisoformat(str(v).replace("Z", "+00:00")).timestamp()
    except (ValueError, TypeError):
        return None


def billing(acc, now):
    """What the plan does next: ("ends", t) cancelled, ("down", t) a smaller
    plan booked, ("renews", t) the next charge, or ("?", None) when it is not
    known yet or the cached date has gone by (re-read within a day)."""
    end = _iso(acc.get("plan_ends"))
    if end and end > now:
        return "ends", end
    down = _iso((acc.get("plan_next") or {}).get("date"))
    if down and down > now:
        return "down", down
    ren = _iso(acc.get("plan_renews"))
    if ren and ren > now:
        return "renews", ren
    return "?", None


def subs_due(accounts, now, tried):
    """1-based numbers of the accounts whose subscription is worth re-reading.

    Paid plans with a cookie, once a day. A plan past its cached end is read
    too, which is how a resubscription shows up. tried maps "n" to the
    last failed read, retried an hour later.
    """
    due = []
    for n, acc in enumerate(accounts, 1):
        tier = (acc.get("plan") or "").lower()
        if (acc.get("disabled") or not acc.get("session_key")
                or not acc.get("org_id")
                or "free" in tier or tier in ("", "default_claude_ai")):
            continue
        if now - (acc.get("sub_checked") or 0) < SUB_TTL:
            continue
        if now - (tried.get(str(n)) or 0) < SUB_RETRY:
            continue
        due.append(n)
    return due


def needs_billed_probe(free, web_ok, has_windows):
    """Whether check falls back to the billed ratelimit probe (Haiku call).

    Not when the cookie reply brought the windows, and not for a free plan
    that answered without any: Claude Code refuses free plans (403
    permission_error), so the probe would only print that refusal. With no
    working cookie it stays, being the only source, and the way a free
    account that moved to a paid plan gets noticed.
    """
    if web_ok and (has_windows or free):
        return False
    return True


def five_hour(u5, u7):
    """The 5h figure, given what a reply carried for the 5h and 7d windows.

    While no 5h window is running (nothing used in the last five hours)
    claude.ai sends five_hour as null and the ratelimit headers leave the
    5h ones out (seen 4-nov-2026). That is 0%, not unknown: read as no data,
    it took every idle account out of the rotation. Unknown is only when
    the 7d window is missing too, as on a free plan.
    """
    if u5 is None and u7 is not None:
        return 0.0
    return u5


# --- What a claude.ai /usage reply holds (cedar_ember=1&skip_spend=1) ---
# limits[] brings the 5h ("session"), the week ("weekly_all") and one weekly
# limit per model ("weekly_scoped", named by scope.model.display_name). A
# model's limit sits inside the week: what it spends counts on both, and
# weekly_scoped_shares[] says how much of the week each model spent
# (limit_index points into limits[]). cedar_ember.grants[] are the free
# resets; what a grant clears tells its kind: with "seven_day" it is a full
# one (the week, every model's week, the 5h too on Team seats), without it
# one model's, which also gives that model's share of the week back.

def parse_usage(d, now):
    """The fields the engine reads, from one /usage reply.

    u5/r5/u7/r7 from five_hour/seven_day, or from limits[] ("session",
    "weekly_all") when those do not come (a 5h window that is not running
    is 0%); models {name: {"pct", "resets_at"}}; shares {name: % of the
    week it spent}; grants: the live resets, soonest lapse first, each
    {"id", "left", "ends", "clears", "kind" (FULL or MODEL), "model" (MODEL
    only; None when it cannot be told), "five_hour", "usable_now"};
    eligible (None when the reply said nothing about resets);
    reset_cooldown; resets and resets_ends: the full resets left and their
    soonest lapse.
    """
    five, seven = d.get("five_hour") or {}, d.get("seven_day") or {}
    out = {"u5": five.get("utilization"), "r5": _iso(five.get("resets_at")),
           "u7": seven.get("utilization"), "r7": _iso(seven.get("resets_at")),
           "models": {}, "shares": {}, "grants": [], "eligible": None,
           "reset_cooldown": None, "resets": None, "resets_ends": None}
    limits = [l for l in d.get("limits") or [] if isinstance(l, dict)]
    for kind, u, r in (("session", "u5", "r5"), ("weekly_all", "u7", "r7")):
        l = next((l for l in limits if l.get("kind") == kind), None)
        if out[u] is None and l and l.get("percent") is not None:
            out[u], out[r] = l["percent"], _iso(l.get("resets_at"))
    out["u5"] = five_hour(out["u5"], out["u7"])
    names = {}
    for i, l in enumerate(d.get("limits") or []):
        if not isinstance(l, dict) or l.get("kind") != "weekly_scoped":
            continue
        name = ((l.get("scope") or {}).get("model") or {}).get("display_name")
        if name:
            names[i] = name
            out["models"][name] = {"pct": l.get("percent"),
                                   "resets_at": _iso(l.get("resets_at"))}
    for s in d.get("weekly_scoped_shares") or []:
        name = names.get((s or {}).get("limit_index"))
        if name and s.get("used_percent_of_weekly") is not None:
            out["shares"][name] = s["used_percent_of_weekly"]
    ce = d.get("cedar_ember")
    if not isinstance(ce, dict):
        return out
    out["eligible"] = ce.get("eligible") is True
    out["reset_cooldown"] = _iso(ce.get("cooldown_until"))
    for g in (ce.get("grants") or []) if out["eligible"] else []:
        left, ends = g.get("resets_left"), _iso(g.get("ends_at"))
        if (g.get("paused") or not isinstance(left, int) or left <= 0
                or (ends and ends <= now)):
            continue
        clears = list(g.get("clears") or [])
        full = "seven_day" in clears
        out["grants"].append({
            "id": g.get("id"), "left": left, "ends": ends, "clears": clears,
            "kind": FULL if full else MODEL,
            "model": None if full else _grant_model(g, clears, out["models"]),
            "five_hour": "five_hour" in clears,
            "usable_now": g.get("usable_now") is not False})
    out["grants"].sort(key=lambda g: g["ends"] or INF)
    full = [g for g in out["grants"] if g["kind"] == FULL]
    out["resets"] = sum(g["left"] for g in full)
    out["resets_ends"] = min((g["ends"] for g in full if g["ends"]), default=None)
    return out


def _grant_model(g, clears, models):
    """The model a model reset is for: the only model limit there is, else
    the one whose % matches what the grant reports for what it clears.
    None for one that clears no weekly limit at all (only the 5h, say)."""
    own = [k for k in clears if k != "five_hour"]
    if not own:
        return None
    if len(models) == 1:
        return next(iter(models))
    used = [v for k, v in (g.get("percent_used") or {}).items() if k in own]
    hits = [name for name, m in models.items() if m.get("pct") in used]
    return hits[0] if len(hits) == 1 else None


def cache_fields(r):
