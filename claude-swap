cmd_init() {
  if [ -f "$STORE" ]; then
    echo "Store already exists at $STORE"
    echo "Use 'claude-swap add' to add more accounts."
    return
  fi

  echo "claude-swap — Multi-account manager for Claude Code"
  echo ""

  mkdir -p "$(dirname "$STORE")"
  echo '{"version":1,"active":0,"accounts":[]}' > "$STORE"
  chmod 600 "$STORE"

  echo "To add an account, you need a setup token (lasts 1 year):"
  echo "  1. Open a new terminal"
  echo "  2. Log in with the account:  claude login"
  echo "  3. Generate a token:         claude setup-token"
  echo "  4. Come back here and paste it"
  echo ""

  while true; do
    _add_account_interactive
    echo ""
    read -r -p "Add another account? (y/n) " more
    case "$more" in
      [yY]*) echo "" ;;
      *) break ;;
    esac
  done

  # Set first account as active if we have any
  local count
  count=$(python3 -c "import json; print(len(json.load(open('$STORE'))['accounts']))")
  if [ "$count" -gt 0 ]; then
    python3 -c "
import json
with open('$STORE') as f:
    d = json.load(f)
d['active'] = 1
with open('$STORE', 'w') as f:
    json.dump(d, f, indent=2)
"
    echo ""
    echo "Account 1 set as active."
    _do_rotate 1

    # --- Onboarding: sessionKeys (Fable % / plan columns) ---
    echo ""
    echo "Optional: the Fable % and Plan columns need each account's claude.ai"
    echo "sessionKey cookie (from a logged-in claude.ai browser session)."
    if python3 -c "import browser_cookie3" 2>/dev/null; then
      read -r -p "Scan Chrome profiles for logged-in claude.ai sessions now? (y/n) " sync
      case "$sync" in
        [yY]*) echo ""; cmd_keys_sync ;;
        *) echo "You can do it later with: claude-swap keys-sync" ;;
      esac
    else
      echo ""
      echo "  Automatic import needs browser_cookie3:"
      echo "    pip3 install --user browser_cookie3 && claude-swap keys-sync"
      echo "  Or paste a key manually per account: claude-swap key <n>"
    fi

    # --- Onboarding: watcher ---
    echo ""
    read -r -p "Start the auto-switcher? It switches at 98% of 5h or 7d, spending first what expires first (y/n) " w
    case "$w" in
      [yY]*) cmd_watch_start general ;;
      *) echo "You can start it later with: claude-swap watch start" ;;
    esac

    echo ""
    echo "All set. Run 'claude-swap check' to see the dashboard."
  fi
}

cmd_status() {
  check_store
  python3 - "$STORE" "$CLAUDE_CREDS" "$CLAUDE_JSON" "$IS_MACOS" "$VERSION" <<'PYEOF'
import json, hashlib, time, os, sys, types
from datetime import datetime

oauth = types.ModuleType("oauth")
exec(os.environ["CLAUDE_SWAP_OAUTH"], oauth.__dict__)

store_path = sys.argv[1]
creds_path = sys.argv[2]
claude_json_path = sys.argv[3]
is_macos = sys.argv[4] == "true"
version = sys.argv[5]

# Keep the logins in line first (saves a login Claude Code refreshed), so
# what follows describes the current state.
events = []
try:
    events = oauth.tick(store_path, *oauth.default_io(is_macos))
except Exception as e:
    events = [("log", f"login sync failed: {type(e).__name__}")]

with open(store_path) as f:
    store = json.load(f)

accounts = store.get("accounts", [])
active = store.get("active", 0)
now_ms = int(time.time() * 1000)

def fingerprint(token):
    return hashlib.sha256(token.encode()).hexdigest()[:12]

def match_token(token):
    fp = fingerprint(token)
    for i, acc in enumerate(accounts):
        if acc.get("token") and fingerprint(acc["token"]) == fp:
            return i + 1, fp
    return None, fp

def session_token():
    """(pid, token or None, config dir or None) of the Claude Code session
    this runs in, or None.

    A session started by `claude-swap run` carries its account's token in
    CLAUDE_CODE_OAUTH_TOKEN, or, on a full login, the account's own
    CLAUDE_CONFIG_DIR. Claude Code keeps the token from the commands it runs
    (and claude-swap drops that directory), so both are read from the claude
    process itself."""
    import subprocess

    def ps(*args):
        return subprocess.run(["ps", *args], capture_output=True, text=True,
                               errors="replace", timeout=5).stdout.strip()
    pid = os.getppid()
    for _ in range(12):
        if pid <= 1:
            return None
        try:
            ppid, cmd = ps("-o", "ppid=,command=", "-p", str(pid)).split(None, 1)
        except (ValueError, OSError, subprocess.SubprocessError):
            return None
        if os.path.basename(cmd.split()[0]) == "claude":
            try:
                env = ps("eww", "-o", "command=", "-p", str(pid))
            except (OSError, subprocess.SubprocessError):
                env = ""

            def var(name):
                return next((w.split("=", 1)[1] for w in env.split()
                             if w.startswith(name + "=")), None) or None
            return pid, var("CLAUDE_CODE_OAUTH_TOKEN"), var("CLAUDE_CONFIG_DIR")
        pid = int(ppid)
    return None

print(f"claude-swap v{version}")
print()

if not accounts:
    print("No accounts configured. Run 'claude-swap add' to add one.")
    sys.exit(0)

if is_macos:
    found = session_token()
    on_lane = oauth.session_line(store, found[2]) if found else None
    k_own = found and not on_lane and oauth.run_account(found[2], accounts)
    if on_lane:
        print(on_lane)
    elif k_own:
        a = accounts[k_own - 1]
        kind = "reserved, " if not oauth.in_general(store, k_own) else ""
        chrome = ("Claude in Chrome ready" if oauth.chrome_ready(a)
                  else f"no Chrome profile has the extension signed in to {a.get('email')}")
        print(f"This session: {k_own} ({oauth.who(a)})"
              f" — {kind}claude-swap run on its own full login, {chrome};"
              " the Active login below does not reach it")
    elif found and found[1]:
        k, _ = match_token(found[1])
        if k:
            a = accounts[k - 1]
            kind = "reserved, " if not oauth.in_general(store, k) else ""
            print(f"This session: {k} ({oauth.who(a)})"
                  f" — {kind}claude-swap run on its setup-token, no Claude in Chrome;"
                  " the Active login below does not reach it")
        else:
            print("This session: a token of its own, which is none of claude-swap's")
    elif found:
        print("This session: on the Active login below")

# the shared login (general's place, cl)
print(oauth.active_line(store))

# the reserved sessions (claude-swap run) are on an account of their own,
# one per group (its lane)
lane_lines = oauth.lane_lines(store) if is_macos else []
lane_ns = {n for n, _ in lane_lines}
for _, line in lane_lines:
    print(line)

# Watcher
wpid_path = os.path.expanduser("~/.claude/claude-swap-watch.pid")
wstate_path = os.path.expanduser("~/.claude/claude-swap-watch.state")
wpid, walive = None, False
try:
    wpid = int(open(wpid_path).read().strip())
    os.kill(wpid, 0)
    walive = True
except Exception:
    pass
try:
    ws = json.load(open(wstate_path))
except Exception:
    ws = {}
if walive:
    print("Watch:  " + oauth.watch_running(store, ws, wpid))
elif wpid is not None:
    print(f"Watch:  stale pidfile (PID {wpid} dead) — clean up with 'claude-swap watch stop'")
else:
    print("Watch:  not running")
print()

# What Claude Code uses: on macOS its keychain item, read before the file
if is_macos:
    ko = oauth.parse(oauth.Keychain().read(oauth.cc_service()))
    if ko:
        kmatch, kfp = match_token(ko["accessToken"])
        if kmatch is None and oauth.is_full(ko):
            kmatch = oauth.cl_owner(ko, store)[0]  # its main login, or its login of general
        label = f"account {kmatch}" if kmatch else "UNKNOWN"
        kind = ("full login, Claude in Chrome ready" if oauth.is_full(ko)
                else "setup-token, no Claude in Chrome")
        print(f"  Keychain: {kfp} ({label}, {kind}) — what Claude Code uses")
    else:
        print("  Keychain: not set (Claude Code reads .credentials.json)")
for _, msg in events:
    print(f"  Login sync: {msg}")

# .credentials.json check
try:
    with open(creds_path) as f:
        d = json.load(f)
    o = d["claudeAiOauth"]
    cmatch, cfp = match_token(o["accessToken"])
    label = f"account {cmatch}" if cmatch else "UNKNOWN"
    print(f"  .credentials.json: {cfp} ({label})")
except FileNotFoundError:
    print(f"  .credentials.json: not found")
except Exception as e:
    print(f"  .credentials.json: error ({e})")

print()

# Account list: what each plan does next, and when its setup-token expires
engine = types.ModuleType("engine")
exec(os.environ["CLAUDE_SWAP_ENGINE"], engine.__dict__)

def plan_next(acc):
    t = (acc.get("plan") or "").lower()
    if "free" in t or t == "default_claude_ai":
        return "free plan"
    kind, ts = engine.billing(acc, time.time())
    if kind == "?":
        return "?"
    when = datetime.fromtimestamp(ts).strftime("%a %d %b")
    return {"ends": f"ends {when}", "down": f"downgrade {when}",
            "renews": f"renews {when}"}[kind]

nw = len(str(len(accounts)))
print(f"  {'#':>{nw + 1}}  {'Account':<30} {'Plan':<20} Token")
for i, acc in enumerate(accounts):
    n = i + 1
    marker = "*" if n == active else "▸" if n in lane_ns else " "
    name = ((acc.get("email") or "").strip() or acc.get("label") or "-")[:30]
    exp_ms = acc.get("expires", 0)
    if exp_ms > now_ms:
        exp_dt = datetime.fromtimestamp(exp_ms / 1000).strftime("%Y-%m-%d")
    else:
        exp_dt = "EXPIRED"
    print(f"  {marker}{n:>{nw}}  {name:<30} {plan_next(acc):<20} {exp_dt}")
if lane_ns:
    print(f"  * Active (the shared login, cl) · ▸ reserved sessions (clt)")
PYEOF
}

cmd_check() {
  # check [--order <key>]: every order table goes by that order (engine.ORDERS),
  # else each by the one its group's watch goes by (caduca unless set)
  local order=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --order) [ $# -ge 2 ] || { echo "Usage: claude-swap check [--order <key>]" >&2; exit 1; }
               order="$2"; shift 2 ;;
      --order=*) order="${1#--order=}"; shift ;;
      *) echo "Usage: claude-swap check [--order <key>]" >&2; exit 1 ;;
    esac
  done
  if [ -n "$order" ]; then
    _order_check "$order" || exit 1
  fi
  check_store
  cmd_status
  echo ""
  _deep_check ${order:+"$order"}
}

