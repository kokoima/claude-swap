.left-out{margin-top:8px;font-size:12px;color:var(--ink2)}
.more{margin-top:6px}

/* accounts */
.acc-wrap{padding:4px 0}
table.acc{width:100%;border-collapse:collapse;font-size:13px}
table.acc th{padding:9px 8px 7px;text-align:left;font:700 13px/1 var(--f-display);letter-spacing:.06em;
  text-transform:uppercase;color:var(--ink2);border-bottom:1px solid var(--rule);white-space:nowrap}
