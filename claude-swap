.vx .x-agr{grid-template-columns:50px 44px minmax(0,1fr);gap:2px 8px}
.vx .x-agr .x-tm{grid-column:1;grid-row:1}
.vx .x-agr .x-ty{grid-column:2;grid-row:1}
.vx .x-agr .x-cd{grid-column:1/3;grid-row:2;font-size:11px}
.vx .x-agr .x-wh2{grid-column:3;grid-row:1/3}
