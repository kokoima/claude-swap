# cedar_ember=1 makes the reply carry the free limit resets ("cedar_ember"
# is their codename; plain /usage leaves the block null). skip_spend=1 drops
# the billing blocks, which nothing here reads. The windows are unchanged.
USAGE_QS = "usage?cedar_ember=1&skip_spend=1"

# The plan is re-read daily, which is what catches MAX20X -> MAX5X (both
# keep every window); a drop to FREE shows sooner, as a contradiction.
PLAN_TTL = 86400
plan_changes = []  # (account, old tier, new tier) seen during this check

def is_free(tier):
    t = (tier or "").lower()
    return "free" in t or t in ("", "default_claude_ai")

def plan_end(acc):
    """When the current plan stops: cancellation or scheduled downgrade."""
    dates = [parse_iso(acc.get("plan_ends"))]
    if acc.get("plan_next"):
        dates.append(parse_iso(acc["plan_next"].get("date")))
    dates = [d for d in dates if d and d > datetime.now()]
    return min(dates) if dates else None

def parse_resets(ce):
    """Free limit resets from the cedar_ember block; None if it was absent.

    left counts the unspent resets across live grants and ends is the
    earliest expiry among them. Paused or expired grants do not count.
    """
    if not isinstance(ce, dict):
        return None
    out = {"eligible": ce.get("eligible") is True,
           "reason": ce.get("ineligible_reason"), "left": 0, "ends": None}
    now = datetime.now()
    for g in ce.get("grants") or []:
        if not isinstance(g, dict) or g.get("paused"):
            continue
        left, ends = g.get("resets_left"), parse_iso(g.get("ends_at"))
        if not isinstance(left, int) or left <= 0 or (ends and ends <= now):
            continue
        out["left"] += left
        if ends and (out["ends"] is None or ends < out["ends"]):
            out["ends"] = ends
    return out

def parse_epoch(ts):
    try:
        return datetime.fromtimestamp(int(ts))
    except (ValueError, TypeError):
        return None

def parse_iso(s):
    if not s:
        return None
    try:
        dt = datetime.fromisoformat(str(s).replace("Z", "+00:00"))
        if dt.tzinfo:
            dt = dt.astimezone().replace(tzinfo=None)
        # claude.ai returns ...:59.75, which would print as 21:59 where the
        # ratelimit headers printed 22:00. Round to the minute so both
        # sources render the same clock time.
        dt += timedelta(seconds=30)
        return dt.replace(second=0, microsecond=0)
    except (ValueError, TypeError):
        return None

# ---------- rendering: widths measured ANSI-free so columns align ----------

USE_COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
_ANSI = re.compile(r"\x1b\[[0-9;]*m")
GREY, RED, GREEN, YELLOW, CYAN, MAG, BOLD = "90", "31", "32", "33", "36", "35", "1"
TRACK_BG = "48;5;240"  # grey bar background: also fills the gap inside partial
                       # blocks (▋…), which would otherwise show the black terminal bg

def paint(code, s):
    return f"\x1b[{code}m{s}\x1b[0m" if USE_COLOR else s

def vlen(s):
    return len(_ANSI.sub("", s))

def pad(s, w, right=False):
    gap = w - vlen(s)
    if gap <= 0:
        return s
    return (" " * gap + s) if right else (s + " " * gap)

def center(s, w):
    gap = w - vlen(s)
    if gap <= 0:
        return s
    left = gap // 2
    return " " * left + s + " " * (gap - left)

EIGHTHS = "▏▎▍▌▋▊▉█"
BAR_W = 6

def threshold_color(p):
    return GREEN if p < 50 else (YELLOW if p < 80 else RED)

def pct_cell(pct):
    """6-cell bar (eighth blocks) + right-aligned %."""
    if pct is None:
        return paint(GREY, "·" * BAR_W + "    -")
    p = max(0.0, min(100.0, float(pct)))
    e = round(p / 100 * BAR_W * 8)
    full, rem = divmod(e, 8)
    filled = "█" * full + (EIGHTHS[rem - 1] if rem else "")
    rest = BAR_W - len(filled)
    col = threshold_color(p)
    if USE_COLOR:
        b = (f"\x1b[{col};{TRACK_BG}m{filled}\x1b[0m"
             + f"\x1b[{TRACK_BG}m{' ' * rest}\x1b[0m")
    else:
        b = filled + "░" * rest
    return b + " " + paint(col, pad(f"{p:.0f}%", 4, right=True))

def reset5_cell(dt):
    """5h reset time: HH:MM if today, +HH:MM if tomorrow."""
    if dt is None:
        return paint(GREY, pad("-", 6, right=True))
    prefix = "+" if dt.date() != datetime.now().date() else ""
    return pad(prefix + dt.strftime("%H:%M"), 6, right=True)

results = []
