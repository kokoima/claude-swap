    --rule:#2a3540; --track:#26313b; --accent:#a497ff; --on-accent:#140f38; --accent-soft:#2a2550;
    --ok:#45c97e; --warn:#e7c03a; --bad:#ff6a5c; --cyan:#4fc9d9; --mag:#e37be0;
    --ok-fill:#37b46c; --warn-fill:#d9b028; --bad-fill:#ef5a4d;
    --warn-bg:#2d2810; --bad-bg:#341a18; --ok-bg:#12291c;
    --lift:0 1px 0 rgba(255,255,255,.03) inset,0 1px 2px rgba(0,0,0,.3);
  }
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-padding-top:64px}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.45 var(--f-body);
  font-variant-numeric:tabular-nums;-webkit-font-smoothing:antialiased;overflow-x:hidden}
button,input,select{font:inherit;color:inherit}
a{color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:4px}
[hidden]{display:none!important}
.mono{font-family:var(--f-mono);font-size:.88em}
.mute{color:var(--ink2)}
.faint{color:var(--ink3)}
.t-ok{color:var(--ok)} .t-warn{color:var(--warn)} .t-bad{color:var(--bad)}
.t-cyan{color:var(--cyan)} .t-mag{color:var(--mag)} .t-accent{color:var(--accent)}

/* the strip on top: who, the watch, the data's age, Refresh */
.top{position:sticky;top:0;z-index:5;display:flex;align-items:center;gap:10px;
  padding:10px var(--gutter);padding-top:max(10px,env(safe-area-inset-top));
  background:var(--bg);background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(10px);
  -webkit-backdrop-filter:blur(10px);border-bottom:1px solid var(--rule)}
.brand{margin:0;font:700 21px/1 var(--f-display);letter-spacing:.04em;text-transform:uppercase;white-space:nowrap}
.brand .ver{font:500 11px/1 var(--f-mono);letter-spacing:0;text-transform:none;color:var(--ink3);margin-left:6px}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin-left:auto;justify-content:flex-end;min-width:0}
.chip{display:inline-flex;align-items:center;gap:6px;padding:3px 9px;border-radius:999px;
  border:1px solid var(--rule);background:var(--panel);font-size:12px;white-space:nowrap}
.chip .dot{width:7px;height:7px;border-radius:50%;background:var(--ink3)}
.chip.ok .dot{background:var(--ok-fill)} .chip.bad .dot{background:var(--bad-fill)}
.chip.warn{border-color:var(--warn-fill)} .chip.bad{border-color:var(--bad-fill)}

main{max-width:1320px;margin:0 auto;padding:16px var(--gutter) 40px}
section{margin-top:28px}
h2{display:flex;align-items:baseline;flex-wrap:wrap;gap:4px 12px;margin:0 0 10px;
  font:700 23px/1 var(--f-display);letter-spacing:.04em;text-transform:uppercase}
