.ctl{margin-top:12px;border-top:1px solid var(--rule);padding-top:10px;display:grid;gap:8px}
.ctl-row{display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px}
.ctl-row .clause{font-size:13px;color:var(--ink2)}
.ctl-lbl{font:700 13px/1 var(--f-display);letter-spacing:.06em;text-transform:uppercase;color:var(--ink2);min-width:58px}
.seats{display:flex;flex-wrap:wrap;gap:5px}
