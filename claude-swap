.vx .x-agr .x-ty{font:700 11px var(--f-mono);text-align:center;padding:3px 0;border-radius:5px;border-left:3px solid}
.vx .x-agr .x-ty.x-h5{background:var(--accent-soft);border-color:var(--accent)}
.vx .x-agr .x-ty.x-wk7{background:var(--warn-bg);border-color:var(--warn-fill)}
.vx .x-agr .x-ty.x-fb{background:color-mix(in srgb,var(--mag) 14%,var(--panel));border-color:var(--mag)}
.vx .x-agr .x-ty.x-end{background:var(--bad-bg);border-color:var(--bad)}
.vx .x-agr .x-wh2{display:flex;flex-wrap:wrap;align-items:center;gap:4px 10px;min-width:0}
.vx .x-agr .x-wh2 b{font-weight:600}
