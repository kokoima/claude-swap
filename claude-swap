        num, name_cell, plan_cell(row["plan"], row["plan_end"] is not None),
        pct_cell(row["u5"]), reset5_cell(row["r5"]),
        pct_cell(row["u7"]), pct_cell(row["fable"]),
        resets_cell(row["resets"]), chrome_cell(acc)) + "│" + cal

    if row["error"] and row["error"] != "RATE LIMITED":
        line += "  " + paint(RED, row["error"])
    elif row.get("note"):
