.quota{display:grid;gap:0;padding:4px 16px}
.qrow{display:grid;grid-template-columns:150px repeat(var(--cols,3),minmax(0,1fr)) minmax(180px,1.3fr);gap:14px;
  align-items:center;padding:11px 0;border-top:1px solid var(--rule)}
.qrow:first-child{border-top:0}
.qrow.head{padding:8px 0 0;font:700 13px/1 var(--f-display);letter-spacing:.06em;text-transform:uppercase;color:var(--ink2)}
.qname{font-weight:700}
.qname small{display:block;font-weight:400;font-size:12px;color:var(--ink2)}
.qcell .fig{display:flex;align-items:baseline;gap:5px;margin-bottom:4px}
.qcell .fig b{font:700 22px/1 var(--f-display)}
.qcell .fig span{font-size:12px;color:var(--ink2)}
.qcell .lbl{display:none}
.qnext{font-size:13px;color:var(--ink2)}
.qnext b{color:var(--ink);font-weight:600}
.notes{margin:8px 2px 0;font-size:12px;color:var(--ink2)}
.holders{margin:6px 2px 0;font-size:13px}
.holders div{margin-top:2px}

/* groups */
.groups{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,470px),1fr));gap:14px;align-items:start}
.group{padding:14px 16px 12px}
.ghead{display:flex;gap:14px;align-items:flex-start}
.ghead .gt{flex:1;min-width:0}
.ghead .gt p{margin:6px 0 0;font-size:13px;color:var(--ink2)}
.badge{display:inline-block;margin-left:8px;padding:2px 7px;border-radius:5px;background:var(--inset);
  border:1px solid var(--rule);font:600 11px/1.3 var(--f-body);letter-spacing:0;text-transform:none;
  color:var(--ink2);vertical-align:3px}
code,.code{font-family:var(--f-mono);font-size:.86em;padding:1px 5px;border-radius:5px;background:var(--inset);
  border:1px solid var(--rule)}
.lane-info{margin-top:12px;padding:10px 12px;border-radius:9px;background:var(--inset);font-size:13px}
