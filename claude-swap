h3{margin:0;font:700 19px/1 var(--f-display);letter-spacing:.05em;text-transform:uppercase}
.card{background:var(--panel);border:1px solid var(--rule);border-radius:12px;box-shadow:var(--lift)}
.banner{margin:0 0 12px;padding:10px 14px;border-radius:10px;background:var(--bad-bg);
  border:1px solid var(--bad-fill);font-size:14px}

/* buttons and switches */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:34px;
  padding:5px 12px;border-radius:8px;border:1px solid var(--rule);background:var(--panel);
  font-weight:600;font-size:13px;line-height:1.2;cursor:pointer;white-space:nowrap;box-shadow:var(--lift)}
.btn:hover{border-color:var(--ink3)}
