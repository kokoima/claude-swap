def _finite(o):
    """o as strict JSON takes it: no inf or nan (None), lists for tuples."""
    if isinstance(o, float):
        return o if math.isfinite(o) else None
    if isinstance(o, dict):
        return {str(k): _finite(v) for k, v in o.items()}
    if isinstance(o, (list, tuple)):
        return [_finite(v) for v in o]
    return o


# ---------- the rows: the usage cache, read as check reads its replies ----------

def cached_row(cache, n, acc):
    """Account n's row in the usage cache: by number while the label agrees
    (the store may have been reordered since), else by label; None."""
    rows = [r for r in (cache or {}).get("accounts") or [] if isinstance(r, dict)]
    names = {acc.get("label") or "", acc.get("label") or acc.get("email") or "?"} - {""}
    hit = next((r for r in rows if r.get("n") == n), None)
    if hit is not None and hit.get("label") in names:
        return hit
    return next((r for r in rows if r.get("label") in names), None)


def _renewed(c, now):
    """A cached row with each window whose reset went by renewed: the 5h
    empty with no window running (as claude.ai sends it then), the week and
    each model's week empty until a week later. A cache a while old shows
    no account at a limit that has lifted."""
    c = dict(c)
    if c.get("r5") and c["r5"] <= now and c.get("u5") is not None:
        c["u5"], c["r5"] = 0, None

    def later(t):
        return t + engine.WEEK * (int((now - t) // engine.WEEK) + 1)
    if c.get("r7") and c["r7"] <= now and c.get("u7") is not None:
        c["u7"], c["r7"] = 0, later(c["r7"])
    models = {}
    for name, m in (c.get("models") or {}).items():
        m = dict(m or {})
        if m.get("resets_at") and m["resets_at"] <= now and m.get("pct") is not None:
            m["pct"], m["resets_at"] = 0, later(m["resets_at"])
        models[name] = m
    c["models"] = models
    return c


def engine_rows(store, cache, now):
    """A row per account, in the store's order, as check hands them to the
    engine: the figures from the usage cache (check's or the watch's), the
    plan, its end and the groups from the store."""
    out = []
    for n, acc in enumerate(store.get("accounts", []), 1):
        hit = cached_row(cache, n, acc)
        c = _renewed(hit or {}, now)
        plan = acc.get("plan") if acc.get("plan") is not None else c.get("plan")
        cancel = engine._iso(acc.get("plan_ends"))
        down = engine._iso((acc.get("plan_next") or {}).get("date"))
        future = [t for t in (cancel, down) if t and t > now]
        err = c.get("error")
        limited = err == "RATE LIMITED" or bool(c.get("rate_limited"))
        if err == "RATE LIMITED":
            err = None
        if not acc.get("token"):
            err = "NO TOKEN"
        grants = c.get("grants")
        out.append({
            "n": n, "label": acc.get("label") or acc.get("email") or "?",
            "u5": c.get("u5"), "u7": c.get("u7"), "r5": c.get("r5"), "r7": c.get("r7"),
            "plan": plan, "plan_end": min(future) if future else None,
            "cancel_at": cancel, "down_at": down,
            # a cancelled plan past its end date is free, whatever is cached
            "free": is_free(plan) or bool(cancel and cancel <= now),
            "disabled": bool(acc.get("disabled")),
            "reserved": not oauth.in_general(store, n),
            "error": err, "rate_limited": limited,
            "models": c.get("models") or {}, "shares": c.get("shares") or {},
            "grants": [g for g in grants if isinstance(g, dict)] if isinstance(grants, list) else None,
            "eligible": c.get("eligible"), "reset_cooldown": c.get("reset_cooldown"),
            "resets": c.get("resets"), "resets_ends": c.get("resets_ends"),
            "resets_model": c.get("resets_model"), "src": c.get("src"), "known": hit is not None})
    return out


def model_column(rows, pref):
    """check's model column: the preferred model's own limit when some
    account has one (counted: the watch counts it), else the first one any
    account shows. -> (name or None, counted)"""
    names = [m for r in rows for m in r["models"]]
    col = next((m for m in names if m.lower() == pref.lower()), None)
    if col:
        return col, True
    return (names[0] if names else None), False


def calendar_days(now, days=8):
    """check's calendar: today and the next seven, local midnight to midnight."""
    today = datetime.fromtimestamp(now).date()
    out = []
    for k in range(days):
        d = today + timedelta(days=k)
        out.append({"date": d.isoformat(), "label": f"{DAY_NAMES[d.weekday()]}{d.day}",
                    "start": datetime.combine(d, datetime.min.time()).timestamp(),
                    "end": datetime.combine(d + timedelta(days=1),
                                            datetime.min.time()).timestamp()})
    return out


